{
  "sections": {
    "main": {
      "type": "main-product",
      "settings": {
        "gallery_style": "stacked",
        "show_vendor": true,
        "show_sku": false,
        "show_shipping": true,
        "show_return_policy": true,
        "show_share": false,
        "show_badges": true,
        "show_quantity": true,
        "sticky_add_to_cart": true
      }
    },
    "related": {
      "type": "related-products",
      "settings": {
        "heading": "You may also like",
        "products_per_row": 4,
        "products_to_show": 4,
        "image_ratio": "3/4",
        "show_vendor": false,
        "show_badges": true
      }
    },
    "reviews": {
      "type": "product-reviews",
      "settings": {
        "heading": "Customer reviews",
        "source": "metafield",
        "metafield_rating": "reviews.avg_rating",
        "metafield_count": "reviews.rating_count",
        "enable_rating": true,
        "show_review_form": false
      }
    },
    "metafields": {
      "type": "product-metafields",
      "settings": {
        "show_heading": true,
        "heading": "Product details",
        "layout": "accordion",
        "columns": 3,
        "namespace": "custom",
        "metafield_keys": "material,size_fit,care_instructions,features,shipping_info"
      }
    },
    "recently-viewed": {
      "type": "recently-viewed",
      "settings": {
        "heading": "Recently viewed",
        "products_per_row": 4,
        "products_to_show": 4,
        "image_ratio": "3/4",
        "show_vendor": false,
        "show_badges": true
      }
    }
  },
  "order": [
    "main",
    "metafields",
    "related",
    "reviews",
    "recently-viewed"
  ]
}