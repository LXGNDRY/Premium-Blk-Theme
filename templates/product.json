{
  "sections": {
    "main": {
      "type": "main-product",
      "settings": {
        "layout": "split",
        "gallery_style": "thumbnails",
        "show_vendor": true,
        "show_sku": false,
        "show_share": false,
        "sticky_add_to_cart": true,
        "show_description": true,
        "show_shipping": true,
        "show_returns": true
      }
    },
    "related": {
      "type": "featured-collection",
      "settings": {
        "collection": "frontpage",
        "heading": "You may also like",
        "subheading": "",
        "products_per_row": 4,
        "products_to_show": 4,
        "image_ratio": "3/4",
        "show_secondary_image": true,
        "show_badges": true,
        "show_view_all": false,
        "align": "left"
      }
    },
    "reviews": {
      "type": "product-reviews",
      "settings": {
        "heading": "Customer reviews",
        "source": "metafield",
        "metafield_rating": "reviews.avg_rating",
        "metafield_count": "reviews.rating_count",
        "enable_rating": true,
        "show_review_form": false
      }
    },
    "recently-viewed": {
      "type": "recently-viewed",
      "settings": {
        "heading": "Recently viewed",
        "products_per_row": 4,
        "products_to_show": 4,
        "image_ratio": "3/4",
        "show_vendor": false,
        "show_badges": true
      }
    }
  },
  "order": [
    "main",
    "related",
    "reviews",
    "recently-viewed"
  ]
}