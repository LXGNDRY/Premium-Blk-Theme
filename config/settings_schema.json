      {
        "type": "color",
        "id": "color_border_dark",
        "label": "Borders",
        "default": "#262626"
      },
      {
        "type": "color",
        "id": "color_border_strong_dark",
        "label": "Strong borders",
        "default": "#525252"
      },
      {
        "type": "header",
        "content": "Light mode"
      },
      {
        "type": "color",
        "id": "color_bg_light",
        "label": "Background",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_surface_light",
        "label": "Surface",
        "default": "#fafafa"
      },
      {
        "type": "color",
        "id": "color_text_light",
        "label": "Body text",
        "default": "#000000"
      },
      {
        "type": "color",
        "id": "color_text_muted_light",
        "label": "Muted text",
        "default": "#525252"
      },
      {
        "type": "color",
        "id": "color_border_light",
        "label": "Borders",
        "default": "#e5e5e5"
      },
      {
        "type": "color",
        "id": "color_border_strong_light",
