  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Font families"
      },
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Headings (Display)",
        "default": "helvetica_nueue_bold",
        "info": "Used for H1-H6, buttons, navigation"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body text",
        "default": "system-ui, -apple-system, sans-serif_400",
        "info": "Used for body copy, descriptions"
      },
      {
        "type": "font_picker",
        "id": "font_mono",
        "label": "Monospace (prices, labels)",
        "default": "ui-monospace, SFMono-Regular, monospace_400"
      },
      {
        "type": "header",
        "content": "Sizes"
      },
      {
        "type": "range",
        "id": "font_size_base",
        "label": "Base font size",
        "default": 16,
        "min": 12,
        "max": 22,
        "step": 1,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "font_heading_scale",
        "label": "Heading scale",
        "default": 1.333,
        "min": 1.1,
        "max": 1.8,
        "step": 0.025,
        "info": "1.25 = major third, 1.333 = perfect fourth, 1.5 = augmented fourth"
      },
      {
        "type": "header",
        "content": "Letter spacing"
      },
      {
        "type": "range",
        "id": "font_heading_tracking",
        "label": "Heading tracking",
        "default": -2,
        "min": -5,
        "max": 2,
        "step": 0.5,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "font_ui_tracking",
        "label": "UI uppercase tracking",
        "default": 0.1,
        "min": 0,
        "max": 0.3,
        "step": 0.02,
        "unit": "em"
      }
    ]
  },
