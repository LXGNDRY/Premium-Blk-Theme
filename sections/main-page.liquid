{% schema %}
{
  "name": "Page",
  "tag": "section",
  "class": "s-main-page",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show page title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "narrow_width",
      "label": "Narrow content width",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show breadcrumbs",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Page",
      "category": "Page"
    }
  ]
}
{% endschema %}

{% stylesheet %}
.s-main-page {
  padding: var(--t-space-10) 0 var(--t-space-12);
}

.s-main-page__header {
  margin-bottom: var(--t-space-8);
}

.s-main-page__title {
  font-size: var(--t-font-size-h1);
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: -0.02em;
  margin: 0 0 var(--t-space-4);
}

.s-main-page__content {
  line-height: var(--t-line-height-normal);
}

.s-main-page__content--narrow {
  max-width: 720px;
  margin: 0 auto;
}

.s-main-page__content h1,
.s-main-page__content h2,
.s-main-page__content h3,
.s-main-page__content h4 {
  font-family: var(--t-font-display);
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: -0.01em;
  margin-top: var(--t-space-8);
  margin-bottom: var(--t-space-4);
}

.s-main-page__content h1 { font-size: var(--t-font-size-h2); }
.s-main-page__content h2 { font-size: var(--t-font-size-h3); }
.s-main-page__content h3 { font-size: 1.25rem; }

.s-main-page__content p {
  margin-bottom: var(--t-space-4);
  color: var(--t-text);
}

.s-main-page__content a {
  color: var(--t-text);
  text-decoration: underline;
  text-underline-offset: 3px;
}

.s-main-page__content a:hover {
  color: var(--t-text-muted);
}

.s-main-page__content ul,
.s-main-page__content ol {
  margin-bottom: var(--t-space-4);
  padding-left: var(--t-space-6);
}

.s-main-page__content ul { list-style: disc; }
.s-main-page__content ol { list-style: decimal; }

.s-main-page__content li {
  margin-bottom: var(--t-space-2);
}

.s-main-page__content blockquote {
  border-left: 3px solid var(--t-border-strong);
  padding-left: var(--t-space-5);
  margin: var(--t-space-6) 0;
  font-style: italic;
  color: var(--t-text-muted);
}

.s-main-page__content img {
  max-width: 100%;
  height: auto;
  margin: var(--t-space-6) 0;
}

.s-main-page__content table {
  width: 100%;
  border-collapse: collapse;
  margin: var(--t-space-6) 0;
}

.s-main-page__content th,
.s-main-page__content td {
  padding: var(--t-space-3);
  border-bottom: 1px solid var(--t-border);
  text-align: left;
}

.s-main-page__content th {
  font-weight: 600;
  border-bottom: 2px solid var(--t-border-strong);
}

.s-main-page__content hr {
  border: none;
  border-top: 1px solid var(--t-border);
  margin: var(--t-space-8) 0;
}
{% endstylesheet %}

{%- liquid
  assign _show_title = section.settings.show_title
  assign _narrow = section.settings.narrow_width
  assign _show_breadcrumbs = section.settings.show_breadcrumbs

  assign _content_class = 's-main-page__content'
  if _narrow
    assign _content_class = _content_class | append: ' s-main-page__content--narrow'
  endif
-%}

<section
  id="section-{{ section.id }}"
  class="s-main-page"
  data-section-id="{{ section.id }}"
  data-section-type="main-page"
>
  <div class="c-container">
    {% if _show_breadcrumbs %}
      {% render 'layout-breadcrumbs' with page %}
    {% endif %}

    {% if _show_title %}
      <div class="s-main-page__header">
        <h1 class="s-main-page__title">{{ page.title | escape }}</h1>
      </div>
    {% endif %}

    <div class="{{ _content_class }}">
      {{ page.content }}
    </div>
  </div>
</section>

{% javascript %}
class MainPageSection extends HTMLElement {
  constructor() { super(); }
  connectedCallback() { this.init(); }
  init() { /* No JS needed for basic page */ }
  onBlockSelect() {}
  onBlockDeselect() {}
}

if (!customElements.get('main-page-section')) {
  customElements.define('main-page-section', MainPageSection);
}
{% endjavascript %}
