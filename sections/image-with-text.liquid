{% schema %}
{
  "name": "Image with text",
  "tag": "section",
  "class": "s-image-with-text",
  "enabled_on": {
    "groups": ["*"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker / eyebrow text",
      "default": ""
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Image with text"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Body text",
      "default": "<p>Add your content here.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": ""
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout ratio",
      "default": "half",
      "options": [
        { "value": "half", "label": "50 / 50" },
        { "value": "golden", "label": "60 / 40" },
        { "value": "wide-image", "label": "70 / 30" }
      ]
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Vertical text alignment",
      "default": "middle",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "middle", "label": "Middle" },
        { "value": "bottom", "label": "Bottom" }
      ]
    },
    {
      "type": "checkbox",
      "id": "stack_on_mobile",
      "label": "Stack on mobile",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Image with text",
      "category": "Image"
    }
  ]
}
{% endschema %}

{% stylesheet %}
.s-image-with-text {
  padding: var(--t-space-10) 0;
}

@media (min-width: 768px) {
  .s-image-with-text {
    padding: var(--t-space-12) 0;
  }
}

.s-image-with-text__grid {
  display: grid;
  gap: var(--t-space-8);
  align-items: center;
}

@media (min-width: 768px) {
  .s-image-with-text__grid {
    gap: var(--t-space-10);
  }
}

/* Layout ratios */
.s-image-with-text--half .s-image-with-text__grid { grid-template-columns: 1fr 1fr; }
.s-image-with-text--golden .s-image-with-text__grid { grid-template-columns: 3fr 2fr; }
.s-image-with-text--golden.s-image-with-text--img-right .s-image-with-text__grid { grid-template-columns: 2fr 3fr; }
.s-image-with-text--wide-image .s-image-with-text__grid { grid-template-columns: 7fr 3fr; }
.s-image-with-text--wide-image.s-image-with-text--img-right .s-image-with-text__grid { grid-template-columns: 3fr 7fr; }

@media (max-width: 767px) {
  .s-image-with-text--stack-mobile .s-image-with-text__grid {
    grid-template-columns: 1fr;
    gap: var(--t-space-6);
  }

  .s-image-with-text--stack-mobile.s-image-with-text--img-left .s-image-with-text__image {
    order: -1;
  }
}

/* Image column */
.s-image-with-text__image {
  position: relative;
  overflow: hidden;
  background: var(--t-surface);
}

.s-image-with-text__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  aspect-ratio: 4 / 5;
}

/* Text column */
.s-image-with-text__text {
  display: flex;
  flex-direction: column;
  gap: var(--t-space-4);
  padding: var(--t-space-6) 0;
}

.s-image-with-text--valign-top .s-image-with-text__text { justify-content: flex-start; align-self: start; }
.s-image-with-text--valign-middle .s-image-with-text__text { justify-content: center; align-self: center; }
.s-image-with-text--valign-bottom .s-image-with-text__text { justify-content: flex-end; align-self: end; }

.s-image-with-text__kicker {
  font-size: var(--t-font-size-meta);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.2em;
  color: var(--t-text-muted);
  margin: 0;
}

.s-image-with-text__heading {
  font-size: clamp(1.75rem, 3vw, 2.5rem);
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: -0.02em;
  margin: 0;
}

.s-image-with-text__body {
  font-size: var(--t-font-size-base);
  line-height: var(--t-line-height-relaxed);
  color: var(--t-text-muted);
  margin: 0;
}

.s-image-with-text__body p {
  margin: 0 0 var(--t-space-4);
}

.s-image-with-text__body p:last-child {
  margin-bottom: 0;
}

.s-image-with-text__button {
  margin-top: var(--t-space-2);
}
{% endstylesheet %}

{%- liquid
  assign _image = section.settings.image
  assign _img_pos = section.settings.image_position
  assign _kicker = section.settings.kicker
  assign _heading = section.settings.heading
  assign _text = section.settings.text
  assign _btn_text = section.settings.button_text
  assign _btn_link = section.settings.button_link
  assign _layout = section.settings.layout
  assign _text_align = section.settings.text_align
  assign _stack_mobile = section.settings.stack_on_mobile

  assign _section_class = 's-image-with-text'
  assign _section_class = _section_class | append: ' s-image-with-text--' | append: _layout
  assign _section_class = _section_class | append: ' s-image-with-text--valign-' | append: _text_align
  if _img_pos == 'right'
    assign _section_class = _section_class | append: ' s-image-with-text--img-right'
  else
    assign _section_class = _section_class | append: ' s-image-with-text--img-left'
  endif
  if _stack_mobile
    assign _section_class = _section_class | append: ' s-image-with-text--stack-mobile'
  endif
-%}

<section
  id="section-{{ section.id }}"
  class="{{ _section_class }}"
  data-section-id="{{ section.id }}"
  data-section-type="image-with-text"
>
  <div class="c-container">
    <div class="s-image-with-text__grid">

      {% comment %} IMAGE {% endcomment %}
      <div class="s-image-with-text__image">
        {% if _image %}
          <img
            src="{{ _image | image_url: width: 1000 }}"
            srcset="
              {{ _image | image_url: width: 500 }} 500w,
              {{ _image | image_url: width: 1000 }} 1000w,
              {{ _image | image_url: width: 1500 }} 1500w
            "
            sizes="(max-width: 767px) 100vw, 50vw"
            alt="{{ _image.alt | default: _heading | escape }}"
            width="1000"
            height="1250"
            loading="lazy"
          >
        {% endif %}
      </div>

      {% comment %} TEXT {% endcomment %}
      <div class="s-image-with-text__text">
        {% if _kicker != blank %}
          <p class="s-image-with-text__kicker">{{ _kicker | escape }}</p>
        {% endif %}
        {% if _heading != blank %}
          <h2 class="s-image-with-text__heading">{{ _heading | escape }}</h2>
        {% endif %}
        {% if _text != blank %}
          <div class="s-image-with-text__body">{{ _text }}</div>
        {% endif %}
        {% if _btn_text != blank and _btn_link != blank %}
          <div class="s-image-with-text__button">
            <a href="{{ _btn_link }}" class="c-btn c-btn--primary">
              {{ _btn_text | escape }}
            </a>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% javascript %}
class ImageWithTextSection extends HTMLElement {
  constructor() { super(); }
  connectedCallback() { this.init(); }
  init() {}
  onBlockSelect() {}
  onBlockDeselect() {}
}

if (!customElements.get('image-with-text-section')) {
  customElements.define('image-with-text-section', ImageWithTextSection);
}
{% endjavascript %}
