{% schema %}
{
  "name": "Image banner",
  "tag": "section",
  "class": "section-image-banner",
  "enabled_on": {
    "groups": [
      "*"
    ]
  },
  "max_blocks": 2,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "default": ""
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Image banner"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": ""
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "default": ""
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "height",
      "label": "Section height",
      "default": "adapt",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to first image"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ]
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1",
      "options": [
        {
          "value": "background-1",
          "label": "Background 1"
        },
        {
          "value": "background-2",
          "label": "Background 2"
        },
        {
          "value": "inverse",
          "label": "Inverse"
        },
        {
          "value": "accent-1",
          "label": "Accent 1"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_text_box",
      "label": "Show text box",
      "default": true
    },
    {
      "type": "select",
      "id": "text_box_width",
      "label": "Text box width",
      "default": "medium",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "limit": 2,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "default": ""
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": ""
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": ""
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": ""
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link",
          "default": ""
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image banner",
      "category": "Image"
    }
  ]
}
{% endschema %}

{% stylesheet %}
.section-image-banner {
  padding: var(--spacing-xl) 0;
  position: relative;
}

.section-image-banner .section__header {
  text-align: center;
  margin-bottom: var(--spacing-lg);
}

.section-image-banner .section__heading {
  font-size: calc(var(--font-size-h2) * 1px);
  font-weight: 600;
  margin: 0 0 var(--spacing-md) 0;
  color: var(--color-text);
}

.section-image-banner .section__subheading {
  color: var(--color-text-subdued);
  max-width: 600px;
  margin: 0 auto;
}

.section-image-banner .container {
  max-width: calc(var(--container-max-width) * 1px);
  margin: 0 auto;
  padding: 0 calc(var(--content-padding) * 1px);
}
{% endstylesheet %}

<section
  id="section-{{ section.id }}"
  class="section-image-banner"
  style="
    {% if section.settings.background_color %}
      background-color: {{ section.settings.background_color }};
    {% endif %}
    {% if section.settings.top_padding %}
      padding-top: {{ section.settings.top_padding }}px;
    {% endif %}
    {% if section.settings.bottom_padding %}
      padding-bottom: {{ section.settings.bottom_padding }}px;
    {% endif %}
  "
>
  <div class="container">
    {% if section.settings.heading %}
      <div class="section__header">
        <h2 class="section__heading">{{ section.settings.heading | escape }}</h2>
        {% if section.settings.subheading %}
          <p class="section__subheading">{{ section.settings.subheading | escape }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="blocks blocks--image-banner">
      {% for block in section.blocks %}
        <div
          class="block block--{{ block.type }}"
          style="
            {% if block.settings.alignment %}text-align: {{ block.settings.alignment }};{% endif %}
          "
        >
          {% case block.type %}
{%- when 'banner' -%}
  <div class="block__content">
    {% if block.settings.content %}
      {{ block.settings.content }}
    {% else %}
      Banner
    {% endif %}
  </div>
          {% endcase %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% javascript %}
class ImageBannerSection extends HTMLElement {
  constructor() {
    super();
  }

  connectedCallback() {
    this.init();
  }

  init() {
    // Section initialization logic
  }

  onBlockSelect(evt) {
    // Block selected in editor
  }

  onBlockDeselect(evt) {
    // Block deselected in editor
  }
}

if (!customElements.get('section-image-banner')) {
  customElements.define('section-image-banner', ImageBannerSection);
}
{% endjavascript %}
