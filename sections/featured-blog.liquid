{% schema %}
{
  "name": "Featured blog",
  "tag": "section",
  "class": "section-featured-blog",
  "enabled_on": {
    "groups": [
      "*"
    ]
  },
  "max_blocks": 1,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From the blog"
    },
    {
      "type": "text",
      "id": "blog",
      "label": "Blog",
      "default": "news"
    },
    {
      "type": "select",
      "id": "posts_per_page",
      "label": "Posts to show",
      "default": "3",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "6",
          "label": "6"
        }
      ]
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "default": "3",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": false
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1",
      "options": [
        {
          "value": "background-1",
          "label": "Background 1"
        },
        {
          "value": "background-2",
          "label": "Background 2"
        }
      ]
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "Featured blog",
      "category": "Blog"
    }
  ]
}
{% endschema %}

{% stylesheet %}
.section-featured-blog {
  padding: var(--spacing-xl) 0;
  position: relative;
}

.section-featured-blog .section__header {
  text-align: center;
  margin-bottom: var(--spacing-lg);
}

.section-featured-blog .section__heading {
  font-size: calc(var(--font-size-h2) * 1px);
  font-weight: 600;
  margin: 0 0 var(--spacing-md) 0;
  color: var(--color-text);
}

.section-featured-blog .section__subheading {
  color: var(--color-text-subdued);
  max-width: 600px;
  margin: 0 auto;
}

.section-featured-blog .container {
  max-width: calc(var(--container-max-width) * 1px);
  margin: 0 auto;
  padding: 0 calc(var(--content-padding) * 1px);
}
{% endstylesheet %}

<section
  id="section-{{ section.id }}"
  class="section-featured-blog"
  style="
    {% if section.settings.background_color %}
      background-color: {{ section.settings.background_color }};
    {% endif %}
    {% if section.settings.top_padding %}
      padding-top: {{ section.settings.top_padding }}px;
    {% endif %}
    {% if section.settings.bottom_padding %}
      padding-bottom: {{ section.settings.bottom_padding }}px;
    {% endif %}
  "
>
  <div class="container">
    {% if section.settings.heading %}
      <div class="section__header">
        <h2 class="section__heading">{{ section.settings.heading | escape }}</h2>
        {% if section.settings.subheading %}
          <p class="section__subheading">{{ section.settings.subheading | escape }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="blocks blocks--featured-blog">
      {% for block in section.blocks %}
        <div
          class="block block--{{ block.type }}"
          style="
            {% if block.settings.alignment %}text-align: {{ block.settings.alignment }};{% endif %}
          "
        >
          {% case block.type %}
          {% endcase %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% javascript %}
class FeaturedBlogSection extends HTMLElement {
  constructor() {
    super();
  }

  connectedCallback() {
    this.init();
  }

  init() {
    // Section initialization logic
  }

  onBlockSelect(evt) {
    // Block selected in editor
  }

  onBlockDeselect(evt) {
    // Block deselected in editor
  }
}

if (!customElements.get('section-featured-blog')) {
  customElements.define('section-featured-blog', FeaturedBlogSection);
}
{% endjavascript %}
