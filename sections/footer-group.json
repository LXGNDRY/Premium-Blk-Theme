{
  "type": "footer",
  "name": "Footer group",
  "sections": {
    "cart-drawer": {
      "type": "cart-drawer",
      "settings": {
        "open_on_add": true,
        "show_cross_sell": false
      }
    },
    "predictive-search": {
      "type": "predictive-search",
      "settings": {
        "show_products": true,
        "show_collections": true,
        "show_pages": false,
        "products_limit": 5,
        "show_price": true,
        "show_image": true
      }
    },
    "promo-popup": {
      "type": "promo-popup",
      "settings": {
        "enable_popup": false,
        "trigger": "exit_intent",
        "delay_seconds": 5,
        "scroll_percent": 50,
        "cookie_days": 7,
        "show_on_mobile": true,
        "eyebrow": "LIMITED TIME",
        "heading": "Get 15% off your first order",
        "subheading": "Sign up for early access to drops, restocks, and member-only discounts.",
        "discount_code": "WELCOME15",
        "email_placeholder": "Enter your email",
        "submit_text": "Get my discount"
      }
    },
    "age-verifier": {
      "type": "age-verifier",
      "settings": {
        "enable": false,
        "heading": "Are you 18 or older?",
        "message": "You must be 18 years or older to enter this site.",
        "confirm_text": "I am 18 or older",
        "deny_text": "I am under 18",
        "deny_url": "https://www.google.com",
        "minimum_age": "18",
        "cookie_days": 30,
        "show_reminder": true
      }
    },
    "social-proof": {
      "type": "social-proof",
      "settings": {
        "enable": false,
        "position": "bottom-left",
        "display_duration": 6,
        "cycle_interval": 15,
        "show_image": true,
        "activity_type": "purchased"
      }
    },
    "footer": {
      "type": "footer",
      "settings": {
        "layout": "multi-column",
        "show_separator": true,
        "show_newsletter": true,
        "show_social": true,
        "show_payment": true,
        "newsletter_heading": "Stay in the loop",
        "newsletter_subheading": "Get exclusive drops, restocks, and 10% off your first order.",
        "newsletter_button_text": "Subscribe",
        "copyright_text": "© {{ year }} {{ shop.name }}. All rights reserved.",
        "show_powered_by": false,
        "tagline": "Premium streetwear. Built to last."
      },
      "blocks": [
        {
          "type": "menu",
          "id": "menu-shop",
          "settings": {
            "menu": "main-menu",
            "heading": "Shop"
          }
        },
        {
          "type": "menu",
          "id": "menu-company",
          "settings": {
            "menu": "footer-menu",
            "heading": "Company"
          }
        },
        {
          "type": "menu",
          "id": "menu-help",
          "settings": {
            "menu": "footer-menu",
            "heading": "Help"
          }
        }
      ]
    }
  },
  "order": [
    "cart-drawer",
    "predictive-search",
    "footer"
  ]
}
