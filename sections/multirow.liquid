{% schema %}
{
  "name": "Multirow",
  "tag": "section",
  "class": "section-multirow",
  "enabled_on": {
    "groups": [
      "*"
    ]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": ""
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1",
      "options": [
        {
          "value": "background-1",
          "label": "Background 1"
        },
        {
          "value": "background-2",
          "label": "Background 2"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "default": ""
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Row heading"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": ""
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": ""
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link",
          "default": ""
        },
        {
          "type": "select",
          "id": "layout",
          "label": "Layout",
          "default": "image_first",
          "options": [
            {
              "value": "image_first",
              "label": "Image first"
            },
            {
              "value": "text_first",
              "label": "Text first"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Multirow",
      "category": "Text"
    }
  ]
}
{% endschema %}

{% stylesheet %}
.section-multirow {
  padding: var(--spacing-xl) 0;
  position: relative;
}

.section-multirow .section__header {
  text-align: center;
  margin-bottom: var(--spacing-lg);
}

.section-multirow .section__heading {
  font-size: calc(var(--font-size-h2) * 1px);
  font-weight: 600;
  margin: 0 0 var(--spacing-md) 0;
  color: var(--color-text);
}

.section-multirow .section__subheading {
  color: var(--color-text-subdued);
  max-width: 600px;
  margin: 0 auto;
}

.section-multirow .container {
  max-width: calc(var(--container-max-width) * 1px);
  margin: 0 auto;
  padding: 0 calc(var(--content-padding) * 1px);
}
{% endstylesheet %}

<section
  id="section-{{ section.id }}"
  class="section-multirow"
  style="
    {% if section.settings.background_color %}
      background-color: {{ section.settings.background_color }};
    {% endif %}
    {% if section.settings.top_padding %}
      padding-top: {{ section.settings.top_padding }}px;
    {% endif %}
    {% if section.settings.bottom_padding %}
      padding-bottom: {{ section.settings.bottom_padding }}px;
    {% endif %}
  "
>
  <div class="container">
    {% if section.settings.heading %}
      <div class="section__header">
        <h2 class="section__heading">{{ section.settings.heading | escape }}</h2>
        {% if section.settings.subheading %}
          <p class="section__subheading">{{ section.settings.subheading | escape }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="blocks blocks--multirow">
      {% for block in section.blocks %}
        <div
          class="block block--{{ block.type }}"
          style="
            {% if block.settings.alignment %}text-align: {{ block.settings.alignment }};{% endif %}
          "
        >
          {% case block.type %}
{%- when 'row' -%}
  <div class="block__content">
    {% if block.settings.content %}
      {{ block.settings.content }}
    {% else %}
      Row
    {% endif %}
  </div>
          {% endcase %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% javascript %}
class MultirowSection extends HTMLElement {
  constructor() {
    super();
  }

  connectedCallback() {
    this.init();
  }

  init() {
    // Section initialization logic
  }

  onBlockSelect(evt) {
    // Block selected in editor
  }

  onBlockDeselect(evt) {
    // Block deselected in editor
  }
}

if (!customElements.get('section-multirow')) {
  customElements.define('section-multirow', MultirowSection);
}
{% endjavascript %}
