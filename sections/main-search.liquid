{% schema %}
{
  "name": "Search results",
  "tag": "section",
  "class": "s-main-search",
  "enabled_on": {
    "templates": ["search"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "products_per_row",
      "label": "Products per row",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Results per page",
      "min": 12,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image aspect ratio",
      "default": "3/4",
      "options": [
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "3/4", "label": "Portrait (3:4)" },
        { "value": "4/3", "label": "Landscape (4:3)" },
        { "value": "4/5", "label": "Tall (4:5)" }
      ]
    },
    {
      "type": "header",
      "content": "Product card"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Show badges",
      "default": true
    },
    {
      "type": "header",
      "content": "Search facets"
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "Show sort dropdown",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_type_tabs",
      "label": "Show result type tabs",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_result_count",
      "label": "Show result count",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Search results",
      "category": "Search"
    }
  ]
}
{% endschema %}

{% stylesheet %}
.s-main-search {
  padding: var(--t-space-8) 0 var(--t-space-12);
}

.s-main-search__header {
  margin-bottom: var(--t-space-6);
}

.s-main-search__title {
  font-size: var(--t-font-size-h1);
  font-weight: 700;
  letter-spacing: -0.02em;
  margin: 0 0 var(--t-space-3);
}

.s-main-search__form {
  max-width: 500px;
  margin-bottom: var(--t-space-6);
}

.s-main-search__form input {
  width: 100%;
  height: 48px;
  padding: 0 var(--t-space-4);
  background: var(--t-surface);
  border: 1px solid var(--t-border);
  color: var(--t-text);
  font-size: var(--t-font-size-base);
  font-family: inherit;
  border-radius: 0;
}

.s-main-search__form input:focus {
  outline: none;
  border-color: var(--t-border-strong);
}

.s-main-search__results-count {
  font-size: var(--t-font-size-small);
  color: var(--t-text-muted);
  margin-bottom: var(--t-space-4);
}

.s-main-search__grid {
  display: grid;
  gap: var(--t-grid-gutter);
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

@media (min-width: 768px) {
  .s-main-search__grid--cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .s-main-search__grid--cols-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .s-main-search__grid--cols-5 { grid-template-columns: repeat(5, minmax(0, 1fr)); }
}

.s-main-search__empty {
  text-align: center;
  padding: var(--t-space-12) 0;
  color: var(--t-text-muted);
}

.s-main-search__empty-title {
  font-size: var(--t-font-size-h2);
  font-weight: 700;
  color: var(--t-text);
  margin: 0 0 var(--t-space-3);
}

.s-main-search__pagination {
  margin-top: var(--t-space-8);
  display: flex;
  justify-content: center;
}

/* Search facets */
.s-main-search__facets {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--t-space-6);
  gap: var(--t-space-4);
  flex-wrap: wrap;
}

.s-main-search__tabs {
  display: flex;
  gap: var(--t-space-1);
  border-bottom: 1px solid var(--t-border);
}

.s-main-search__tab {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: var(--t-space-2) var(--t-space-3);
  color: var(--t-text-muted);
  text-decoration: none;
  font-size: var(--t-font-size-small);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  border-bottom: 2px solid transparent;
  margin-bottom: -1px;
  transition: all var(--t-transition-fast);
}

.s-main-search__tab:hover {
  color: var(--t-text);
}

.s-main-search__tab.is-active {
  color: var(--t-text);
  border-bottom-color: var(--t-text);
}

.s-main-search__tab-count {
  font-size: var(--t-font-size-meta);
  background: var(--t-surface);
  padding: 2px 8px;
  border-radius: 10px;
  font-weight: 600;
}

.s-main-search__sort select {
  padding: 8px 12px;
  border: 1px solid var(--t-border);
  background: var(--t-bg);
  color: var(--t-text);
  font-family: inherit;
  font-size: var(--t-font-size-small);
  cursor: pointer;
}

.s-main-search__sort select:focus {
  outline: none;
  border-color: var(--t-text);
}

@media (max-width: 639px) {
  .s-main-search__facets {
    flex-direction: column;
    align-items: stretch;
  }
  .s-main-search__tabs {
    overflow-x: auto;
  }
  .s-main-search__sort select {
    width: 100%;
  }
}
{% endstylesheet %}

{%- liquid
  assign _cols = section.settings.products_per_row
  assign _per_page = section.settings.products_per_page
  assign _ratio = section.settings.image_ratio
  assign _show_vendor = section.settings.show_vendor
  assign _show_badges = section.settings.show_badges
  assign _show_sort = section.settings.show_sort
  assign _show_tabs = section.settings.show_type_tabs
  assign _show_count = section.settings.show_result_count

  assign _grid_class = 's-main-search__grid'
  assign _grid_class = _grid_class | append: ' s-main-search__grid--cols-' | append: _cols

  assign _search_type = 'product'
  if request.query_params.type
    assign _search_type = request.query_params.type
  endif

  # Count results by type
  assign _product_count = 0
  assign _page_count = 0
  assign _article_count = 0
  for result in search.results
    if result.object_type == 'product'
      assign _product_count = _product_count | plus: 1
    elsif result.object_type == 'page'
      assign _page_count = _page_count | plus: 1
    elsif result.object_type == 'article'
      assign _article_count = _article_count | plus: 1
    endif
  endfor
-%}

<section
  id="section-{{ section.id }}"
  class="s-main-search"
  data-section-id="{{ section.id }}"
  data-section-type="main-search"
>
  <div class="c-container">
    <div class="s-main-search__header">
      <h1 class="s-main-search__title">
        {{ 'general.search.title' | t | default: 'Search' }}
      </h1>
      {% if search.terms and _show_count %}
        <p class="s-main-search__results-count">
          {{ search.results_count }} {{ 'general.search.results_for' | t | default: 'results for' }} "{{ search.terms }}"
        </p>
      {% endif %}
    </div>

    <form class="s-main-search__form" role="search" method="get" action="{{ routes.search_url }}">
      <input
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'general.search.placeholder' | t | default: 'Search products...' }}"
        aria-label="{{ 'general.search.placeholder' | t | default: 'Search products...' }}"
        autofocus
      >
    </form>

    {% if search.terms and search.results_count > 0 %}
      {% if _show_tabs or _show_sort %}
        <div class="s-main-search__facets">
          {% if _show_tabs %}
            <div class="s-main-search__tabs" data-search-tabs>
              <a href="{{ routes.search_url }}?q={{ search.terms | url_encode }}&type=product"
                 class="s-main-search__tab{% if _search_type == 'product' or _search_type == blank %} is-active{% endif %}"
                 data-search-tab="product">
                {{ 'general.search.products' | t | default: 'Products' }}
                <span class="s-main-search__tab-count">{{ _product_count }}</span>
              </a>
              <a href="{{ routes.search_url }}?q={{ search.terms | url_encode }}&type=page"
                 class="s-main-search__tab{% if _search_type == 'page' %} is-active{% endif %}"
                 data-search-tab="page">
                {{ 'general.search.pages' | t | default: 'Pages' }}
                <span class="s-main-search__tab-count">{{ _page_count }}</span>
              </a>
            </div>
          {% endif %}

          {% if _show_sort %}
            <div class="s-main-search__sort">
              <select name="sort_by" data-search-sort onchange="window.location.href = this.value">
                <option value="{{ routes.search_url }}?q={{ search.terms | url_encode }}&type={{ _search_type }}&sort_by=relevance" {% if sort_by == blank %}selected{% endif %}>
                  {{ 'general.search.sort_relevance' | t | default: 'Relevance' }}
                </option>
                <option value="{{ routes.search_url }}?q={{ search.terms | url_encode }}&type={{ _search_type }}&sort_by=title-ascending" {% if sort_by == 'title-ascending' %}selected{% endif %}>
                  {{ 'general.search.sort_az' | t | default: 'A-Z' }}
                </option>
                <option value="{{ routes.search_url }}?q={{ search.terms | url_encode }}&type={{ _search_type }}&sort_by=title-descending" {% if sort_by == 'title-descending' %}selected{% endif %}>
                  {{ 'general.search.sort_za' | t | default: 'Z-A' }}
                </option>
                <option value="{{ routes.search_url }}?q={{ search.terms | url_encode }}&type={{ _search_type }}&sort_by=price-ascending" {% if sort_by == 'price-ascending' %}selected{% endif %}>
                  {{ 'general.search.sort_price_low' | t | default: 'Price: Low to high' }}
                </option>
                <option value="{{ routes.search_url }}?q={{ search.terms | url_encode }}&type={{ _search_type }}&sort_by=price-descending" {% if sort_by == 'price-descending' %}selected{% endif %}>
                  {{ 'general.search.sort_price_high' | t | default: 'Price: High to low' }}
                </option>
                <option value="{{ routes.search_url }}?q={{ search.terms | url_encode }}&type={{ _search_type }}&sort_by=created-descending" {% if sort_by == 'created-descending' %}selected{% endif %}>
                  {{ 'general.search.sort_newest' | t | default: 'Newest' }}
                </option>
              </select>
            </div>
          {% endif %}
        </div>
      {% endif %}

    {% if search.terms and search.results_count > 0 %}
      {% paginate search.results by _per_page %}
        <div class="{{ _grid_class }}">
          {% for item in search.results %}
            {% if item.object_type == 'product' %}
              {% assign _product = item %}
              {% render 'component-product-card',
                product: _product,
                media_aspect: _ratio,
                show_vendor: _show_vendor,
                show_secondary_image: true,
                show_badges: _show_badges,
                image_size: 500
              %}
            {% endif %}
          {% endfor %}
        </div>

        {% if paginate.pages > 1 %}
          <div class="s-main-search__pagination">
            <nav class="c-pagination" aria-label="Search pagination">
              {% if paginate.previous %}
                <a href="{{ paginate.previous.url }}" class="c-pagination__item">
                  &larr; {{ 'general.pagination.previous' | t | default: 'Previous' }}
                </a>
              {% endif %}
              <span class="c-pagination__item is-active">{{ paginate.current_page }} / {{ paginate.pages }}</span>
              {% if paginate.next %}
                <a href="{{ paginate.next.url }}" class="c-pagination__item">
                  {{ 'general.pagination.next' | t | default: 'Next' }} &rarr;
                </a>
              {% endif %}
            </nav>
          </div>
        {% endif %}
      {% endpaginate %}
    {% elsif search.terms %}
      <div class="s-main-search__empty">
        <h2 class="s-main-search__empty-title">
          {{ 'general.search.no_results' | t | default: 'No results found' }}
        </h2>
        <p>{{ 'general.search.no_results_text' | t | default: 'Try a different search term.' }}</p>
      </div>
    {% endif %}
  </div>
</section>

{% javascript %}
class MainSearchSection extends HTMLElement {
  constructor() { super(); }
  connectedCallback() { this.init(); }
  init() {}
  onBlockSelect() {}
  onBlockDeselect() {}
}

if (!customElements.get('main-search-section')) {
  customElements.define('main-search-section', MainSearchSection);
}
{% endjavascript %}
