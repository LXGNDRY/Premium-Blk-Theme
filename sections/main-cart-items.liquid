{% schema %}
{
  "name": "Cart items",
  "tag": "section",
  "class": "section-main-cart-items",
  "enabled_on": {
    "groups": [
      "*"
    ]
  },
  "max_blocks": 16,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_cart_note",
      "label": "Show order note",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_taxes",
      "label": "Show taxes and duties at checkout",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_shipping",
      "label": "Show shipping at checkout",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "subtotal",
      "name": "Subtotal",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_discount",
          "label": "Show discount",
          "default": true
        }
      ]
    },
    {
      "type": "proceed_to_checkout",
      "name": "Proceed to checkout",
      "limit": 1,
      "settings": []
    },
    {
      "type": "dynamic_checkout",
      "name": "Dynamic checkout",
      "limit": 1,
      "settings": []
    },
    {
      "type": "cart_attributes",
      "name": "Cart attributes",
      "limit": 6,
      "settings": []
    },
    {
      "type": "app",
      "name": "App",
      "limit": 16,
      "settings": []
    }
  ],
  "presets": [
    {
      "name": "Cart items",
      "category": "Cart"
    }
  ]
}
{% endschema %}

{% stylesheet %}
.section-main-cart-items {
  padding: var(--spacing-xl) 0;
  position: relative;
}

.section-main-cart-items .section__header {
  text-align: center;
  margin-bottom: var(--spacing-lg);
}

.section-main-cart-items .section__heading {
  font-size: calc(var(--font-size-h2) * 1px);
  font-weight: 600;
  margin: 0 0 var(--spacing-md) 0;
  color: var(--color-text);
}

.section-main-cart-items .section__subheading {
  color: var(--color-text-subdued);
  max-width: 600px;
  margin: 0 auto;
}

.section-main-cart-items .container {
  max-width: calc(var(--container-max-width) * 1px);
  margin: 0 auto;
  padding: 0 calc(var(--content-padding) * 1px);
}
{% endstylesheet %}

<section
  id="section-{{ section.id }}"
  class="section-main-cart-items"
  style="
    {% if section.settings.background_color %}
      background-color: {{ section.settings.background_color }};
    {% endif %}
    {% if section.settings.top_padding %}
      padding-top: {{ section.settings.top_padding }}px;
    {% endif %}
    {% if section.settings.bottom_padding %}
      padding-bottom: {{ section.settings.bottom_padding }}px;
    {% endif %}
  "
>
  <div class="container">
    {% if section.settings.heading %}
      <div class="section__header">
        <h2 class="section__heading">{{ section.settings.heading | escape }}</h2>
        {% if section.settings.subheading %}
          <p class="section__subheading">{{ section.settings.subheading | escape }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="blocks blocks--main-cart-items">
      {% for block in section.blocks %}
        <div
          class="block block--{{ block.type }}"
          style="
            {% if block.settings.alignment %}text-align: {{ block.settings.alignment }};{% endif %}
          "
        >
          {% case block.type %}
{%- when 'subtotal' -%}
  <div class="block__content">
    {% if block.settings.content %}
      {{ block.settings.content }}
    {% else %}
      Subtotal
    {% endif %}
  </div>
{%- when 'proceed_to_checkout' -%}
  <div class="block__content">
    {% if block.settings.content %}
      {{ block.settings.content }}
    {% else %}
      Proceed to checkout
    {% endif %}
  </div>
{%- when 'dynamic_checkout' -%}
  <div class="block__content">
    {% if block.settings.content %}
      {{ block.settings.content }}
    {% else %}
      Dynamic checkout
    {% endif %}
  </div>
{%- when 'cart_attributes' -%}
  <div class="block__content">
    {% if block.settings.content %}
      {{ block.settings.content }}
    {% else %}
      Cart attributes
    {% endif %}
  </div>
{%- when 'app' -%}
  <div class="block__content">
    {% if block.settings.content %}
      {{ block.settings.content }}
    {% else %}
      App
    {% endif %}
  </div>
          {% endcase %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% javascript %}
class MainCartItemsSection extends HTMLElement {
  constructor() {
    super();
  }

  connectedCallback() {
    this.init();
  }

  init() {
    // Section initialization logic
  }

  onBlockSelect(evt) {
    // Block selected in editor
  }

  onBlockDeselect(evt) {
    // Block deselected in editor
  }
}

if (!customElements.get('section-main-cart-items')) {
  customElements.define('section-main-cart-items', MainCartItemsSection);
}
{% endjavascript %}
