{% schema %}
{
  "name": "Related products",
  "tag": "section",
  "class": "s-related-products",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "products_per_row",
      "label": "Products per row",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Number of products",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image aspect ratio",
      "default": "3/4",
      "options": [
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "3/4", "label": "Portrait (3:4)" },
        { "value": "4/3", "label": "Landscape (4:3)" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show secondary image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Show badges",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Related products",
      "category": "Product"
    }
  ]
}
{% endschema %}

{% stylesheet %}
.s-related-products {
  padding: var(--t-space-10) 0;
  border-top: 1px solid var(--t-border);
}

.s-related-products__heading {
  font-size: var(--t-font-size-h2);
  font-weight: 700;
  letter-spacing: -0.02em;
  margin: 0 0 var(--t-space-6);
  text-align: center;
}

.s-related-products__grid {
  display: grid;
  gap: var(--t-grid-gutter);
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

@media (min-width: 768px) {
  .s-related-products__grid--cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .s-related-products__grid--cols-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .s-related-products__grid--cols-5 { grid-template-columns: repeat(5, minmax(0, 1fr)); }
}
{% endstylesheet %}

{%- liquid
  assign _heading = section.settings.heading
  assign _cols = section.settings.products_per_row
  assign _limit = section.settings.products_to_show
  assign _ratio = section.settings.image_ratio
  assign _show_vendor = section.settings.show_vendor
  assign _show_secondary = section.settings.show_secondary_image
  assign _show_badges = section.settings.show_badges

  assign _grid_class = 's-related-products__grid'
  assign _grid_class = _grid_class | append: ' s-related-products__grid--cols-' | append: _cols
-%}

<section
  id="section-{{ section.id }}"
  class="s-related-products"
  data-section-id="{{ section.id }}"
  data-section-type="related-products"
>
  <div class="c-container">
    {% if _heading != blank %}
      <h2 class="s-related-products__heading">{{ _heading | escape }}</h2>
    {% endif %}

    {% comment %}
      Related products: use collection from the product, otherwise fall back to frontpage.
      On product pages, product object is available.
    {% endcomment %}
    {% assign _related = false %}
    {% if product and product.collections.size > 0 %}
      {% for col in product.collections limit: 1 %}
        {% assign _collection = col %}
        {% assign _related = true %}
      {% endfor %}
    {% endif %}

    {% if _related == false %}
      {% assign _collection = collections.frontpage %}
    {% endif %}

    {% if _collection.products.size > 0 %}
      <div class="{{ _grid_class }}">
        {% for product in _collection.products limit: _limit %}
          {% if product.id != product.id or _related == false %}
            {% render 'component-product-card',
              product: product,
              media_aspect: _ratio,
              show_vendor: _show_vendor,
              show_secondary_image: _show_secondary,
              show_badges: _show_badges,
              image_size: 500
            %}
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% javascript %}
class RelatedProductsSection extends HTMLElement {
  constructor() { super(); }
  connectedCallback() { this.init(); }
  init() {}
  onBlockSelect() {}
  onBlockDeselect() {}
}

if (!customElements.get('related-products-section')) {
  customElements.define('related-products-section', RelatedProductsSection);
}
{% endjavascript %}
