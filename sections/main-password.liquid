{% schema %}
{
  "name": "Password page",
  "tag": "section",
  "class": "s-main-password",
  "enabled_on": {
    "templates": ["password"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We'll be back soon."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Our store is under construction. Check back soon for the drop."
    },
    {
      "type": "checkbox",
      "id": "show_email_signup",
      "label": "Show email signup",
      "default": true
    },
    {
      "type": "text",
      "id": "signup_heading",
      "label": "Signup heading",
      "default": "Get notified when we launch"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "header",
      "content": "Password form"
    },
    {
      "type": "text",
      "id": "password_heading",
      "label": "Password heading",
      "default": "Enter store using password"
    }
  ],
  "presets": [
    {
      "name": "Password page",
      "category": "Page"
    }
  ]
}
{% endschema %}

{% stylesheet %}
.s-main-password {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--t-space-8);
  position: relative;
  background: var(--t-bg);
}

.s-main-password__bg {
  position: absolute;
  inset: 0;
  z-index: 0;
  background-size: cover;
  background-position: center;
  opacity: 0.4;
}

.s-main-password__overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(
    to bottom,
    rgba(0, 0, 0, 0.5),
    rgba(0, 0, 0, 0.8)
  );
}

.s-main-password__content {
  position: relative;
  z-index: 2;
  max-width: 560px;
  text-align: center;
  color: #fff;
  display: flex;
  flex-direction: column;
  gap: var(--t-space-5);
  align-items: center;
}

.s-main-password__logo {
  font-family: var(--t-font-display);
  font-size: 1.5rem;
  font-weight: 800;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  margin: 0 0 var(--t-space-2);
}

.s-main-password__heading {
  font-size: clamp(2rem, 6vw, 3.5rem);
  font-weight: 800;
  line-height: 1.05;
  letter-spacing: -0.03em;
  margin: 0;
  text-transform: uppercase;
}

.s-main-password__text {
  font-size: var(--t-font-size-base);
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.8);
  margin: 0;
}

.s-main-password__form {
  display: flex;
  gap: var(--t-space-2);
  width: 100%;
  max-width: 400px;
}

.s-main-password__form input {
  flex: 1;
  min-width: 0;
  height: 48px;
  padding: 0 var(--t-space-4);
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.2);
  color: #fff;
  font-size: var(--t-font-size-base);
  font-family: inherit;
  border-radius: 0;
}

.s-main-password__form input:focus {
  outline: none;
  border-color: rgba(255, 255, 255, 0.5);
}

.s-main-password__form input::placeholder {
  color: rgba(255, 255, 255, 0.5);
}

.s-main-password__signup-heading {
  font-size: 1.125rem;
  font-weight: 700;
  margin: var(--t-space-3) 0 0;
}

.s-main-password__divider {
  width: 100%;
  display: flex;
  align-items: center;
  gap: var(--t-space-4);
  color: rgba(255, 255, 255, 0.5);
  font-size: var(--t-font-size-meta);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin: var(--t-space-2) 0;
}

.s-main-password__divider::before,
.s-main-password__divider::after {
  content: '';
  flex: 1;
  height: 1px;
  background: rgba(255, 255, 255, 0.2);
}

.s-main-password__social {
  display: flex;
  gap: var(--t-space-4);
  margin-top: var(--t-space-2);
}

.s-main-password__social a {
  color: rgba(255, 255, 255, 0.7);
  font-size: var(--t-font-size-small);
  text-decoration: none;
  transition: color var(--t-transition-fast);
}

.s-main-password__social a:hover {
  color: #fff;
}

.s-main-password__login {
  position: absolute;
  top: var(--t-space-4);
  right: var(--t-space-4);
  z-index: 3;
}

.s-main-password__login button {
  background: none;
  border: 1px solid rgba(255, 255, 255, 0.3);
  color: #fff;
  padding: var(--t-space-2) var(--t-space-3);
  font-size: var(--t-font-size-small);
  font-family: inherit;
  cursor: pointer;
  border-radius: 0;
}
{% endstylesheet %}

<section
  id="section-{{ section.id }}"
  class="s-main-password"
  data-section-id="{{ section.id }}"
  data-section-type="main-password"
>
  {% if section.settings.background_image %}
    <div
      class="s-main-password__bg"
      style="background-image: url('{{ section.settings.background_image | image_url: width: 2000 }}');"
    ></div>
    <div class="s-main-password__overlay"></div>
  {% endif %}

  {% if shop.password_message %}
    <div class="s-main-password__login">
      <button type="button" onclick="document.getElementById('LoginModal').style.display='block'">
        {{ 'general.enter_using_password' | t | default: 'Enter using password' }}
      </button>
    </div>
  {% endif %}

  <div class="s-main-password__content">
    <p class="s-main-password__logo">{{ shop.name | escape }}</p>
    <h1 class="s-main-password__heading">{{ section.settings.heading | escape }}</h1>
    <p class="s-main-password__text">{{ section.settings.text | escape }}</p>

    {% if section.settings.show_email_signup %}
      {% if section.settings.signup_heading != blank %}
        <p class="s-main-password__signup-heading">{{ section.settings.signup_heading | escape }}</p>
      {% endif %}
      <form class="s-main-password__form" action="{{ routes.newsletter_url }}" method="post" accept-charset="UTF-8">
        <input type="hidden" name="form_type" value="customer">
        <input type="hidden" name="utf8" value="✓">
        <input
          type="email"
          name="contact[email]"
          placeholder="Your email address"
          aria-label="Email address"
          required
          autocomplete="email"
        >
        <button type="submit" class="c-btn c-btn--primary">
          {{ 'general.notify_me' | t | default: 'Notify me' }}
        </button>
      </form>
    {% endif %}

    <div class="s-main-password__divider">{{ 'general.or' | t | default: 'Or' }}</div>

    {% if section.settings.background_image == blank %}
      <div class="s-main-password__social" style="justify-content: center;">
        <span style="color: var(--t-text-muted);">Follow us:</span>
        {% if settings.social_instagram_link %}
          <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener noreferrer">Instagram</a>
        {% endif %}
        {% if settings.social_tiktok_link %}
          <a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener noreferrer">TikTok</a>
        {% endif %}
      </div>
    {% else %}
      <div class="s-main-password__social">
        {% if settings.social_instagram_link %}
          <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener noreferrer">Instagram</a>
        {% endif %}
        {% if settings.social_tiktok_link %}
          <a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener noreferrer">TikTok</a>
        {% endif %}
        {% if settings.social_twitter_link %}
          <a href="{{ settings.social_twitter_link }}" target="_blank" rel="noopener noreferrer">Twitter</a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% javascript %}
class MainPasswordSection extends HTMLElement {
  constructor() { super(); }
  connectedCallback() { this.init(); }
  init() {}
  onBlockSelect() {}
  onBlockDeselect() {}
}

if (!customElements.get('main-password-section')) {
  customElements.define('main-password-section', MainPasswordSection);
}
{% endjavascript %}
