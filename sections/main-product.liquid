{% schema %}
{
  "name": "Main product",
  "tag": "section",
  "class": "s-main-product",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout style",
      "default": "split",
      "options": [
        { "value": "split", "label": "Split (image left, info right)" },
        { "value": "stacked", "label": "Stacked (editorial)" }
      ]
    },
    {
      "type": "select",
      "id": "gallery_style",
      "label": "Gallery style",
      "default": "thumbnails",
      "options": [
        { "value": "thumbnails", "label": "Thumbnails" },
        { "value": "dots", "label": "Dots" },
        { "value": "scroll", "label": "Scroll" }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_zoom",
      "label": "Enable image zoom & lightbox",
      "default": true,
      "info": "Hover zoom on desktop, click to open fullscreen lightbox with thumbnails."
    },
    {
      "type": "header",
      "content": "Product video"
    },
    {
      "type": "checkbox",
      "id": "show_video",
      "label": "Show product video",
      "default": false,
      "info": "Embed a video in the product gallery."
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL",
      "default": "",
      "info": "YouTube, Vimeo, or direct MP4 URL. Supports metafield dynamic source."
    },
    {
      "type": "select",
      "id": "video_source",
      "label": "Video source",
      "default": "url",
      "options": [
        { "value": "url", "label": "URL setting" },
        { "value": "metafield", "label": "Metafield" }
      ]
    },
    {
      "type": "text",
      "id": "video_metafield",
      "label": "Video metafield",
      "default": "product.video_url",
      "info": "Namespace.key format for metafield-based video URL."
    },
    {
      "type": "header",
      "content": "Product info"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_sku",
      "label": "Show SKU",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_share",
      "label": "Show share buttons",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "sticky_add_to_cart",
      "label": "Sticky add to cart (mobile)",
      "default": true
    },
    {
      "type": "header",
      "content": "Accordions"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show description accordion",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_shipping",
      "label": "Show shipping accordion",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_returns",
      "label": "Show returns accordion",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_size_chart",
      "label": "Show size chart accordion",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "size_chart_modal",
      "label": "Open size chart in modal",
      "default": false,
      "info": "If enabled, shows a link that opens the size chart in a modal popup."
    },
    {
      "type": "checkbox",
      "id": "show_stock_indicator",
      "label": "Show stock indicator",
      "default": true,
      "info": "Shows inventory count and low-stock warnings on the product page."
    },
    {
      "type": "number",
      "id": "low_stock_threshold",
      "label": "Low stock threshold",
      "default": 5,
      "min": 1,
      "max": 50,
      "info": "Show 'Only X left' when inventory falls below this number."
    },
    {
      "type": "checkbox",
      "id": "show_share",
      "label": "Show share buttons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "back_in_stock",
      "label": "Show back-in-stock form",
      "default": true,
      "info": "Show an email signup form when a product/variant is sold out"
    },
    {
      "type": "text",
      "id": "back_in_stock_form_action",
      "label": "Back-in-stock form endpoint",
      "default": "",
      "info": "Klaviyo / Mailchimp / custom endpoint URL. Leave blank for demo."
    }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Accordion"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Add your accordion content here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product page",
      "category": "Product"
    }
  ]
}
{% endschema %}

{% stylesheet %}
.s-main-product {
  padding: var(--t-space-8) 0 var(--t-space-12);
}

.s-main-product__grid {
  display: grid;
  gap: var(--t-space-8);
}

@media (min-width: 768px) {
  .s-main-product__grid {
    grid-template-columns: 1fr 1fr;
    gap: var(--t-space-10);
  }
}

@media (min-width: 1024px) {
  .s-main-product__grid {
    gap: var(--t-space-12);
  }
}

/* Stacked layout */
.s-main-product--stacked .s-main-product__grid {
  grid-template-columns: 1fr;
}

@media (min-width: 1024px) {
  .s-main-product--stacked .s-main-product__grid {
    max-width: 1000px;
    margin: 0 auto;
  }
}

/* Gallery */
.s-main-product__gallery {
  position: sticky;
  top: calc(var(--t-space-6) + 72px);
  align-self: start;
}

.s-main-product__main-image {
  position: relative;
  aspect-ratio: 3 / 4;
  overflow: hidden;
  background: var(--t-surface);
  margin-bottom: var(--t-space-4);
}

.s-main-product__main-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.4s var(--t-ease-out);
}

/* Image zoom container fills main image */
.s-main-product__main-image .c-zoom {
  width: 100%;
  height: 100%;
}

.s-main-product__main-image .c-zoom__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Video thumb */
.s-main-product__thumb--video {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--t-surface);
  color: var(--t-text);
  border: 2px solid var(--t-border);
  padding: 0;
}

.s-main-product__thumb--video svg {
  width: 24px;
  height: 24px;
  margin-left: 2px;
}

.s-main-product__thumb--video.is-active {
  border-color: var(--t-text);
}

/* Video player overlay */
.s-main-product__video-player {
  position: absolute;
  inset: 0;
  background: #000;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
}

.s-main-product__video-container {
  width: 100%;
  height: 100%;
  position: relative;
}

.s-main-product__video-container iframe,
.s-main-product__video-container video {
  width: 100%;
  height: 100%;
  border: none;
}

.s-main-product__video-close {
  position: absolute;
  top: 12px;
  right: 12px;
  width: 36px;
  height: 36px;
  background: rgba(255,255,255,0.1);
  border: none;
  color: #fff;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.s-main-product__video-close:hover {
  background: rgba(255,255,255,0.2);
}

/* Back in stock form */
.s-main-product__back-in-stock {
  display: flex;
  flex-direction: column;
  gap: var(--t-space-2);
}

.s-main-product__bis-text {
  font-size: var(--t-font-size-small);
  color: var(--t-text-muted);
  margin: 0;
}

.s-main-product__bis-form {
  display: flex;
  flex-direction: column;
  gap: var(--t-space-2);
  margin-top: var(--t-space-1);
}

.s-main-product__bis-input {
  width: 100%;
  padding: 12px 14px;
  border: 1px solid var(--t-border);
  background: var(--t-bg);
  color: var(--t-text);
  font-family: inherit;
  font-size: var(--t-font-size-body);
  box-sizing: border-box;
}

.s-main-product__bis-input:focus {
  outline: none;
  border-color: var(--t-text);
}

.s-main-product__bis-success {
  margin: 0;
  padding: var(--t-space-3);
  background: var(--t-surface);
  border: 1px solid var(--t-border);
  font-size: var(--t-font-size-small);
  color: var(--t-text);
  text-align: center;
  font-weight: 600;
}

/* Image Zoom (from component-image-zoom) */
.c-zoom {
  position: relative;
  width: 100%;
  height: 100%;
  cursor: zoom-in;
  overflow: hidden;
}

.c-zoom__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.c-zoom__lens {
  position: absolute;
  width: 150px;
  height: 150px;
  border: 2px solid var(--t-border);
  background: rgba(255,255,255,0.1);
  pointer-events: none;
  display: none;
  z-index: 5;
}

.c-zoom.is-active .c-zoom__lens {
  display: block;
}

.c-zoom__result {
  position: absolute;
  top: 0;
  left: calc(100% + 10px);
  width: 100%;
  height: 100%;
  border: 1px solid var(--t-border);
  background-repeat: no-repeat;
  background-size: 250%;
  background-position: 0 0;
  display: none;
  z-index: 10;
  pointer-events: none;
  background-color: var(--t-bg);
}

.c-zoom.is-active .c-zoom__result {
  display: block;
}

.c-zoom__hint {
  position: absolute;
  bottom: 12px;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(0,0,0,0.6);
  color: #fff;
  font-size: var(--t-font-size-meta);
  padding: 4px 12px;
  pointer-events: none;
  opacity: 0;
  transition: opacity var(--t-transition-fast);
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.c-zoom:hover .c-zoom__hint {
  opacity: 1;
}

/* Lightbox */
.c-lightbox {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.95);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.c-lightbox[hidden] {
  display: none;
}

.c-lightbox__container {
  position: relative;
  width: 90vw;
  max-width: 900px;
  max-height: 90vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--t-space-4);
}

.c-lightbox__image {
  max-width: 100%;
  max-height: 70vh;
  object-fit: contain;
}

.c-lightbox__close {
  position: absolute;
  top: -48px;
  right: 0;
  width: 36px;
  height: 36px;
  background: transparent;
  border: none;
  color: #fff;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}

.c-lightbox__nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 44px;
  height: 44px;
  background: rgba(255,255,255,0.1);
  border: none;
  color: #fff;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background var(--t-transition-fast);
}

.c-lightbox__nav:hover {
  background: rgba(255,255,255,0.2);
}

.c-lightbox__nav--prev { left: -60px; }
.c-lightbox__nav--next { right: -60px; }

.c-lightbox__thumbs {
  display: flex;
  gap: 8px;
  max-width: 100%;
  overflow-x: auto;
  padding: 4px 0;
}

.c-lightbox__thumb {
  width: 60px;
  height: 80px;
  flex-shrink: 0;
  padding: 0;
  border: 2px solid transparent;
  background: transparent;
  cursor: pointer;
  overflow: hidden;
}

.c-lightbox__thumb.is-active {
  border-color: #fff;
}

.c-lightbox__thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.c-lightbox__counter {
  color: rgba(255,255,255,0.7);
  font-size: var(--t-font-size-meta);
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

@media (max-width: 1023px) {
  .c-zoom__lens,
  .c-zoom__result {
    display: none !important;
  }

  .c-zoom {
    cursor: zoom-in;
  }

  .c-lightbox__nav--prev { left: 8px; }
  .c-lightbox__nav--next { right: 8px; }
  .c-lightbox__close { top: -40px; }
}

.s-main-product__thumbs {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--t-space-2);
}

.s-main-product__thumb {
  aspect-ratio: 1 / 1;
  overflow: hidden;
  background: var(--t-surface);
  cursor: pointer;
  border: 2px solid transparent;
  transition: border-color var(--t-transition-fast);
  padding: 0;
}

.s-main-product__thumb:hover,
.s-main-product__thumb.is-active {
  border-color: var(--t-border-strong);
}

.s-main-product__thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Info column */
.s-main-product__info {
  display: flex;
  flex-direction: column;
  gap: var(--t-space-5);
}

.s-main-product__vendor {
  font-size: var(--t-font-size-meta);
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--t-text-muted);
  margin: 0;
  font-weight: 600;
}

.s-main-product__title {
  font-size: var(--t-font-size-h1);
  font-weight: 700;
  line-height: 1.05;
  letter-spacing: -0.03em;
  margin: 0;
}

.s-main-product__price-wrap {
  display: flex;
  align-items: baseline;
  gap: var(--t-space-3);
  flex-wrap: wrap;
}

.s-main-product__sku {
  font-family: var(--t-font-mono);
  font-size: var(--t-font-size-meta);
  color: var(--t-text-subtle);
}

/* Variant pickers */
.s-main-product__variant-group {
  display: flex;
  flex-direction: column;
  gap: var(--t-space-3);
}

.s-main-product__variant-label {
  font-size: var(--t-font-size-small);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--t-text);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.s-main-product__variant-value {
  font-weight: 400;
  color: var(--t-text-muted);
  text-transform: none;
  letter-spacing: 0;
}

/* Quantity + add to cart */
.s-main-product__actions {
  display: flex;
  flex-direction: column;
  gap: var(--t-space-3);
}

.s-main-product__stock {
  margin: var(--t-space-3) 0;
}

.s-main-product__share {
  margin-top: var(--t-space-5);
  padding-top: var(--t-space-5);
  border-top: 1px solid var(--t-border);
}

.s-main-product__qty-atc {
  display: flex;
  gap: var(--t-space-3);
  align-items: stretch;
}

.s-main-product__qty-atc quantity-input {
  flex-shrink: 0;
}

.s-main-product__qty-atc .c-btn {
  flex: 1;
}

/* Accordions */
.s-main-product__accordions {
  margin-top: var(--t-space-4);
  border-top: 1px solid var(--t-border);
}

/* Sticky mobile add to cart */
.s-main-product__sticky-atc {
  display: none;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: var(--t-z-sticky);
  background: var(--t-bg);
  border-top: 1px solid var(--t-border);
  padding: var(--t-space-3) var(--t-space-4);
  gap: var(--t-space-3);
  align-items: center;
}

@media (max-width: 767px) {
  .s-main-product__sticky-atc--enabled {
    display: flex;
  }
}

.s-main-product__sticky-info {
  flex: 1;
  min-width: 0;
}

.s-main-product__sticky-title {
  font-size: var(--t-font-size-small);
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin: 0;
}

.s-main-product__sticky-price {
  font-family: var(--t-font-mono);
  font-weight: 600;
  font-size: var(--t-font-size-small);
}

@media (max-width: 767px) {
  .s-main-product__main-image {
    margin-bottom: var(--t-space-2);
  }

  .s-main-product__title {
    font-size: clamp(1.75rem, 6vw, 2.5rem);
  }
}
{% endstylesheet %}

{%- liquid
  assign _layout = section.settings.layout
  assign _gallery_style = section.settings.gallery_style
  assign _show_vendor = section.settings.show_vendor
  assign _show_sku = section.settings.show_sku
  assign _sticky_atc = section.settings.sticky_add_to_cart

  assign _section_class = 's-main-product s-main-product--' | append: _layout
  if _sticky_atc
    assign _section_class = _section_class | append: ' s-main-product--sticky'
  endif

  assign _product = product
  if _product == nil
    assign _product = all_products.frontpage
  endif
-%}

<section
  id="section-{{ section.id }}"
  class="{{ _section_class }}"
  data-section-id="{{ section.id }}"
  data-section-type="main-product"
>
  <div class="c-container">
    <div class="s-main-product__grid">

      {% comment %} === GALLERY === {% endcomment %}
      <div class="s-main-product__gallery">
        {% if _product.images.size > 0 %}
          <div class="s-main-product__main-image" data-main-image>
            {% if section.settings.enable_zoom %}
              {% render 'component-image-zoom',
                images: _product.images,
                alt: _product.title
              %}
            {% else %}
            <img
              id="ProductImage-{{ section.id }}"
              src="{{ _product.featured_image | image_url: width: 800 }}"
              srcset="
                {{ _product.featured_image | image_url: width: 400 }} 400w,
                {{ _product.featured_image | image_url: width: 800 }} 800w,
                {{ _product.featured_image | image_url: width: 1200 }} 1200w,
                {{ _product.featured_image | image_url: width: 1600 }} 1600w
              "
              sizes="(max-width: 767px) 100vw, 50vw"
              alt="{{ _product.featured_image.alt | escape }}"
              width="800"
              height="1067"
              loading="eager"
              fetchpriority="high"
            >
            {% endif %}

            {% comment %} Video player overlay {% endcomment %}
            {% if _show_vid and _vid_url != blank %}
              <div class="s-main-product__video-player" data-video-player hidden>
                <div class="s-main-product__video-container">
                  <div data-video-embed></div>
                </div>
                <button
                  type="button"
                  class="s-main-product__video-close"
                  data-video-close
                  aria-label="Close video"
                >
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <line x1="18" y1="6" x2="6" y2="18"/>
                    <line x1="6" y1="6" x2="18" y2="18"/>
                  </svg>
                </button>
              </div>
            {% endif %}
          </div>

          {% if _gallery_style == 'thumbnails' and _product.images.size > 1 %}
            <div class="s-main-product__thumbs" role="tablist">
              {% for image in _product.images %}
                <button
                  type="button"
                  class="s-main-product__thumb {% if forloop.first %}is-active{% endif %}"
                  data-thumb
                  data-image-index="{{ forloop.index0 }}"
                  data-image-src="{{ image | image_url: width: 800 }}"
                  role="tab"
                  aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                  aria-label="View image {{ forloop.index }} of {{ _product.images.size }}"
                >
                  <img
                    src="{{ image | image_url: width: 200 }}"
                    alt="{{ image.alt | escape }}"
                    width="200"
                    height="200"
                    loading="lazy"
                  >
                </button>
              {% endfor %}

              {% comment %} Video thumbnail {% endcomment %}
              {% assign _show_vid = section.settings.show_video %}
              {% assign _vid_url = '' %}
              {% if _show_vid %}
                {% if section.settings.video_source == 'metafield' %}
                  {% assign _mf_parts = section.settings.video_metafield | split: '.' %}
                  {% if _mf_parts.size == 2 %}
                    {% assign _mf = _product.metafields[_mf_parts[0]][_mf_parts[1]] %}
                    {% if _mf and _mf != blank %}
                      {% assign _vid_url = _mf %}
                    {% endif %}
                  {% endif %}
                {% else %}
                  {% assign _vid_url = section.settings.video_url %}
                {% endif %}
              {% endif %}

              {% if _show_vid and _vid_url != blank %}
                <button
                  type="button"
                  class="s-main-product__thumb s-main-product__thumb--video"
                  data-video-thumb
                  data-video-url="{{ _vid_url }}"
                  role="tab"
                  aria-selected="false"
                  aria-label="View product video"
                >
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <polygon points="5 3 19 12 5 21 5 3" />
                  </svg>
                </button>
              {% endif %}
            </div>
          {% endif %}
        {% else %}
          <div class="s-main-product__main-image">
            <div class="c-product-card__placeholder">
              {{ 'products.product.product_image' | t | default: 'No image' }}
            </div>
          </div>
        {% endif %}
      </div>

      {% comment %} Product JSON data (used by JS variant selector) {% endcomment %}
      <script type="application/json" data-product-json>
        {{ _product | json }}
      </script>

      {% comment %} === PRODUCT INFO === {% endcomment %}
      <div class="s-main-product__info">
        {% if _show_vendor and _product.vendor %}
          <p class="s-main-product__vendor">{{ _product.vendor | escape }}</p>
        {% endif %}

        <h1 class="s-main-product__title">{{ _product.title | escape }}</h1>

        <div class="s-main-product__price-wrap">
          {% render 'component-product-price', product: _product, size: 'xl', show_badge: true %}
        </div>

        {% if _show_sku and _product.selected_or_first_available_variant.sku %}
          <div class="s-main-product__sku">
            SKU: {{ _product.selected_or_first_available_variant.sku }}
          </div>
        {% endif %}

        {% comment %} Variant pickers {% endcomment %}
        {% if _product.options.size > 0 %}
          {% for option in _product.options %}
            <div class="s-main-product__variant-group">
              <div class="s-main-product__variant-label">
                <span>{{ option.name | escape }}</span>
                <span class="s-main-product__variant-value">
                  {{ _product.selected_or_first_available_variant.options[forloop.index0] | escape }}
                </span>
              </div>
              <div class="c-swatches">
                {% assign _option_index = forloop.index0 %}
                {% for value in option.values %}
                  <button
                    type="button"
                    class="c-swatch"
                    role="radio"
                    aria-checked="{% if value == _product.selected_or_first_available_variant.options[_option_index] %}true{% else %}false{% endif %}"
                    data-option-index="{{ _option_index }}"
                    data-option-value="{{ value | escape }}"
                  >
                    {{ value | escape }}
                  </button>
                {% endfor %}
              </div>
            </div>
          {% endfor %}
        {% endif %}

        {% comment %} Stock indicator {% endcomment %}
        {% if section.settings.show_stock_indicator %}
          <div class="s-main-product__stock">
            {% render 'component-stock-indicator',
              product: _product,
              show_count: true,
              low_threshold: section.settings.low_stock_threshold
            %}
          </div>
        {% endif %}

        {% comment %} Quantity + add to cart {% endcomment %}
        <div class="s-main-product__actions">
          {% if _product.available %}
            <form method="post" action="/cart/add" class="s-main-product__qty-atc" data-add-to-cart>
              <input type="hidden" name="id" value="{{ _product.selected_or_first_available_variant.id }}" data-variant-id-input>
              <input type="hidden" name="form_type" value="product">
              <quantity-input>
                <div class="c-quantity">
                  <button type="button" class="c-quantity__btn" data-action="decrease" aria-label="Decrease quantity">−</button>
                  <input type="number" name="quantity" value="1" min="1" class="c-quantity__input" aria-label="Quantity" data-quantity-input>
                  <button type="button" class="c-quantity__btn" data-action="increase" aria-label="Increase quantity">+</button>
                </div>
              </quantity-input>

              {% comment %} App block: above add to cart {% endcomment %}
              <div class="s-main-product__app-block s-main-product__app-block--above-atc" data-app-above-atc>
                {% @themeapp 'above_add_to_cart' %}
              </div>

              <button type="submit" class="c-btn c-btn--primary" data-atc-button>
                <span data-atc-text>{{ 'products.product.add_to_cart' | t | default: 'Add to cart' }}</span>
                <span data-atc-loading style="display:none;">{{ 'products.product.adding' | t | default: 'Adding...' }}</span>
              </button>

              {% comment %} App block: below add to cart {% endcomment %}
              <div class="s-main-product__app-block s-main-product__app-block--below-atc" data-app-below-atc>
                {% @themeapp 'below_add_to_cart' %}
              </div>
            </form>
          {% else %}
            {% if section.settings.back_in_stock %}
              <div class="s-main-product__back-in-stock" data-back-in-stock>
                <button type="button" class="c-btn c-btn--primary c-btn--full" disabled>
                  {{ 'products.product.sold_out' | t | default: 'Sold out' }}
                </button>
                <p class="s-main-product__bis-text">
                  {{ 'products.product.bis_note' | t | default: 'Get notified when this is back in stock.' }}
                </p>
                <form
                  class="s-main-product__bis-form"
                  data-bis-form
                  action="{{ section.settings.back_in_stock_form_action }}"
                  method="post"
                >
                  <input
                    type="hidden"
                    name="product"
                    value="{{ _product.title | escape }}"
                  >
                  <input
                    type="hidden"
                    name="variant"
                    value="{{ _product.selected_or_first_available_variant.title | escape }}"
                    data-bis-variant
                  >
                  <input
                    type="email"
                    name="email"
                    class="s-main-product__bis-input"
                    placeholder="{{ 'products.product.bis_email' | t | default: 'Enter your email' }}"
                    required
                    data-bis-email
                  >
                  <button type="submit" class="c-btn c-btn--secondary c-btn--full">
                    {{ 'products.product.bis_submit' | t | default: 'Notify me' }}
                  </button>
                </form>
                <p class="s-main-product__bis-success" data-bis-success hidden>
                  {{ 'products.product.bis_success' | t | default: 'Thanks! We\u2019ll email you when it\u2019s back.' }}
                </p>
              </div>
            {% else %}
              <button type="button" class="c-btn c-btn--primary" disabled>
                {{ 'products.product.sold_out' | t | default: 'Sold out' }}
              </button>
            {% endif %}
          {% endif %}
        </div>

        {% comment %} Share buttons {% endcomment %}
        {% if section.settings.show_share %}
          <div class="c-product-card__vendor" style="display:flex;gap:var(--t-space-3);align-items:center;">
            <span style="font-size:var(--t-font-size-meta);text-transform:uppercase;letter-spacing:0.1em;color:var(--t-text-muted);font-weight:600;">Share</span>
            <a href="https://www.facebook.com/sharer/sharer.php?u={{ _product.url | absolute_url | url_encode }}" target="_blank" rel="noopener noreferrer" aria-label="Share on Facebook">FB</a>
            <a href="https://twitter.com/intent/tweet?text={{ _product.title | url_encode }}&url={{ _product.url | absolute_url | url_encode }}" target="_blank" rel="noopener noreferrer" aria-label="Share on Twitter">X</a>
          </div>
        {% endif %}

        {% comment %} Accordions {% endcomment %}
        <div class="s-main-product__accordions">
          <ui-accordion single>
            {% if section.settings.show_description and _product.description != blank %}
              <div class="c-accordion__item" aria-expanded="false">
                <button class="c-accordion__trigger">
                  <span>{{ 'products.product.description' | t | default: 'Description' }}</span>
                  <span class="c-accordion__icon" aria-hidden="true"></span>
                </button>
                <div class="c-accordion__content">
                  <div class="c-accordion__body">
                    {{ _product.description }}
                  </div>
                </div>
              </div>
            {% endif %}

            {% if section.settings.show_shipping %}
              <div class="c-accordion__item" aria-expanded="false">
                <button class="c-accordion__trigger">
                  <span>{{ 'products.product.shipping' | t | default: 'Shipping & Delivery' }}</span>
                  <span class="c-accordion__icon" aria-hidden="true"></span>
                </button>
                <div class="c-accordion__content">
                  <div class="c-accordion__body">
                    <p>Free shipping on orders over $75. Standard delivery 3-7 business days. Express shipping available at checkout.</p>
                  </div>
                </div>
              </div>
            {% endif %}

            {% if section.settings.show_returns %}
              <div class="c-accordion__item" aria-expanded="false">
                <button class="c-accordion__trigger">
                  <span>{{ 'products.product.returns' | t | default: 'Returns & Exchanges' }}</span>
                  <span class="c-accordion__icon" aria-hidden="true"></span>
                </button>
                <div class="c-accordion__content">
                  <div class="c-accordion__body">
                    <p>30-day return policy. Items must be unworn, unwashed, and with tags attached.</p>
                  </div>
                </div>
              </div>
            {% endif %}

            {% if section.settings.show_size_chart %}
              <div class="c-accordion__item" aria-expanded="false">
                <button class="c-accordion__trigger">
                  <span>{{ 'products.product.size_chart' | t | default: 'Size chart' }}</span>
                  <span class="c-accordion__icon" aria-hidden="true"></span>
                </button>
                <div class="c-accordion__content">
                  <div class="c-accordion__body">
                    {% render 'size-chart-table', product: product %}
                  </div>
                </div>
              </div>
            {% endif %}

            {% for block in section.blocks %}
              {% if block.type == 'accordion' %}
                <div class="c-accordion__item" aria-expanded="false" data-block-id="{{ block.id }}">
                  <button class="c-accordion__trigger">
                    <span>{{ block.settings.heading | escape }}</span>
                    <span class="c-accordion__icon" aria-hidden="true"></span>
                  </button>
                  <div class="c-accordion__content">
                    <div class="c-accordion__body">
                      {{ block.settings.content }}
                    </div>
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </ui-accordion>
        </div>

        {% comment %} Share buttons {% endcomment %}
        {% if section.settings.show_share %}
          <div class="s-main-product__share">
            {% render 'component-share-buttons',
              title: _product.title,
              url: _product.url | absolute_url
            %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  {% comment %} Sticky mobile add to cart {% endcomment %}
  {% if _sticky_atc and _product.available %}
    <div class="s-main-product__sticky-atc s-main-product__sticky-atc--enabled" data-sticky-atc>
      <div class="s-main-product__sticky-info">
        <p class="s-main-product__sticky-title">{{ _product.title | escape }}</p>
        <div class="s-main-product__sticky-price">
          {% render 'component-product-price', product: _product, size: 'sm', show_badge: false %}
        </div>
      </div>
      <form method="post" action="/cart/add">
        <input type="hidden" name="id" value="{{ _product.selected_or_first_available_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <button type="submit" class="c-btn c-btn--primary c-btn--sm">
          {{ 'products.product.add_to_cart' | t | default: 'Add to cart' }}
        </button>
      </form>
    </div>
  {% endif %}
</section>

{% javascript %}
class ImageZoom {
  constructor(zoomEl, lightboxEl, images) {
    this.zoomEl = zoomEl;
    this.lightboxEl = lightboxEl;
    this.images = images || [];
    this.currentIndex = 0;
    this.init();
  }

  init() {
    if (!this.zoomEl) return;

    this.img = this.zoomEl.querySelector('[data-zoom-img]');
    this.lens = this.zoomEl.querySelector('[data-zoom-lens]');
    this.result = this.zoomEl.querySelector('[data-zoom-result]');
    this.mainImageUrl = this.zoomEl.dataset.mainImage;

    // Hover zoom
    this.zoomEl.addEventListener('mouseenter', () => this.activateZoom());
    this.zoomEl.addEventListener('mouseleave', () => this.deactivateZoom());
    this.zoomEl.addEventListener('mousemove', (e) => this.handleZoomMove(e));

    // Click to open lightbox
    this.zoomEl.addEventListener('click', (e) => {
      if (e.target.closest('[data-video-thumb]')) return;
      this.openLightbox();
    });

    // Lightbox controls
    if (this.lightboxEl) {
      this.lightboxImg = this.lightboxEl.querySelector('[data-lightbox-img]');
      this.closeBtn = this.lightboxEl.querySelector('[data-lightbox-close]');
      this.prevBtn = this.lightboxEl.querySelector('[data-lightbox-prev]');
      this.nextBtn = this.lightboxEl.querySelector('[data-lightbox-next]');
      this.thumbs = this.lightboxEl.querySelectorAll('[data-lightbox-thumb]');
      this.counter = this.lightboxEl.querySelector('[data-lightbox-counter]');

      this.closeBtn?.addEventListener('click', () => this.closeLightbox());
      this.prevBtn?.addEventListener('click', () => this.prevImage());
      this.nextBtn?.addEventListener('click', () => this.nextImage());
      this.thumbs.forEach((t, i) => {
        t.addEventListener('click', () => this.goToImage(i));
      });

      // Keyboard
      document.addEventListener('keydown', (e) => {
        if (this.lightboxEl.hidden) return;
        if (e.key === 'Escape') this.closeLightbox();
        if (e.key === 'ArrowLeft') this.prevImage();
        if (e.key === 'ArrowRight') this.nextImage();
      });

      // Touch swipe
      let touchStartX = 0;
      this.lightboxEl.addEventListener('touchstart', (e) => {
        touchStartX = e.touches[0].clientX;
      }, { passive: true });
      this.lightboxEl.addEventListener('touchend', (e) => {
        const diff = touchStartX - e.changedTouches[0].clientX;
        if (Math.abs(diff) > 50) {
          if (diff > 0) this.nextImage();
          else this.prevImage();
        }
      });
    }
  }

  activateZoom() {
    if (!this.result || window.innerWidth < 1024) return;
    this.zoomEl.classList.add('is-active');
    if (this.result && this.mainImageUrl) {
      this.result.style.backgroundImage = `url(${this.mainImageUrl})`;
    }
  }

  deactivateZoom() {
    this.zoomEl.classList.remove('is-active');
  }

  handleZoomMove(e) {
    if (!this.lens || !this.result) return;

    const rect = this.zoomEl.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;

    const lensW = this.lens.offsetWidth;
    const lensH = this.lens.offsetHeight;

    let lensX = x - lensW / 2;
    let lensY = y - lensH / 2;

    lensX = Math.max(0, Math.min(lensX, rect.width - lensW));
    lensY = Math.max(0, Math.min(lensY, rect.height - lensH));

    this.lens.style.left = lensX + 'px';
    this.lens.style.top = lensY + 'px';

    // Result
    const zoomFactor = 2.5;
    const resultW = this.result.offsetWidth;
    const resultH = this.result.offsetHeight;

    const bgX = (lensX / rect.width) * 100;
    const bgY = (lensY / rect.height) * 100;

    this.result.style.backgroundPosition = `${bgX}% ${bgY}%`;
  }

  openLightbox() {
    if (!this.lightboxEl) return;
    this.lightboxEl.hidden = false;
    this.lightboxEl.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    this.updateLightboxImage();
  }

  closeLightbox() {
    if (!this.lightboxEl) return;
    this.lightboxEl.hidden = true;
    this.lightboxEl.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  goToImage(index) {
    if (index < 0 || index >= this.images.length) return;
    this.currentIndex = index;
    this.updateLightboxImage();
  }

  nextImage() {
    this.goToImage((this.currentIndex + 1) % this.images.length);
  }

  prevImage() {
    this.goToImage((this.currentIndex - 1 + this.images.length) % this.images.length);
  }

  updateLightboxImage() {
    if (!this.lightboxImg) return;
    const img = this.images[this.currentIndex];
    if (img) {
      this.lightboxImg.src = img.src || img;
      this.lightboxImg.alt = img.alt || '';
    }
    if (this.counter) {
      this.counter.textContent = `${this.currentIndex + 1} / ${this.images.length}`;
    }
    this.thumbs.forEach((t, i) => {
      t.classList.toggle('is-active', i === this.currentIndex);
    });
  }
}

class MainProductSection extends HTMLElement {
  constructor() {
    super();
    this._currentImageIndex = 0;
    this.variantSelector = null;
    this.product = null;
    this._isAdding = false;
  }

  connectedCallback() {
    this.cacheDOM();
    this.initVariantSelector();
    this.bindEvents();
    this.bindAddToCart();
    this.initImageZoom();
    this.initBackInStock();
  }

  disconnectedCallback() {
    if (this._thumbs) {
      this._thumbs.forEach((t) => t.removeEventListener('click', this._thumbHandler));
    }
  }

  cacheDOM() {
    this.mainImage = this.querySelector('[data-main-image] img');
    this.thumbs = this.querySelectorAll('[data-thumb]');
    this.priceEl = this.querySelector('[data-product-price]');
    this.variantIdInput = this.querySelector('[data-variant-id-input]');
    this.atcForm = this.querySelector('[data-add-to-cart]');
    this.atcButton = this.querySelector('[data-atc-button]');
    this.atcText = this.querySelector('[data-atc-text]');
    this.atcLoading = this.querySelector('[data-atc-loading]');
    this.quantityInput = this.querySelector('[data-quantity-input]');
    this.stickyAtc = this.querySelector('[data-sticky-atc]');

    // App block hooks
    this.appAboveAtc = this.querySelector('[data-app-above-atc]');
    this.appBelowAtc = this.querySelector('[data-app-below-atc]');
    this.appProduct = this.querySelector('[data-app-product]');

    // Product JSON
    const jsonEl = this.querySelector('[data-product-json]');
    if (jsonEl) {
      try {
        this.product = JSON.parse(jsonEl.textContent.trim());
      } catch (e) {
        console.warn('Failed to parse product JSON:', e);
        this.product = null;
      }
    }

    // Back in stock
    this.bisForm = this.querySelector('[data-bis-form]');
    this.bisSuccess = this.querySelector('[data-bis-success]');
    this.bisEmailInput = this.querySelector('[data-bis-email]');
    this.bisVariantInput = this.querySelector('[data-bis-variant]');
  }

  initVariantSelector() {
    if (!this.product || !this.product.variants) return;

    const { VariantSelector } = window.__theme;
    if (!VariantSelector) return;

    this.variantSelector = new VariantSelector(this.product, {
      onVariantChange: (variant, available) => {
        this._onVariantChange(variant, available);
      }
    });

    // Set initial variant
    if (this.variantSelector.currentVariant) {
      this._updateVariantUI(this.variantSelector.currentVariant);
    }
  }

  _onVariantChange(variant, available) {
    this._updateVariantUI(variant);

    // Update variant ID input
    if (this.variantIdInput) {
      this.variantIdInput.value = variant.id;
    }

    // Update image if variant has featured image
    if (variant.featured_image && this.mainImage) {
      const imgSrc = variant.featured_image.src;
      if (imgSrc && imgSrc !== this.mainImage.src) {
        this.mainImage.src = imgSrc;
      }
    }
  }

  _updateVariantUI(variant) {
    // Update displayed option values
    const variantLabels = this.querySelectorAll('.s-main-product__variant-value');
    if (variantLabels.length && variant.options) {
      variantLabels.forEach((el, i) => {
        if (variant.options[i]) {
          el.textContent = variant.options[i];
        }
      });
    }

    // Update price
    if (this.priceEl && window.__theme?.formatMoney) {
      this.priceEl.textContent = window.__theme.formatMoney(variant.price);
    }

    // Update button state
    if (this.atcButton) {
      this.atcButton.disabled = !variant.available;
      if (this.atcText) {
        this.atcText.textContent = variant.available
          ? this.atcText.dataset.defaultText || 'Add to cart'
          : 'Sold out';
      }
    }

    // Update URL with variant ID
    if (variant.id && window.history.replaceState) {
      const url = new URL(window.location.href);
      url.searchParams.set('variant', variant.id);
      window.history.replaceState(null, '', url.toString());
    }
  }

  bindEvents() {
    // Thumbnail navigation
    if (this.thumbs.length) {
      this._thumbHandler = (e) => {
        const btn = e.currentTarget;
        const src = btn.dataset.imageSrc;
        const idx = parseInt(btn.dataset.imageIndex, 10);
        this.setActiveImage(src, idx);
      };
      this.thumbs.forEach((t) => t.addEventListener('click', this._thumbHandler));
    }

    // Variant swatch buttons
    const swatchBtns = this.querySelectorAll('[data-option-value]');
    swatchBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const optionIndex = parseInt(btn.dataset.optionIndex, 10);
        const value = btn.dataset.optionValue;
        this._selectOption(optionIndex, value, btn);
      });
    });

    // Video thumbnail / player
    this.videoThumb = this.querySelector('[data-video-thumb]');
    this.videoPlayer = this.querySelector('[data-video-player]');
    this.videoEmbed = this.querySelector('[data-video-embed]');
    this.videoCloseBtn = this.querySelector('[data-video-close]');

    if (this.videoThumb && this.videoPlayer) {
      this.videoThumb.addEventListener('click', () => this._openVideo());
      this.videoCloseBtn?.addEventListener('click', () => this._closeVideo());
    }
  }

  _openVideo() {
    if (!this.videoPlayer || !this.videoEmbed) return;

    const url = this.videoThumb.dataset.videoUrl;
    if (!url) return;

    // Build embed
    let embed = '';

    // YouTube
    if (url.includes('youtube.com') || url.includes('youtu.be')) {
      let videoId = '';
      try {
        const u = new URL(url);
        if (u.hostname.includes('youtu.be')) {
          videoId = u.pathname.slice(1);
        } else {
          videoId = u.searchParams.get('v') || '';
        }
      } catch (e) { videoId = url.split('v=')[1]?.split('&')[0] || ''; }
      if (videoId) {
        embed = `<iframe src="https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0" frameborder="0" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>`;
      }
    }
    // Vimeo
    else if (url.includes('vimeo.com')) {
      let vimeoId = '';
      try {
        const u = new URL(url);
        vimeoId = u.pathname.replace(/\//g, '');
      } catch (e) {}
      if (vimeoId) {
        embed = `<iframe src="https://player.vimeo.com/video/${vimeoId}?autoplay=1" frameborder="0" allow="autoplay; fullscreen" allowfullscreen></iframe>`;
      }
    }
    // Native video (mp4, webm, etc.)
    else if (url.match(/\.(mp4|webm|ogg)$/i)) {
      embed = `<video src="${url}" controls autoplay playsinline></video>`;
    }
    // Fallback: iframe
    else {
      embed = `<iframe src="${url}" frameborder="0" allowfullscreen></iframe>`;
    }

    this.videoEmbed.innerHTML = embed;
    this.videoPlayer.hidden = false;

    // Deactivate all image thumbs, activate video thumb
    this.thumbs.forEach(t => {
      t.classList.remove('is-active');
      t.setAttribute('aria-selected', 'false');
    });
    this.videoThumb.classList.add('is-active');
    this.videoThumb.setAttribute('aria-selected', 'true');
  }

  _closeVideo() {
    if (!this.videoPlayer || !this.videoEmbed) return;
    this.videoEmbed.innerHTML = '';
    this.videoPlayer.hidden = true;

    // Re-activate first image thumb
    this.videoThumb.classList.remove('is-active');
    this.videoThumb.setAttribute('aria-selected', 'false');
    if (this.thumbs[0]) {
      this.thumbs[0].classList.add('is-active');
      this.thumbs[0].setAttribute('aria-selected', 'true');
    }
  }

  initBackInStock() {
    if (!this.bisForm) return;

    this.bisForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const email = this.bisEmailInput?.value;
      if (!email) return;

      // If form has action URL, submit via fetch
      const action = this.bisForm.getAttribute('action');
      if (action && action !== '') {
        fetch(action, {
          method: 'POST',
          body: new FormData(this.bisForm)
        }).catch(() => {}); // Silent fail for demo
      }

      // Show success
      this.bisForm.style.display = 'none';
      if (this.bisSuccess) this.bisSuccess.hidden = false;
    });
  }

  initImageZoom() {
    const zoomEl = this.querySelector('[data-image-zoom]');
    const lightboxEl = this.querySelector('[data-lightbox]');

    if (!zoomEl) return;

    // Build image array from product JSON
    const images = [];
    if (this.product?.images) {
      this.product.images.forEach((img) => {
        images.push({
          src: img.src || img,
          alt: img.alt || this.product.title || 'Product image'
        });
      });
    }

    // Fallback: use the main image src
    if (images.length === 0 && zoomEl.dataset.mainImage) {
      images.push({
        src: zoomEl.dataset.mainImage,
        alt: 'Product image'
      });
    }

    this.imageZoom = new ImageZoom(zoomEl, lightboxEl, images);
  }

  _selectOption(optionIndex, value, clickedBtn) {
    if (!this.variantSelector) return;

    this.variantSelector.selectByIndex(optionIndex, value);

    // Update active state of buttons in this group
    const group = clickedBtn.closest('.c-swatches');
    if (group) {
      group.querySelectorAll('[data-option-value]').forEach((b) => {
        const isActive = b.dataset.optionValue === value;
        b.classList.toggle('is-active', isActive);
        b.setAttribute('aria-checked', isActive ? 'true' : 'false');
      });
    }
  }

  bindAddToCart() {
    if (!this.atcForm) return;

    this.atcForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (this._isAdding) return;

      const variantId = this.variantIdInput?.value;
      const quantity = parseInt(this.quantityInput?.value || '1', 10);

      if (!variantId || !window.__theme?.CartAPI) {
        // Fallback: normal form submit
        this.atcForm.submit();
        return;
      }

      this._setAddingState(true);

      try {
        await window.__theme.CartAPI.addItem(variantId, quantity);
        this.publish('cart:add-success', { variantId, quantity });

        // Open cart drawer
        this.publish('cart:open');
      } catch (err) {
        console.warn('Add to cart failed:', err.message);
        this.publish('cart:error', { error: err.message });
      } finally {
        this._setAddingState(false);
      }
    });

    // Quantity buttons
    const qtyBtns = this.atcForm.querySelectorAll('.c-quantity__btn');
    qtyBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!this.quantityInput) return;
        const action = btn.dataset.action;
        let val = parseInt(this.quantityInput.value, 10) || 1;
        if (action === 'increase') val++;
        if (action === 'decrease') val = Math.max(1, val - 1);
        this.quantityInput.value = val;
      });
    });
  }

  _setAddingState(isAdding) {
    this._isAdding = isAdding;
    if (this.atcButton) {
      this.atcButton.disabled = isAdding;
    }
    if (this.atcText) {
      this.atcText.style.display = isAdding ? 'none' : '';
    }
    if (this.atcLoading) {
      this.atcLoading.style.display = isAdding ? '' : 'none';
    }
  }

  setActiveImage(src, index) {
    if (this.mainImage) {
      this.mainImage.src = src;
    }
    this.thumbs.forEach((t, i) => {
      const active = i === index;
      t.classList.toggle('is-active', active);
      t.setAttribute('aria-selected', active ? 'true' : 'false');
    });
    this._currentImageIndex = index;
  }

  onBlockSelect(evt) {
    const block = this.querySelector(`[data-block-id="${evt.detail.blockId}"]`);
    if (block) {
      block.setAttribute('aria-expanded', 'true');
      block.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  }

  onBlockDeselect() {}
}

if (!customElements.get('main-product-section')) {
  customElements.define('main-product-section', MainProductSection);
}
