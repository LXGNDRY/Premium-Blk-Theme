{% schema %}
{
  "name": "Product page",
  "tag": "section",
  "class": "section-main-product",
  "enabled_on": {
    "groups": [
      "*"
    ]
  },
  "max_blocks": 16,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sku",
      "label": "Show SKU",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_share_buttons",
      "label": "Show share buttons",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_payment_buttons",
      "label": "Show dynamic checkout buttons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_info",
      "label": "Enable sticky 'Add to cart'",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show description",
      "default": true
    },
    {
      "type": "select",
      "id": "media_size",
      "label": "Media size",
      "default": "medium",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ]
    },
    {
      "type": "select",
      "id": "thumbnail_position",
      "label": "Thumbnail position",
      "default": "bottom",
      "options": [
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ]
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Media position",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_video_looping",
      "label": "Enable video looping",
      "default": false
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1",
      "options": [
        {
          "value": "background-1",
          "label": "Background 1"
        },
        {
          "value": "background-2",
          "label": "Background 2"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Description"
        }
      ]
    },
    {
      "type": "icon_with_text",
      "name": "Icon with text",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon",
          "default": "checkmark"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Free shipping"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": ""
        }
      ]
    },
    {
      "type": "collapsible_tab",
      "name": "Collapsible tab",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Tab"
        },
        {
          "type": "textarea",
          "id": "content",
          "label": "Content",
          "default": ""
        }
      ]
    },
    {
      "type": "app",
      "name": "App",
      "limit": 16,
      "settings": []
    }
  ],
  "presets": [
    {
      "name": "Product page",
      "category": "Product"
    }
  ]
}
{% endschema %}

{% stylesheet %}
.section-main-product {
  padding: var(--spacing-xl) 0;
  position: relative;
}

.section-main-product .section__header {
  text-align: center;
  margin-bottom: var(--spacing-lg);
}

.section-main-product .section__heading {
  font-size: calc(var(--font-size-h2) * 1px);
  font-weight: 600;
  margin: 0 0 var(--spacing-md) 0;
  color: var(--color-text);
}

.section-main-product .section__subheading {
  color: var(--color-text-subdued);
  max-width: 600px;
  margin: 0 auto;
}

.section-main-product .container {
  max-width: calc(var(--container-max-width) * 1px);
  margin: 0 auto;
  padding: 0 calc(var(--content-padding) * 1px);
}
{% endstylesheet %}

<section
  id="section-{{ section.id }}"
  class="section-main-product"
  style="
    {% if section.settings.background_color %}
      background-color: {{ section.settings.background_color }};
    {% endif %}
    {% if section.settings.top_padding %}
      padding-top: {{ section.settings.top_padding }}px;
    {% endif %}
    {% if section.settings.bottom_padding %}
      padding-bottom: {{ section.settings.bottom_padding }}px;
    {% endif %}
  "
>
  <div class="container">
    {% if section.settings.heading %}
      <div class="section__header">
        <h2 class="section__heading">{{ section.settings.heading | escape }}</h2>
        {% if section.settings.subheading %}
          <p class="section__subheading">{{ section.settings.subheading | escape }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="blocks blocks--main-product">
      {% for block in section.blocks %}
        <div
          class="block block--{{ block.type }}"
          style="
            {% if block.settings.alignment %}text-align: {{ block.settings.alignment }};{% endif %}
          "
        >
          {% case block.type %}

{%- when 'text' -%}
  <div class="block__text rte">
    {{ block.settings.text | default: 'Add your text here.' }}
  </div>
{%- when 'icon_with_text' -%}
  <div class="block__content">
    {% if block.settings.content %}
      {{ block.settings.content }}
    {% else %}
      Icon with text
    {% endif %}
  </div>
{%- when 'collapsible_tab' -%}
  <div class="block__content">
    {% if block.settings.content %}
      {{ block.settings.content }}
    {% else %}
      Collapsible tab
    {% endif %}
  </div>
{%- when 'app' -%}
  <div class="block__content">
    {% if block.settings.content %}
      {{ block.settings.content }}
    {% else %}
      App
    {% endif %}
  </div>
          {% endcase %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% javascript %}
class MainProductSection extends HTMLElement {
  constructor() {
    super();
  }

  connectedCallback() {
    this.init();
  }

  init() {
    // Section initialization logic
  }

  onBlockSelect(evt) {
    // Block selected in editor
  }

  onBlockDeselect(evt) {
    // Block deselected in editor
  }
}

if (!customElements.get('section-main-product')) {
  customElements.define('section-main-product', MainProductSection);
}
{% endjavascript %}
