{% schema %}
{
  "name": "Announcement bar",
  "tag": "section",
  "class": "section-announcement-bar",
  "enabled_on": {
    "groups": [
      "*"
    ]
  },
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Announcement text",
      "default": "Free shipping on orders over $75"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "color",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "#000000"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Make sticky on scroll",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_gradient",
      "label": "Enable gradient background",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "limit": 12,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Announcement"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "default": ""
        },
        {
          "type": "checkbox",
          "id": "show_arrow",
          "label": "Show arrow",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "category": "Header"
    }
  ]
}
{% endschema %}

{% stylesheet %}
.section-announcement-bar {
  padding: var(--spacing-xl) 0;
  position: relative;
}

.section-announcement-bar .section__header {
  text-align: center;
  margin-bottom: var(--spacing-lg);
}

.section-announcement-bar .section__heading {
  font-size: calc(var(--font-size-h2) * 1px);
  font-weight: 600;
  margin: 0 0 var(--spacing-md) 0;
  color: var(--color-text);
}

.section-announcement-bar .section__subheading {
  color: var(--color-text-subdued);
  max-width: 600px;
  margin: 0 auto;
}

.section-announcement-bar .container {
  max-width: calc(var(--container-max-width) * 1px);
  margin: 0 auto;
  padding: 0 calc(var(--content-padding) * 1px);
}
{% endstylesheet %}

<section
  id="section-{{ section.id }}"
  class="section-announcement-bar"
  style="
    {% if section.settings.background_color %}
      background-color: {{ section.settings.background_color }};
    {% endif %}
    {% if section.settings.top_padding %}
      padding-top: {{ section.settings.top_padding }}px;
    {% endif %}
    {% if section.settings.bottom_padding %}
      padding-bottom: {{ section.settings.bottom_padding }}px;
    {% endif %}
  "
>
  <div class="container">
    {% if section.settings.heading %}
      <div class="section__header">
        <h2 class="section__heading">{{ section.settings.heading | escape }}</h2>
        {% if section.settings.subheading %}
          <p class="section__subheading">{{ section.settings.subheading | escape }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="blocks blocks--announcement-bar">
      {% for block in section.blocks %}
        <div
          class="block block--{{ block.type }}"
          style="
            {% if block.settings.alignment %}text-align: {{ block.settings.alignment }};{% endif %}
          "
        >
          {% case block.type %}
{%- when 'announcement' -%}
  <div class="block__content">
    {% if block.settings.content %}
      {{ block.settings.content }}
    {% else %}
      Announcement
    {% endif %}
  </div>
          {% endcase %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% javascript %}
class AnnouncementBarSection extends HTMLElement {
  constructor() {
    super();
  }

  connectedCallback() {
    this.init();
  }

  init() {
    // Section initialization logic
  }

  onBlockSelect(evt) {
    // Block selected in editor
  }

  onBlockDeselect(evt) {
    // Block deselected in editor
  }
}

if (!customElements.get('section-announcement-bar')) {
  customElements.define('section-announcement-bar', AnnouncementBarSection);
}
{% endjavascript %}
