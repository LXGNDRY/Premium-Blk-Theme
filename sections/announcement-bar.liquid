{% schema %}
{
  "name": "Announcement bar",
  "tag": "section",
  "class": "s-announcement-bar",
  "enabled_on": {
    "groups": ["*"]
  },
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Messages"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Display style",
      "default": "marquee",
      "options": [
        { "value": "marquee", "label": "Scrolling marquee" },
        { "value": "static", "label": "Static single message" },
        { "value": "rotate", "label": "Rotating messages" }
      ]
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll speed (marquee only)",
      "min": 5,
      "max": 60,
      "step": 5,
      "unit": "s",
      "default": 20
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "checkbox",
      "id": "dismissible",
      "label": "Allow dismissing",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_separator",
      "label": "Show bottom border",
      "default": true
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text style",
      "default": "uppercase",
      "options": [
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "none", "label": "Normal" }
      ]
    },
    {
      "type": "header",
      "content": "Icons"
    },
    {
      "type": "checkbox",
      "id": "show_dot",
      "label": "Show dot separators (marquee)",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Message text",
          "default": "Free shipping on orders over $75"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL",
          "default": ""
        },
        {
          "type": "checkbox",
          "id": "new_tab",
          "label": "Open in new tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "category": "Header",
      "blocks": [
        {
          "type": "message",
          "settings": {
            "text": "Free shipping on orders over $75"
          }
        }
      ]
    }
  ]
}
{% endschema %}

{% stylesheet %}
.s-announcement-bar {
  width: 100%;
  background: var(--t-accent);
  color: var(--t-bg);
  position: relative;
  overflow: hidden;
  font-size: var(--t-font-size-small);
  font-weight: 500;
}

.s-announcement-bar--separator {
  border-bottom: 1px solid var(--t-border);
}

/* Single static message */
.s-announcement-bar__inner {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 40px;
  padding: var(--t-space-2) var(--t-space-5);
  gap: var(--t-space-3);
  text-align: center;
}

.s-announcement-bar__text {
  font-size: var(--t-font-size-small);
  font-weight: 500;
  line-height: 1.3;
  margin: 0;
}

.s-announcement-bar--uppercase .s-announcement-bar__text {
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-size: var(--t-font-size-meta);
  font-weight: 600;
}

.s-announcement-bar__link {
  color: inherit;
  text-decoration: none;
  display: inline-block;
}

.s-announcement-bar__link:hover {
  text-decoration: underline;
  text-underline-offset: 3px;
}

/* Marquee / scrolling */
.s-announcement-bar__marquee {
  display: flex;
  width: max-content;
  animation: s-announcement-marquee var(--marquee-speed, 20s) linear infinite;
  will-change: transform;
}

.s-announcement-bar__marquee-track {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  padding: var(--t-space-2) 0;
}

.s-announcement-bar__marquee-item {
  display: inline-flex;
  align-items: center;
  gap: var(--t-space-6);
  padding: 0 var(--t-space-8);
  white-space: nowrap;
  flex-shrink: 0;
}

.s-announcement-bar__marquee-text {
  font-size: var(--t-font-size-small);
  font-weight: 500;
  line-height: 1.3;
}

.s-announcement-bar--uppercase .s-announcement-bar__marquee-text {
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-size: var(--t-font-size-meta);
  font-weight: 600;
}

.s-announcement-bar__marquee-link {
  color: inherit;
  text-decoration: none;
}

.s-announcement-bar__marquee-link:hover {
  text-decoration: underline;
  text-underline-offset: 3px;
}

.s-announcement-bar__dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: currentColor;
  opacity: 0.5;
  flex-shrink: 0;
}

@keyframes s-announcement-marquee {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}

/* Rotating messages (fade/slide) */
.s-announcement-bar__rotator {
  position: relative;
  min-height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--t-space-2) var(--t-space-5);
}

.s-announcement-bar__rotator-item {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
  opacity: 0;
  transform: translateY(-8px);
  transition: opacity 0.3s ease, transform 0.3s ease;
  pointer-events: none;
}

.s-announcement-bar__rotator-item.is-active {
  opacity: 1;
  transform: translateY(0);
  position: relative;
  pointer-events: auto;
}

/* Dismiss button */
.s-announcement-bar__dismiss {
  position: absolute;
  top: 50%;
  right: var(--t-space-4);
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  background: transparent;
  border: none;
  color: inherit;
  cursor: pointer;
  opacity: 0.7;
  transition: opacity var(--t-transition-fast);
  padding: 0;
  border-radius: var(--t-radius);
  z-index: 2;
}

.s-announcement-bar__dismiss:hover {
  opacity: 1;
}

.s-announcement-bar__dismiss:focus-visible {
  outline: 2px solid var(--t-bg);
  outline-offset: 2px;
}

.s-announcement-bar__dismiss svg {
  width: 16px;
  height: 16px;
}

/* Closed state */
.s-announcement-bar.is-closed {
  display: none;
}

/* Reduced motion */
@media (prefers-reduced-motion: reduce) {
  .s-announcement-bar__marquee {
    animation: none;
  }
}

/* Mobile */
@media (max-width: 767px) {
  .s-announcement-bar__dismiss {
    right: var(--t-space-3);
  }

  .s-announcement-bar__marquee-item {
    padding: 0 var(--t-space-6);
  }
}
{% endstylesheet %}

{%- liquid
  assign style = section.settings.style
  assign dismissible = section.settings.dismissible
  assign show_separator = section.settings.show_separator
  assign text_transform = section.settings.text_transform
  assign show_dot = section.settings.show_dot
  assign speed = section.settings.speed

  assign classes = 's-announcement-bar'
  if show_separator
    assign classes = classes | append: ' s-announcement-bar--separator'
  endif
  if text_transform == 'uppercase'
    assign classes = classes | append: ' s-announcement-bar--uppercase'
  endif
-%}

<section
  id="section-{{ section.id }}"
  class="{{ classes }}"
  data-section-id="{{ section.id }}"
  data-section-type="announcement-bar"
  role="region"
  aria-label="Announcement"
  {% if style == 'marquee' %}style="--marquee-speed: {{ speed }}s;"{% endif %}
>
  {% if style == 'marquee' and section.blocks.size > 0 %}
    {% comment %} === MARQUEE STYLE === {% endcomment %}
    <div class="s-announcement-bar__marquee" aria-live="polite">
      {% comment %} Duplicate track for seamless loop {% endcomment %}
      {% for i in (1..2) %}
        <div class="s-announcement-bar__marquee-track">
          {% for block in section.blocks %}
            <div class="s-announcement-bar__marquee-item">
              {% if block.settings.link != blank %}
                <a
                  href="{{ block.settings.link }}"
                  class="s-announcement-bar__marquee-link"
                  {% if block.settings.new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
                >
                  <span class="s-announcement-bar__marquee-text">{{ block.settings.text | escape }}</span>
                </a>
              {% else %}
                <span class="s-announcement-bar__marquee-text">{{ block.settings.text | escape }}</span>
              {% endif %}
              {% if show_dot and forloop.last == false %}
                <span class="s-announcement-bar__dot" aria-hidden="true"></span>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endfor %}
    </div>

  {% elsif style == 'rotate' and section.blocks.size > 0 %}
    {% comment %} === ROTATING STYLE === {% endcomment %}
    <div class="s-announcement-bar__rotator" data-rotator aria-live="polite">
      {% for block in section.blocks %}
        <div
          class="s-announcement-bar__rotator-item {% if forloop.first %}is-active{% endif %}"
          data-rotator-item
          data-block-id="{{ block.id }}"
        >
          {% if block.settings.link != blank %}
            <a
              href="{{ block.settings.link }}"
              class="s-announcement-bar__link"
              {% if block.settings.new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
            >
              {{ block.settings.text | escape }}
            </a>
          {% else %}
            {{ block.settings.text | escape }}
          {% endif %}
        </div>
      {% endfor %}
    </div>

  {% else %}
    {% comment %} === STATIC SINGLE MESSAGE (default) === {% endcomment %}
    <div class="s-announcement-bar__inner">
      {% assign first_block = section.blocks[0] %}
      {% if first_block and first_block.settings.text != blank %}
        <p class="s-announcement-bar__text">
          {% if first_block.settings.link != blank %}
            <a
              href="{{ first_block.settings.link }}"
              class="s-announcement-bar__link"
              {% if first_block.settings.new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
            >
              {{ first_block.settings.text | escape }}
            </a>
          {% else %}
            {{ first_block.settings.text | escape }}
          {% endif %}
        </p>
      {% else %}
        <p class="s-announcement-bar__text">Add an announcement message</p>
      {% endif %}
    </div>
  {% endif %}

  {% if dismissible %}
    <button
      type="button"
      class="s-announcement-bar__dismiss"
      aria-label="Dismiss announcement"
      data-dismiss
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  {% endif %}
</section>

{% javascript %}
class AnnouncementBar extends HTMLElement {
  constructor() {
    super();
    this._dismissed = false;
    this._rotatorIndex = 0;
    this._rotatorTimer = null;
  }

  connectedCallback() {
    this.cacheDOM();
    this.bindEvents();
    this.checkDismissed();
    this.initRotator();
  }

  disconnectedCallback() {
    if (this._dismissBtn) {
      this._dismissBtn.removeEventListener('click', this._dismissHandler);
    }
    if (this._rotatorTimer) {
      clearInterval(this._rotatorTimer);
    }
  }

  cacheDOM() {
    this._dismissBtn = this.querySelector('[data-dismiss]');
    this._rotator = this.querySelector('[data-rotator]');
    if (this._rotator) {
      this._rotatorItems = Array.from(this.querySelectorAll('[data-rotator-item]'));
    }
  }

  bindEvents() {
    if (this._dismissBtn) {
      this._dismissHandler = () => this.dismiss();
      this._dismissBtn.addEventListener('click', this._dismissHandler);
    }
  }

  checkDismissed() {
    try {
      const sectionId = this.dataset.sectionId;
      const dismissed = localStorage.getItem(`announcement-dismissed-${sectionId}`);
      if (dismissed === 'true') {
        this.classList.add('is-closed');
      }
    } catch (e) {}
  }

  dismiss() {
    this.classList.add('is-closed');
    try {
      const sectionId = this.dataset.sectionId;
      localStorage.setItem(`announcement-dismissed-${sectionId}`, 'true');
    } catch (e) {}
    this.dispatchEvent(new CustomEvent('announcement:dismiss', {
      bubbles: true,
      detail: { sectionId: this.dataset.sectionId }
    }));
  }

  initRotator() {
    if (!this._rotator || !this._rotatorItems || this._rotatorItems.length < 2) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    this._rotatorIndex = 0;
    this._rotatorTimer = setInterval(() => this.advance(), 3500);
  }

  advance() {
    const total = this._rotatorItems.length;
    this._rotatorItems[this._rotatorIndex].classList.remove('is-active');
    this._rotatorIndex = (this._rotatorIndex + 1) % total;
    this._rotatorItems[this._rotatorIndex].classList.add('is-active');
  }

  onBlockSelect(evt) {
    const blockId = evt.detail.blockId;
    const item = this.querySelector(`[data-block-id="${blockId}"]`);
    if (item) {
      // Jump to the selected message in theme editor
      if (this._rotatorItems && this._rotatorItems.length > 1) {
        this._rotatorItems.forEach((el) => el.classList.remove('is-active'));
        item.classList.add('is-active');
      }
    }
  }

  onBlockDeselect() {}
}

if (!customElements.get('announcement-bar')) {
  customElements.define('announcement-bar', AnnouncementBar);
}
{% endjavascript %}
