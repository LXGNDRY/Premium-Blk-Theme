{% comment %}
  testimonials.liquid
  Customer testimonials / reviews section.
  Block-based, multiple layout options.
{% endcomment %}

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What our customers say"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Don't just take our word for it"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "grid",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "carousel", "label": "Carousel" },
        { "value": "masonry", "label": "Masonry" }
      ]
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show star rating",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_avatar",
      "label": "Show avatar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_name",
      "label": "Show name",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_role",
      "label": "Show role / location",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "limit": 20,
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Best streetwear I've ever bought. Quality is insane."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Alex Morgan"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role / location",
          "default": "Verified buyer"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Avatar image"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Star rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "category": "Content",
      "blocks": [
        { "type": "testimonial", "settings": { "quote": "Absolute bangers. Every piece hits different.", "name": "Jordan K.", "role": "LA, CA", "rating": 5 } },
        { "type": "testimonial", "settings": { "quote": "Quality is unmatched. Been wearing for 2 years straight.", "name": "Maya R.", "role": "NY, NY", "rating": 5 } },
        { "type": "testimonial", "settings": { "quote": "Finally a brand that gets the fit right on day one.", "name": "Chris D.", "role": "Chicago, IL", "rating": 5 } }
      ]
    }
  ]
}
{% endschema %}

{% stylesheet %}
.s-testimonials {
  padding: var(--t-space-16) 0;
}

.s-testimonials__header {
  text-align: center;
  max-width: 640px;
  margin: 0 auto var(--t-space-12);
}

.s-testimonials__heading {
  font-size: clamp(2rem, 5vw, 3.5rem);
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: -0.02em;
  line-height: var(--t-line-height-tight);
  margin: 0 0 var(--t-space-3);
}

.s-testimonials__subheading {
  font-size: var(--t-font-size-body);
  color: var(--t-text-muted);
  margin: 0;
}

.s-testimonials__grid {
  display: grid;
  gap: var(--t-space-5);
}

.s-testimonials__grid--cols-2 { grid-template-columns: repeat(2, 1fr); }
.s-testimonials__grid--cols-3 { grid-template-columns: repeat(3, 1fr); }
.s-testimonials__grid--cols-4 { grid-template-columns: repeat(4, 1fr); }

.s-testimonials__carousel {
  position: relative;
  overflow: hidden;
}

.s-testimonials__carousel-track {
  display: flex;
  transition: transform 0.5s var(--t-ease-out);
  will-change: transform;
}

.s-testimonials__carousel-slide {
  flex: 0 0 100%;
  min-width: 0;
  padding: 0 var(--t-space-2);
  box-sizing: border-box;
}

.s-testimonials__card {
  background: var(--t-surface);
  border: 1px solid var(--t-border);
  padding: var(--t-space-6);
  display: flex;
  flex-direction: column;
  gap: var(--t-space-4);
  height: 100%;
  box-sizing: border-box;
}

.s-testimonials__rating {
  display: flex;
  gap: 2px;
  color: var(--t-text);
}

.s-testimonials__rating svg {
  width: 16px;
  height: 16px;
  fill: var(--t-text);
}

.s-testimonials__rating svg.is-empty {
  fill: none;
  stroke: var(--t-border);
  stroke-width: 2;
}

.s-testimonials__quote {
  font-size: var(--t-font-size-body);
  line-height: var(--t-line-height-body);
  color: var(--t-text);
  margin: 0;
  font-style: italic;
}

.s-testimonials__author {
  display: flex;
  align-items: center;
  gap: var(--t-space-3);
  margin-top: auto;
  padding-top: var(--t-space-3);
  border-top: 1px solid var(--t-border);
}

.s-testimonials__avatar {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: var(--t-border);
  flex-shrink: 0;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: var(--t-font-size-small);
  text-transform: uppercase;
  color: var(--t-text);
}

.s-testimonials__avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.s-testimonials__author-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.s-testimonials__name {
  font-size: var(--t-font-size-small);
  font-weight: 700;
  margin: 0;
}

.s-testimonials__role {
  font-size: var(--t-font-size-meta);
  color: var(--t-text-muted);
  margin: 0;
}

/* Carousel controls */
.s-testimonials__controls {
  display: flex;
  justify-content: center;
  gap: var(--t-space-3);
  margin-top: var(--t-space-6);
}

.s-testimonials__nav-btn {
  width: 44px;
  height: 44px;
  border: 1px solid var(--t-border);
  background: var(--t-bg);
  color: var(--t-text);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--t-transition-fast);
}

.s-testimonials__nav-btn:hover {
  background: var(--t-text);
  color: var(--t-bg);
  border-color: var(--t-text);
}

.s-testimonials__dots {
  display: flex;
  justify-content: center;
  gap: 8px;
  margin-top: var(--t-space-4);
}

.s-testimonials__dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--t-border);
  border: none;
  padding: 0;
  cursor: pointer;
  transition: background var(--t-transition-fast);
}

.s-testimonials__dot.is-active {
  background: var(--t-text);
}

@media (max-width: 1023px) {
  .s-testimonials__grid--cols-3,
  .s-testimonials__grid--cols-4 {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 639px) {
  .s-testimonials__grid--cols-2,
  .s-testimonials__grid--cols-3,
  .s-testimonials__grid--cols-4 {
    grid-template-columns: 1fr;
  }
}
{% endstylesheet %}

{%- liquid
  assign _heading = section.settings.heading
  assign _subheading = section.settings.subheading
  assign _layout = section.settings.layout
  assign _cols = section.settings.columns
  assign _show_rating = section.settings.show_rating
  assign _show_avatar = section.settings.show_avatar
  assign _show_name = section.settings.show_name
  assign _show_role = section.settings.show_role
  assign _testimonials = section.blocks
-%}

<section
  id="section-{{ section.id }}"
  class="s-testimonials"
  data-section-id="{{ section.id }}"
  data-section-type="testimonials"
  data-layout="{{ _layout }}"
>
  <div class="c-container">
    {% if _heading or _subheading %}
      <div class="s-testimonials__header">
        {% if _heading %}
          <h2 class="s-testimonials__heading">{{ _heading | escape }}</h2>
        {% endif %}
        {% if _subheading %}
          <p class="s-testimonials__subheading">{{ _subheading | escape }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if _testimonials.size > 0 %}
      {% if _layout == 'carousel' %}
        <div class="s-testimonials__carousel" data-testimonial-carousel>
          <div class="s-testimonials__carousel-track" data-carousel-track>
            {% for block in _testimonials %}
              <div class="s-testimonials__carousel-slide">
                {% render 'testimonial-card',
                  block: block,
                  show_rating: _show_rating,
                  show_avatar: _show_avatar,
                  show_name: _show_name,
                  show_role: _show_role
                %}
              </div>
            {% endfor %}
          </div>

          <div class="s-testimonials__controls">
            <button type="button" class="s-testimonials__nav-btn" data-carousel-prev aria-label="Previous testimonial">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
            <button type="button" class="s-testimonials__nav-btn" data-carousel-next aria-label="Next testimonial">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          </div>

          <div class="s-testimonials__dots" data-carousel-dots>
            {% for block in _testimonials %}
              <button
                type="button"
                class="s-testimonials__dot{% if forloop.first %} is-active{% endif %}"
                data-carousel-dot
                data-index="{{ forloop.index0 }}"
                aria-label="Go to testimonial {{ forloop.index }}"
              ></button>
            {% endfor %}
          </div>
        </div>
      {% else %}
        <div class="s-testimonials__grid s-testimonials__grid--cols-{{ _cols }}">
          {% for block in _testimonials %}
            {% render 'testimonial-card',
              block: block,
              show_rating: _show_rating,
              show_avatar: _show_avatar,
              show_name: _show_name,
              show_role: _show_role
            %}
          {% endfor %}
        </div>
      {% endif %}
    {% else %}
      <div class="s-testimonials__empty" style="text-align:center;padding:var(--t-space-8) 0;color:var(--t-text-muted);">
        No testimonials yet. Add them in the theme editor.
      </div>
    {% endif %}
  </div>
</section>

{% javascript %}
class TestimonialsSection extends HTMLElement {
  constructor() {
    super();
    this.currentIndex = 0;
    this.autoPlay = true;
  }

  connectedCallback() {
    this.layout = this.dataset.layout || 'grid';
    if (this.layout === 'carousel') this._initCarousel();
  }

  _initCarousel() {
    this.track = this.querySelector('[data-carousel-track]');
    this.slides = this.querySelectorAll('.s-testimonials__carousel-slide');
    this.prevBtn = this.querySelector('[data-carousel-prev]');
    this.nextBtn = this.querySelector('[data-carousel-next]');
    this.dots = this.querySelectorAll('[data-carousel-dot]');
    this.total = this.slides.length;

    if (!this.track || this.total <= 1) return;

    this.prevBtn?.addEventListener('click', () => this.prev());
    this.nextBtn?.addEventListener('click', () => this.next());

    this.dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const idx = parseInt(dot.dataset.index, 10);
        this.goTo(idx);
      });
    });

    // Auto-play
    this._startAutoPlay();
    this.addEventListener('mouseenter', () => this._stopAutoPlay());
    this.addEventListener('mouseleave', () => this._startAutoPlay());

    // Touch swipe
    let startX = 0;
    this.track.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX;
      this._stopAutoPlay();
    }, { passive: true });
    this.track.addEventListener('touchend', (e) => {
      const diff = startX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 50) diff > 0 ? this.next() : this.prev();
      this._startAutoPlay();
    });
  }

  goTo(index) {
    this.currentIndex = (index + this.total) % this.total;
    this.track.style.transform = `translateX(-${this.currentIndex * 100}%)`;
    this.dots.forEach((d, i) => d.classList.toggle('is-active', i === this.currentIndex));
  }

  next() { this.goTo(this.currentIndex + 1); }
  prev() { this.goTo(this.currentIndex - 1); }

  _startAutoPlay() {
    if (!this.autoPlay) return;
    this._stopAutoPlay();
    this._interval = setInterval(() => this.next(), 5000);
  }

  _stopAutoPlay() {
    if (this._interval) {
      clearInterval(this._interval);
      this._interval = null;
    }
  }

  onBlockSelect() {}
  onBlockDeselect() {}
}

if (!customElements.get('testimonials-section')) {
  customElements.define('testimonials-section', TestimonialsSection);
}
{% endjavascript %}
