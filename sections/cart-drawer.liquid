{% schema %}
{
  "name": "Cart drawer",
  "tag": "section",
  "class": "s-cart-drawer",
  "enabled_on": {
    "groups": ["*"]
  },
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Behavior"
    },
    {
      "type": "checkbox",
      "id": "open_on_add",
      "label": "Open drawer when item is added to cart",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cross_sell",
      "label": "Show cross-sell products in drawer",
      "default": true
    },
    {
      "type": "text",
      "id": "cross_sell_heading",
      "label": "Cross-sell heading",
      "default": "You may also like"
    },
    {
      "type": "select",
      "id": "cross_sell_source",
      "label": "Cross-sell source",
      "default": "collection",
      "options": [
        { "value": "collection", "label": "Collection" },
        { "value": "recommendations", "label": "Shopify recommendations" }
      ]
    },
    {
      "type": "collection",
      "id": "cross_sell_collection",
      "label": "Cross-sell collection",
      "info": "Products to show when cross-sell source is Collection."
    },
    {
      "type": "number",
      "id": "cross_sell_count",
      "label": "Number of cross-sell products",
      "default": 2
    },
    {
      "type": "header",
      "content": "Gift with purchase"
    },
    {
      "type": "checkbox",
      "id": "show_gwp",
      "label": "Show gift-with-purchase progress",
      "default": false
    },
    {
      "type": "number",
      "id": "gwp_threshold",
      "label": "Threshold ($)",
      "default": 100,
      "info": "Free gift when cart subtotal reaches this amount"
    },
    {
      "type": "text",
      "id": "gwp_title",
      "label": "Gift title",
      "default": "Free gift"
    },
    {
      "type": "text",
      "id": "gwp_message",
      "label": "Progress message",
      "default": "Spend {remaining} more to get your free gift!"
    },
    {
      "type": "text",
      "id": "gwp_achieved_message",
      "label": "Achieved message",
      "default": "🎉 You got your free gift!"
    },
    {
      "type": "image_picker",
      "id": "gwp_image",
      "label": "Gift image"
    },
    {
      "type": "checkbox",
      "id": "show_discount",
      "label": "Show discount code field",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Cart drawer",
      "category": "Cart"
    }
  ]
}
{% endschema %}

{% stylesheet %}
.s-cart-drawer {
  --drawer-width: 380px;
}

/* Backdrop / overlay */
.s-cart-drawer__backdrop {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: var(--t-z-modal);
  opacity: 0;
  pointer-events: none;
  transition: opacity var(--t-transition-base);
}

.s-cart-drawer.is-open .s-cart-drawer__backdrop {
  opacity: 1;
  pointer-events: auto;
}

/* Drawer panel */
.s-cart-drawer__panel {
  position: fixed;
  top: 0;
  right: 0;
  height: 100vh;
  width: min(90vw, var(--drawer-width));
  background: var(--t-bg);
  border-left: 1px solid var(--t-border);
  z-index: calc(var(--t-z-modal) + 1);
  display: flex;
  flex-direction: column;
  transform: translateX(100%);
  transition: transform var(--t-transition-base) var(--t-ease-out);
  will-change: transform;
}

.s-cart-drawer.is-open .s-cart-drawer__panel {
  transform: translateX(0);
}

/* Header */
.s-cart-drawer__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--t-space-4) var(--t-space-5);
  border-bottom: 1px solid var(--t-border);
  flex-shrink: 0;
}

.s-cart-drawer__title {
  font-size: var(--t-font-size-h3);
  font-weight: 700;
  letter-spacing: -0.01em;
  margin: 0;
}

.s-cart-drawer__count {
  font-size: var(--t-font-size-base);
  color: var(--t-text-muted);
  font-weight: 400;
}

.s-cart-drawer__close {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: none;
  border: none;
  color: var(--t-text);
  cursor: pointer;
  padding: 0;
  border-radius: 0;
}

.s-cart-drawer__close:hover {
  color: var(--t-text-muted);
}

.s-cart-drawer__close svg {
  width: 20px;
  height: 20px;
}

/* Items */
.s-cart-drawer__items {
  flex: 1;
  overflow-y: auto;
  padding: var(--t-space-4) var(--t-space-5);
  -webkit-overflow-scrolling: touch;
}

.s-cart-drawer__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  text-align: center;
  gap: var(--t-space-4);
  color: var(--t-text-muted);
}

.s-cart-drawer__item {
  display: grid;
  grid-template-columns: 70px 1fr auto;
  gap: var(--t-space-3);
  padding: var(--t-space-3) 0;
  border-bottom: 1px solid var(--t-border);
}

.s-cart-drawer__item:last-child {
  border-bottom: none;
}

.s-cart-drawer__item-img {
  aspect-ratio: 3 / 4;
  background: var(--t-surface);
  overflow: hidden;
}

.s-cart-drawer__item-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.s-cart-drawer__item-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.s-cart-drawer__item-title {
  font-size: var(--t-font-size-small);
  font-weight: 600;
  margin: 0;
  line-height: 1.3;
}

.s-cart-drawer__item-title a {
  color: var(--t-text);
  text-decoration: none;
}

.s-cart-drawer__item-variant {
  font-size: 12px;
  color: var(--t-text-muted);
}

.s-cart-drawer__item-actions {
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
}

.s-cart-drawer__item-price {
  font-family: var(--t-font-mono);
  font-size: var(--t-font-size-small);
  font-weight: 600;
}

.s-cart-drawer__item-qty {
  display: flex;
  align-items: center;
  gap: 2px;
  margin-top: auto;
}

.s-cart-drawer__item-qty button {
  width: 24px;
  height: 24px;
  border: 1px solid var(--t-border);
  background: var(--t-surface);
  color: var(--t-text);
  font-size: 12px;
  cursor: pointer;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0;
}

.s-cart-drawer__item-qty input {
  width: 32px;
  height: 24px;
  text-align: center;
  border: 1px solid var(--t-border);
  background: var(--t-bg);
  color: var(--t-text);
  font-size: 12px;
  font-family: inherit;
  padding: 0;
  border-radius: 0;
  -moz-appearance: textfield;
}

.s-cart-drawer__item-qty input::-webkit-outer-spin-button,
.s-cart-drawer__item-qty input::-webkit-inner-spin-button {
  -webkit-appearance: none;
  margin: 0;
}

.s-cart-drawer__item-remove {
  font-size: 11px;
  color: var(--t-text-muted);
  background: none;
  border: none;
  cursor: pointer;
  padding: 0;
  text-decoration: underline;
  font-family: inherit;
  margin-top: 4px;
}

/* Footer */
.s-cart-drawer__footer {
  padding: var(--t-space-4) var(--t-space-5);
  border-top: 1px solid var(--t-border);
  display: flex;
  flex-direction: column;
  gap: var(--t-space-3);
  flex-shrink: 0;
}

.s-cart-drawer__subtotal {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.s-cart-drawer__subtotal-label {
  font-size: var(--t-font-size-small);
  color: var(--t-text-muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  font-weight: 600;
}

.s-cart-drawer__subtotal-value {
  font-family: var(--t-font-mono);
  font-size: var(--t-font-size-h3);
  font-weight: 700;
}

.s-cart-drawer__note {
  font-size: 11px;
  color: var(--t-text-muted);
  text-align: center;
}

/* Cross-sell */
.s-cart-drawer__cross-sell {
  padding: var(--t-space-4) var(--t-space-5);
  border-top: 1px solid var(--t-border);
  flex-shrink: 0;
}

.s-cart-drawer__cross-sell-heading {
  font-size: var(--t-font-size-small);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin: 0 0 var(--t-space-3);
}

.s-cart-drawer__cross-sell-grid {
  display: flex;
  flex-direction: column;
  gap: var(--t-space-3);
}

.s-cart-drawer__cross-sell-item {
  display: flex;
  gap: var(--t-space-3);
  align-items: flex-start;
}

.s-cart-drawer__cross-sell-img {
  width: 60px;
  height: 60px;
  flex-shrink: 0;
  display: block;
  overflow: hidden;
  background: var(--t-surface);
}

.s-cart-drawer__cross-sell-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.s-cart-drawer__cross-sell-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4px;
  min-width: 0;
}

.s-cart-drawer__cross-sell-title {
  font-size: var(--t-font-size-small);
  color: var(--t-text);
  text-decoration: none;
  font-weight: 500;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.s-cart-drawer__cross-sell-title:hover {
  text-decoration: underline;
}

.s-cart-drawer__cross-sell-price {
  font-family: var(--t-font-mono);
  font-size: var(--t-font-size-small);
  font-weight: 600;
}

.s-cart-drawer__cross-sell-add {
  padding: 6px 12px;
  border: 1px solid var(--t-text);
  background: var(--t-text);
  color: var(--t-bg);
  font-size: var(--t-font-size-meta);
  font-family: inherit;
  cursor: pointer;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  font-weight: 600;
  align-self: flex-start;
  margin-top: 2px;
  transition: opacity var(--t-transition-fast);
}

.s-cart-drawer__cross-sell-add:hover {
  opacity: 0.85;
}

/* Gift with purchase */
.s-cart-drawer__gwp {
  display: flex;
  align-items: center;
  gap: var(--t-space-3);
  padding: var(--t-space-3);
  background: var(--t-surface);
  border: 1px solid var(--t-border);
  margin-bottom: var(--t-space-3);
}

.s-cart-drawer__gwp-image {
  width: 48px;
  height: 48px;
  flex-shrink: 0;
  background: var(--t-bg);
  overflow: hidden;
}

.s-cart-drawer__gwp-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.s-cart-drawer__gwp-content {
  flex: 1;
  min-width: 0;
}

.s-cart-drawer__gwp-title {
  font-size: var(--t-font-size-meta);
  font-weight: 600;
  margin: 0 0 6px;
  text-transform: uppercase;
  letter-spacing: 0.02em;
  color: var(--t-text);
}

.s-cart-drawer__gwp-bar {
  height: 4px;
  background: var(--t-border);
  overflow: hidden;
}

.s-cart-drawer__gwp-bar-fill {
  height: 100%;
  background: var(--t-accent);
  transition: width 0.5s var(--t-ease-out);
}

/* Discount code */
.s-cart-drawer__discount {
  margin: var(--t-space-3) 0;
}

.s-cart-drawer__discount-form {
  display: flex;
  gap: var(--t-space-2);
}

.s-cart-drawer__discount-input {
  flex: 1;
  padding: 8px 10px;
  border: 1px solid var(--t-border);
  background: var(--t-bg);
  color: var(--t-text);
  font-family: inherit;
  font-size: var(--t-font-size-small);
  min-width: 0;
}

.s-cart-drawer__discount-input:focus {
  outline: none;
  border-color: var(--t-text);
}
{% endstylesheet %}

<div
  id="section-{{ section.id }}"
  class="s-cart-drawer"
  data-section-id="{{ section.id }}"
  data-section-type="cart-drawer"
  data-open-on-add="{% if section.settings.open_on_add %}true{% else %}false{% endif %}"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-labelledby="cart-drawer-title-{{ section.id }}"
>
  <div class="s-cart-drawer__backdrop" data-drawer-close></div>

  <div class="s-cart-drawer__panel">
    <div class="s-cart-drawer__header">
      <h2 class="s-cart-drawer__title" id="cart-drawer-title-{{ section.id }}">
        {{ 'cart.general.cart' | t | default: 'Cart' }}
        <span class="s-cart-drawer__count" data-cart-count>{{ cart.item_count }}</span>
      </h2>
      <button class="s-cart-drawer__close" data-drawer-close aria-label="Close cart">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="s-cart-drawer__items" data-cart-items>
      {% if cart.item_count > 0 %}
        {% for item in cart.items %}
          <div class="s-cart-drawer__item" data-drawer-item data-key="{{ item.key }}">
            <div class="s-cart-drawer__item-img">
              {% if item.image %}
                <img src="{{ item.image | image_url: width: 140 }}" alt="{{ item.image.alt | escape }}" width="70" height="93" loading="lazy">
              {% endif %}
            </div>
            <div class="s-cart-drawer__item-info">
              <h4 class="s-cart-drawer__item-title">
                <a href="{{ item.url }}">{{ item.product.title | escape }}</a>
              </h4>
              {% if item.variant_title and item.variant_title != 'Default Title' %}
                <span class="s-cart-drawer__item-variant">{{ item.variant_title | escape }}</span>
              {% endif %}
              <div class="s-cart-drawer__item-qty">
                <button type="button" data-qty-decrease aria-label="Decrease">−</button>
                <input type="number" value="{{ item.quantity }}" min="1" data-item-qty aria-label="Quantity">
                <button type="button" data-qty-increase aria-label="Increase">+</button>
              </div>
              <button type="button" class="s-cart-drawer__item-remove" data-item-remove>
                {{ 'cart.general.remove' | t | default: 'Remove' }}
              </button>
            </div>
            <div class="s-cart-drawer__item-actions">
              <span class="s-cart-drawer__item-price" data-item-line-total>{{ item.final_line_price | money }}</span>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <div class="s-cart-drawer__empty">
          <p>{{ 'cart.general.empty' | t | default: 'Your cart is empty' }}</p>
          <a href="/collections/all" class="c-btn c-btn--primary c-btn--sm" data-drawer-close>
            {{ 'cart.general.continue_shopping' | t | default: 'Start shopping' }}
          </a>
        </div>
      {% endif %}
    </div>

    {% comment %} Cross-sell products {% endcomment %}
    {% if section.settings.show_cross_sell and cart.item_count > 0 %}
      {% liquid
        assign _xsell_products = ''
        if section.settings.cross_sell_source == 'collection' and section.settings.cross_sell_collection
          assign _xsell = collections[section.settings.cross_sell_collection]
          assign _xsell_products = _xsell.products
          if _xsell_products == nil or _xsell_products.size == 0
            assign _xsell_products = collections.frontpage.products
          endif
        else
          assign _xsell_products = collections.frontpage.products
        endif
      %}

      {% if _xsell_products and _xsell_products.size > 0 %}
        <div class="s-cart-drawer__cross-sell" data-cross-sell>
          <h3 class="s-cart-drawer__cross-sell-heading">
            {{ section.settings.cross_sell_heading | escape }}
          </h3>
          <div class="s-cart-drawer__cross-sell-grid">
            {% for product in _xsell_products limit: section.settings.cross_sell_count %}
              {% if product.available and product.id != cart.items[0].product.id %}
                <div class="s-cart-drawer__cross-sell-item">
                  <a href="{{ product.url }}" class="s-cart-drawer__cross-sell-img">
                    {% render 'component-image',
                      product: product,
                      size: 150,
                      aspect: '1:1',
                      loading: 'lazy'
                    %}
                  </a>
                  <div class="s-cart-drawer__cross-sell-info">
                    <a href="{{ product.url }}" class="s-cart-drawer__cross-sell-title">
                      {{ product.title | escape }}
                    </a>
                    <div class="s-cart-drawer__cross-sell-price">
                      {% render 'component-product-price', product: product, size: 'sm' %}
                    </div>
                    <button
                      type="button"
                      class="s-cart-drawer__cross-sell-add"
                      data-quick-add
                      data-product-id="{{ product.id }}"
                      data-variant-id="{{ product.first_available_variant.id }}"
                    >
                      {{ 'cart.general.add' | t | default: 'Add' }}
                    </button>
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endif %}
    {% endif %}

    {% if cart.item_count > 0 %}
      <div class="s-cart-drawer__footer">
        {% comment %} Free shipping progress {% endcomment %}
        {% render 'component-shipping-progress', threshold: 7500 %}

        {% comment %} Gift with purchase {% endcomment %}
        {% if section.settings.show_gwp %}
          {% assign _gwp_threshold = section.settings.gwp_threshold | times: 100 %}
          {% assign _gwp_total = cart.total_price %}
          {% assign _gwp_pct = 0 %}
          {% if _gwp_threshold > 0 %}
            {% assign _gwp_pct = _gwp_total | divided_by: _gwp_threshold | times: 100 %}
            {% if _gwp_pct > 100 %}{% assign _gwp_pct = 100 %}{% endif %}
          {% endif %}
          {% assign _gwp_achieved = _gwp_total >= _gwp_threshold %}
          {% assign _gwp_remaining = _gwp_threshold | minus: _gwp_total %}

          <div class="s-cart-drawer__gwp" data-gwp data-threshold="{{ _gwp_threshold }}">
            {% if section.settings.gwp_image %}
              <div class="s-cart-drawer__gwp-image">
                <img src="{{ section.settings.gwp_image | img_url: '100x' }}" alt="{{ section.settings.gwp_title | escape }}" loading="lazy">
              </div>
            {% endif %}
            <div class="s-cart-drawer__gwp-content">
              <p class="s-cart-drawer__gwp-title">
                {% if _gwp_achieved %}
                  {{ section.settings.gwp_achieved_message | escape }}
                {% else %}
                  {{ section.settings.gwp_message | replace: '{remaining}', _gwp_remaining | money }}
                {% endif %}
              </p>
              <div class="s-cart-drawer__gwp-bar">
                <div class="s-cart-drawer__gwp-bar-fill" style="width: {{ _gwp_pct }}%;" data-gwp-fill></div>
              </div>
            </div>
          </div>
        {% endif %}

        <div class="s-cart-drawer__subtotal">
          <span class="s-cart-drawer__subtotal-label">
            {{ 'cart.general.subtotal' | t | default: 'Subtotal' }}
          </span>
          <span class="s-cart-drawer__subtotal-value" data-cart-subtotal>
            {{ cart.total_price | money }}
          </span>
        </div>

        {% comment %} Discount code {% endcomment %}
        {% if section.settings.show_discount and cart.item_count > 0 %}
          <div class="s-cart-drawer__discount" data-discount-code>
            <form class="s-cart-drawer__discount-form" method="post" action="/cart/update">
              <input type="hidden" name="discount" value="">
              <input
                type="text"
                class="s-cart-drawer__discount-input"
                name="discount_code"
                placeholder="{{ 'cart.general.discount_placeholder' | t | default: 'Discount code' }}"
              >
              <button type="submit" class="c-btn c-btn--secondary c-btn--sm">
                {{ 'cart.general.apply' | t | default: 'Apply' }}
              </button>
            </form>
          </div>
        {% endif %}

        {% comment %} App block: cart drawer above checkout {% endcomment %}
        <div class="s-cart-drawer__app-block">
          {% @themeapp 'cart_drawer_above_checkout' %}
        </div>

        <button type="button" class="c-btn c-btn--primary c-btn--full" onclick="window.location.href='/checkout'">
          {{ 'cart.general.checkout' | t | default: 'Checkout' }}
        </button>
        <a href="/cart" class="c-btn c-btn--ghost c-btn--full c-btn--sm" data-drawer-close>
          {{ 'cart.general.view_cart' | t | default: 'View cart' }}
        </a>
        <p class="s-cart-drawer__note">
          {{ 'cart.general.taxes_at_checkout' | t | default: 'Taxes and shipping calculated at checkout.' }}
        </p>
      </div>
    {% endif %}
  </div>
</div>

{% javascript %}
class CartDrawer extends HTMLElement {
  constructor() {
    super();
    this._isOpen = false;
    this._openOnAdd = this.dataset.openOnAdd === 'true';
    this._cart = null;
    this._unsubs = [];
  }

  connectedCallback() {
    this.cacheDOM();
    this.bindEvents();
    this.subscribeToPubSub();

    // Refresh cart state on load
    this.refreshCart();
  }

  disconnectedCallback() {
    this._unsubs.forEach((fn) => fn());
    this._unsubs = [];
  }

  cacheDOM() {
    this.closeBtns = this.querySelectorAll('[data-drawer-close]');
    this.itemsContainer = this.querySelector('[data-cart-items]');
    this.countEl = this.querySelector('[data-cart-count]');
    this.subtotalEl = this.querySelector('[data-cart-subtotal]');
  }

  subscribeToPubSub() {
    if (!window.__theme?.PubSub) return;

    // Open/close events
    this._unsubs.push(window.__theme.PubSub.subscribe('cart:add', () => {
      if (this._openOnAdd) this.open();
    }));
    this._unsubs.push(window.__theme.PubSub.subscribe('cart:add-success', () => {
      this.refreshCart();
      if (this._openOnAdd) this.open();
    }));
    this._unsubs.push(window.__theme.PubSub.subscribe('cart:toggle', () => this.toggle()));
    this._unsubs.push(window.__theme.PubSub.subscribe('cart:open', () => this.open()));
    this._unsubs.push(window.__theme.PubSub.subscribe('cart:updated', (cart) => {
      this._cart = cart;
      this._renderCounts(cart);
    }));
    this._unsubs.push(window.__theme.PubSub.subscribe('cart:item-removed', () => {
      this.refreshCart();
    }));
  }

  bindEvents() {
    this.closeBtns.forEach((btn) => {
      btn.addEventListener('click', () => this.close());
    });

    // Close on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && this._isOpen) this.close();
    });

    // Delegate item actions (quantity change, remove)
    this.itemsContainer?.addEventListener('click', async (e) => {
      const item = e.target.closest('[data-drawer-item]');
      if (!item) return;

      const key = item.dataset.key;
      if (!key) return;

      // Quantity decrease
      if (e.target.matches('[data-qty-decrease]')) {
        const input = item.querySelector('[data-item-qty]');
        if (input) {
          const current = parseInt(input.value, 10) || 1;
          if (current > 1) {
            this._updateQuantity(key, current - 1, item);
          } else {
            this._removeItem(key, item);
          }
        }
      }

      // Quantity increase
      if (e.target.matches('[data-qty-increase]')) {
        const input = item.querySelector('[data-item-qty]');
        if (input) {
          const current = parseInt(input.value, 10) || 1;
          this._updateQuantity(key, current + 1, item);
        }
      }

      // Remove
      if (e.target.matches('[data-item-remove]')) {
        this._removeItem(key, item);
      }
    });

    // Quantity input change
    this.itemsContainer?.addEventListener('change', async (e) => {
      if (!e.target.matches('[data-item-qty]')) return;
      const item = e.target.closest('[data-drawer-item]');
      if (!item) return;
      const key = item.dataset.key;
      const val = parseInt(e.target.value, 10);
      if (val >= 1 && key) {
        this._updateQuantity(key, val, item);
      }
    });
  }

  async refreshCart() {
    if (!window.__theme?.CartAPI) return;
    try {
      const cart = await window.__theme.CartAPI.getCart();
      this._cart = cart;
      this._renderCounts(cart);
    } catch (e) {
      console.warn('[CartDrawer] Failed to refresh cart:', e);
    }
  }

  async _updateQuantity(key, quantity, itemEl) {
    if (!window.__theme?.CartAPI) return;
    if (!key) return;

    try {
      const cart = await window.__theme.CartAPI.updateItem(key, quantity);
      this._cart = cart;
      this._renderCounts(cart);

      // Update line total
      const lineTotalEl = itemEl?.querySelector('[data-item-line-total]');
      if (lineTotalEl && cart.items) {
        const updatedItem = cart.items.find((i) => i.key === key);
        if (updatedItem && window.__theme?.formatMoney) {
          lineTotalEl.textContent = window.__theme.formatMoney(updatedItem.final_line_price);
        }
      }

      // Update cart badge in header
      this.publish('cart:count-updated', { count: cart.item_count });
    } catch (e) {
      console.warn('[CartDrawer] Failed to update quantity:', e);
    }
  }

  async _removeItem(key, itemEl) {
    if (!window.__theme?.CartAPI) return;
    if (!key) return;

    // Visual feedback: fade out
    if (itemEl) {
      itemEl.style.opacity = '0.5';
    }

    try {
      const cart = await window.__theme.CartAPI.removeItem(key);
      this._cart = cart;
      this._renderCounts(cart);

      // If cart is empty, show empty state
      if (cart.item_count === 0) {
        this._renderEmpty();
      } else if (itemEl) {
        itemEl.remove();
      }

      this.publish('cart:count-updated', { count: cart.item_count });
    } catch (e) {
      console.warn('[CartDrawer] Failed to remove item:', e);
      if (itemEl) itemEl.style.opacity = '';
    }
  }

  _renderCounts(cart) {
    if (this.countEl) {
      this.countEl.textContent = cart.item_count || 0;
    }
    if (this.subtotalEl && window.__theme?.formatMoney) {
      this.subtotalEl.textContent = window.__theme.formatMoney(cart.total_price || 0);
    }

    // Update header cart badge
    const headerBadges = document.querySelectorAll('.s-header__cart-count, [data-cart-badge]');
    headerBadges.forEach((el) => {
      el.textContent = cart.item_count || 0;
      el.style.display = cart.item_count > 0 ? '' : 'none';
    });
  }

  _renderEmpty() {
    if (!this.itemsContainer) return;
    this.itemsContainer.innerHTML = `
      <div class="s-cart-drawer__empty">
        <p>Your cart is empty</p>
        <a href="/collections/all" class="c-btn c-btn--primary c-btn--sm">Start shopping</a>
      </div>
    `;
  }

  open() {
    this._isOpen = true;
    this.classList.add('is-open');
    this.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  close() {
    this._isOpen = false;
    this.classList.remove('is-open');
    this.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  toggle() {
    this._isOpen ? this.close() : this.open();
  }

  publish(event, data) {
    window.__theme?.PubSub?.publish(event, data);
  }
}

if (!customElements.get('cart-drawer')) {
  customElements.define('cart-drawer', CartDrawer);
}
