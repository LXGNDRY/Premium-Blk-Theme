{% schema %}
{
  "name": "Blog",
  "tag": "section",
  "class": "s-main-blog",
  "enabled_on": {
    "templates": ["blog"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout style",
      "default": "grid",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "list", "label": "List" },
        { "value": "editorial", "label": "Editorial (featured first)" }
      ]
    },
    {
      "type": "range",
      "id": "posts_per_row",
      "label": "Posts per row",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "posts_per_page",
      "label": "Posts per page",
      "min": 6,
      "max": 24,
      "step": 2,
      "default": 12
    },
    {
      "type": "header",
      "content": "Post card"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show featured image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Blog",
      "category": "Blog"
    }
  ]
}
{% endschema %}

{% stylesheet %}
.s-main-blog {
  padding: var(--t-space-10) 0 var(--t-space-12);
}

.s-main-blog__header {
  margin-bottom: var(--t-space-8);
  text-align: center;
}

.s-main-blog__title {
  font-size: var(--t-font-size-h1);
  font-weight: 700;
  letter-spacing: -0.02em;
  margin: 0 0 var(--t-space-3);
}

.s-main-blog__description {
  color: var(--t-text-muted);
  max-width: 600px;
  margin: 0 auto;
}

.s-main-blog__grid {
  display: grid;
  gap: var(--t-space-8);
}

.s-main-blog__grid--cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.s-main-blog__grid--cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.s-main-blog__grid--cols-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }

@media (max-width: 1023px) {
  .s-main-blog__grid--cols-4 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}

@media (max-width: 767px) {
  .s-main-blog__grid { grid-template-columns: 1fr; gap: var(--t-space-6); }
  .s-main-blog__grid--cols-3, .s-main-blog__grid--cols-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}

@media (max-width: 479px) {
  .s-main-blog__grid--cols-3, .s-main-blog__grid--cols-4 { grid-template-columns: 1fr; }
}

/* List layout */
.s-main-blog--list .s-main-blog__grid {
  grid-template-columns: 1fr;
  gap: var(--t-space-6);
}

/* Editorial: first post featured */
.s-main-blog--editorial .s-main-blog__featured {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--t-space-8);
  align-items: center;
  margin-bottom: var(--t-space-10);
  padding-bottom: var(--t-space-10);
  border-bottom: 1px solid var(--t-border);
}

@media (max-width: 767px) {
  .s-main-blog--editorial .s-main-blog__featured {
    grid-template-columns: 1fr;
    gap: var(--t-space-6);
  }
}

.s-main-blog__featured-image {
  aspect-ratio: 16 / 10;
  overflow: hidden;
  background: var(--t-surface);
}

.s-main-blog__featured-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.s-main-blog__featured-content {
  display: flex;
  flex-direction: column;
  gap: var(--t-space-4);
}

.s-main-blog__featured-title {
  font-size: clamp(1.75rem, 3vw, 2.5rem);
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.02em;
  margin: 0;
}

.s-main-blog__featured-title a {
  color: var(--t-text);
  text-decoration: none;
}

.s-main-blog__featured-title a:hover {
  text-decoration: underline;
}

/* Post card */
.s-blog-card {
  display: flex;
  flex-direction: column;
  gap: var(--t-space-3);
}

.s-blog-card__image {
  aspect-ratio: 16 / 10;
  overflow: hidden;
  background: var(--t-surface);
}

.s-blog-card__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform var(--t-transition-base);
}

.s-blog-card:hover .s-blog-card__image img {
  transform: scale(1.03);
}

.s-blog-card__meta {
  font-size: var(--t-font-size-meta);
  color: var(--t-text-muted);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-weight: 600;
}

.s-blog-card__title {
  font-size: 1.25rem;
  font-weight: 700;
  line-height: 1.3;
  margin: 0;
}

.s-blog-card__title a {
  color: var(--t-text);
  text-decoration: none;
}

.s-blog-card__title a:hover {
  text-decoration: underline;
}

.s-blog-card__excerpt {
  color: var(--t-text-muted);
  font-size: var(--t-font-size-small);
  line-height: 1.6;
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* Pagination */
.s-main-blog__pagination {
  margin-top: var(--t-space-10);
  display: flex;
  justify-content: center;
}
{% endstylesheet %}

{%- liquid
  assign _layout = section.settings.layout
  assign _cols = section.settings.posts_per_row
  assign _per_page = section.settings.posts_per_page
  assign _show_image = section.settings.show_image
  assign _show_author = section.settings.show_author
  assign _show_date = section.settings.show_date
  assign _show_excerpt = section.settings.show_excerpt

  assign _section_class = 's-main-blog'
  assign _section_class = _section_class | append: ' s-main-blog--' | append: _layout

  assign _grid_class = 's-main-blog__grid'
  assign _grid_class = _grid_class | append: ' s-main-blog__grid--cols-' | append: _cols
-%}

<section
  id="section-{{ section.id }}"
  class="{{ _section_class }}"
  data-section-id="{{ section.id }}"
  data-section-type="main-blog"
>
  <div class="c-container">
    {% if blog.title %}
      <div class="s-main-blog__header">
        <h1 class="s-main-blog__title">{{ blog.title | escape }}</h1>
        {% if blog.description != blank %}
          <p class="s-main-blog__description">{{ blog.description }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% paginate blog.articles by _per_page %}
      {% assign _articles = blog.articles %}

      {% comment %} Editorial: first post featured {% endcomment %}
      {% if _layout == 'editorial' and _articles.size > 0 %}
        {% assign _featured = _articles.first %}
        <div class="s-main-blog__featured">
          {% if _show_image and _featured.image %}
            <a href="{{ _featured.url }}" class="s-main-blog__featured-image">
              <img
                src="{{ _featured.image | image_url: width: 1200 }}"
                srcset="
                  {{ _featured.image | image_url: width: 600 }} 600w,
                  {{ _featured.image | image_url: width: 1200 }} 1200w
                "
                sizes="(max-width: 767px) 100vw, 50vw"
                alt="{{ _featured.image.alt | escape }}"
                width="1200"
                height="750"
                loading="eager"
              >
            </a>
          {% endif %}
          <div class="s-main-blog__featured-content">
            <div class="s-blog-card__meta">
              {% if _show_date %}{{ _featured.published_at | date: "%B %d, %Y" }}{% endif %}
              {% if _show_author and _featured.author %} · {{ _featured.author }}{% endif %}
            </div>
            <h2 class="s-main-blog__featured-title">
              <a href="{{ _featured.url }}">{{ _featured.title | escape }}</a>
            </h2>
            {% if _show_excerpt %}
              <p class="s-blog-card__excerpt">{{ _featured.excerpt }}</p>
            {% endif %}
            <div>
              <a href="{{ _featured.url }}" class="c-btn c-btn--primary c-btn--sm">
                {{ 'blog.general.read_more' | t | default: 'Read article' }}
              </a>
            </div>
          </div>
        </div>
        {% assign _articles = _articles | offset: 1 %}
      {% endif %}

      <div class="{{ _grid_class }}">
        {% for article in _articles %}
          <article class="s-blog-card">
            {% if _show_image and article.image %}
              <a href="{{ article.url }}" class="s-blog-card__image">
                <img
                  src="{{ article.image | image_url: width: 600 }}"
                  srcset="
                    {{ article.image | image_url: width: 400 }} 400w,
                    {{ article.image | image_url: width: 600 }} 600w,
                    {{ article.image | image_url: width: 900 }} 900w
                  "
                  sizes="(max-width: 767px) 100vw, 33vw"
                  alt="{{ article.image.alt | escape }}"
                  width="600"
                  height="375"
                  loading="lazy"
                >
              </a>
            {% endif %}
            <div class="s-blog-card__meta">
              {% if _show_date %}{{ article.published_at | date: "%b %d, %Y" }}{% endif %}
              {% if _show_author and article.author %} · {{ article.author }}{% endif %}
            </div>
            <h3 class="s-blog-card__title">
              <a href="{{ article.url }}">{{ article.title | escape }}</a>
            </h3>
            {% if _show_excerpt %}
              <p class="s-blog-card__excerpt">{{ article.excerpt }}</p>
            {% endif %}
          </article>
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        <div class="s-main-blog__pagination">
          <nav class="c-pagination" aria-label="Blog pagination">
            {% if paginate.previous %}
              <a href="{{ paginate.previous.url }}" class="c-pagination__item">
                &larr; {{ 'general.pagination.previous' | t | default: 'Previous' }}
              </a>
            {% endif %}
            <span class="c-pagination__item is-active">{{ paginate.current_page }} / {{ paginate.pages }}</span>
            {% if paginate.next %}
              <a href="{{ paginate.next.url }}" class="c-pagination__item">
                {{ 'general.pagination.next' | t | default: 'Next' }} &rarr;
              </a>
            {% endif %}
          </nav>
        </div>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

{% javascript %}
class MainBlogSection extends HTMLElement {
  constructor() { super(); }
  connectedCallback() { this.init(); }
  init() {}
  onBlockSelect() {}
  onBlockDeselect() {}
}

if (!customElements.get('main-blog-section')) {
  customElements.define('main-blog-section', MainBlogSection);
}
{% endjavascript %}
