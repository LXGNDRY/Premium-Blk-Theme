{% schema %}
{
  "name": "Collections list",
  "tag": "section",
  "class": "s-collections-list",
  "enabled_on": {
    "templates": ["list-collections"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "collections_per_row",
      "label": "Collections per row",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image aspect ratio",
      "default": "3/4",
      "options": [
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "3/4", "label": "Portrait (3:4)" },
        { "value": "4/3", "label": "Landscape (4:3)" }
      ]
    },
    {
      "type": "select",
      "id": "style",
      "label": "Card style",
      "default": "overlay",
      "options": [
        { "value": "overlay", "label": "Text overlay" },
        { "value": "below", "label": "Text below" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collections list",
      "category": "Collection"
    }
  ]
}
{% endschema %}

{% stylesheet %}
.s-collections-list {
  padding: var(--t-space-8) 0 var(--t-space-12);
}

.s-collections-list__header {
  margin-bottom: var(--t-space-8);
}

.s-collections-list__title {
  font-size: var(--t-font-size-h1);
  font-weight: 700;
  letter-spacing: -0.02em;
  margin: 0;
}

.s-collections-list__grid {
  display: grid;
  gap: var(--t-space-6);
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

@media (min-width: 768px) {
  .s-collections-list__grid--cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .s-collections-list__grid--cols-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
}

@media (max-width: 639px) {
  .s-collections-list__grid {
    grid-template-columns: 1fr;
  }
}

.s-collection-card {
  position: relative;
  display: block;
  text-decoration: none;
  color: var(--t-text);
  overflow: hidden;
}

.s-collection-card__image {
  position: relative;
  overflow: hidden;
  background: var(--t-surface);
}

.s-collection-card__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform var(--t-transition-base);
}

.s-collection-card:hover .s-collection-card__image img {
  transform: scale(1.05);
}

/* Overlay style */
.s-collection-card--overlay .s-collection-card__info {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: var(--t-space-5);
  background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 60%);
  color: #fff;
}

.s-collection-card--overlay .s-collection-card__title {
  color: #fff;
  margin: 0;
}

/* Below style */
.s-collection-card--below .s-collection-card__info {
  padding: var(--t-space-4) 0 0;
}

.s-collection-card__title {
  font-size: 1.25rem;
  font-weight: 700;
  margin: 0 0 var(--t-space-1);
}

.s-collection-card__count {
  font-size: var(--t-font-size-meta);
  color: inherit;
  opacity: 0.8;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-weight: 600;
}

.s-collection-card--below .s-collection-card__count {
  color: var(--t-text-muted);
  opacity: 1;
}
{% endstylesheet %}

{%- liquid
  assign _cols = section.settings.collections_per_row
  assign _ratio = section.settings.image_ratio
  assign _style = section.settings.style

  assign _grid_class = 's-collections-list__grid'
  assign _grid_class = _grid_class | append: ' s-collections-list__grid--cols-' | append: _cols
-%}

<section
  id="section-{{ section.id }}"
  class="s-collections-list"
  data-section-id="{{ section.id }}"
  data-section-type="list-collections"
>
  <div class="c-container">
    <div class="s-collections-list__header">
      <h1 class="s-collections-list__title">{{ page.title | escape }}</h1>
    </div>

    <div class="{{ _grid_class }}">
      {% for collection in collections %}
        {% if collection.title != 'Homepage' %}
          <a href="{{ collection.url }}" class="s-collection-card s-collection-card--{{ _style }}">
            <div class="s-collection-card__image" style="aspect-ratio: {{ _ratio }};">
              {% if collection.image %}
                <img
                  src="{{ collection.image | image_url: width: 600 }}"
                  srcset="
                    {{ collection.image | image_url: width: 400 }} 400w,
                    {{ collection.image | image_url: width: 600 }} 600w,
                    {{ collection.image | image_url: width: 900 }} 900w
                  "
                  sizes="(max-width: 767px) 100vw, 33vw"
                  alt="{{ collection.image.alt | escape }}"
                  width="600"
                  height="800"
                  loading="lazy"
                >
              {% endif %}
            </div>
            <div class="s-collection-card__info">
              <h3 class="s-collection-card__title">{{ collection.title | escape }}</h3>
              <span class="s-collection-card__count">
                {{ collection.all_products_count }} {{ 'collections.general.items' | t | default: 'products' }}
              </span>
            </div>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% javascript %}
class CollectionsListSection extends HTMLElement {
  constructor() { super(); }
  connectedCallback() { this.init(); }
  init() {}
  onBlockSelect() {}
  onBlockDeselect() {}
}

if (!customElements.get('collections-list-section')) {
  customElements.define('collections-list-section', CollectionsListSection);
}
{% endjavascript %}
