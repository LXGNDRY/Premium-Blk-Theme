{% schema %}
{
  "name": "Multicolumn",
  "tag": "section",
  "class": "s-multicolumn",
  "enabled_on": {
    "groups": ["*"]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": ""
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Section subheading",
      "default": ""
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },
    {
      "type": "select",
      "id": "align",
      "label": "Text alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "checkbox",
      "id": "inverted",
      "label": "Inverted (dark background)",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Feature heading" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Feature description text.</p>" },
        { "type": "image_picker", "id": "icon", "label": "Icon / image" },
        { "type": "text", "id": "button_text", "label": "Button text", "default": "" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Multicolumn",
      "category": "Text",
      "blocks": [
        { "type": "column", "settings": { "heading": "Column 1" } },
        { "type": "column", "settings": { "heading": "Column 2" } },
        { "type": "column", "settings": { "heading": "Column 3" } }
      ]
    }
  ]
}
{% endschema %}

{% stylesheet %}
.s-multicolumn {
  padding: var(--t-space-10) 0;
}

@media (min-width: 768px) {
  .s-multicolumn {
    padding: var(--t-space-12) 0;
  }
}

.s-multicolumn--inverted {
  background: var(--t-text);
  color: var(--t-bg);
}

.s-multicolumn--inverted .s-multicolumn__heading,
.s-multicolumn--inverted .s-multicolumn__col-heading {
  color: var(--t-bg);
}

.s-multicolumn--inverted .s-multicolumn__subheading,
.s-multicolumn--inverted .s-multicolumn__col-text {
  color: rgba(255,255,255,0.7);
}

.s-multicolumn__header {
  text-align: center;
  max-width: 600px;
  margin: 0 auto var(--t-space-8);
}

.s-multicolumn__heading {
  font-size: var(--t-font-size-h2);
  font-weight: 700;
  letter-spacing: -0.02em;
  margin: 0 0 var(--t-space-3);
}

.s-multicolumn__subheading {
  color: var(--t-text-muted);
  margin: 0;
  font-size: var(--t-font-size-base);
  line-height: 1.6;
}

.s-multicolumn__grid {
  display: grid;
  gap: var(--t-space-6);
}

.s-multicolumn--cols-2 .s-multicolumn__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.s-multicolumn--cols-3 .s-multicolumn__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.s-multicolumn--cols-4 .s-multicolumn__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
.s-multicolumn--cols-5 .s-multicolumn__grid { grid-template-columns: repeat(5, minmax(0, 1fr)); }
.s-multicolumn--cols-6 .s-multicolumn__grid { grid-template-columns: repeat(6, minmax(0, 1fr)); }

@media (max-width: 1023px) {
  .s-multicolumn--cols-6 .s-multicolumn__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .s-multicolumn--cols-5 .s-multicolumn__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}

@media (max-width: 767px) {
  .s-multicolumn--mobile-1 .s-multicolumn__grid { grid-template-columns: 1fr; }
  .s-multicolumn--mobile-2 .s-multicolumn__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .s-multicolumn--mobile-3 .s-multicolumn__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}

.s-multicolumn--align-left .s-multicolumn__col { text-align: left; align-items: flex-start; }
.s-multicolumn--align-center .s-multicolumn__col { text-align: center; align-items: center; }
.s-multicolumn--align-right .s-multicolumn__col { text-align: right; align-items: flex-end; }

.s-multicolumn__col {
  display: flex;
  flex-direction: column;
  gap: var(--t-space-3);
}

.s-multicolumn__col-icon {
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--t-space-1);
}

.s-multicolumn__col-icon img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.s-multicolumn__col-heading {
  font-size: 1.125rem;
  font-weight: 700;
  margin: 0;
  line-height: 1.3;
}

.s-multicolumn__col-text {
  color: var(--t-text-muted);
  font-size: var(--t-font-size-small);
  line-height: 1.6;
  margin: 0;
  flex: 1;
}

.s-multicolumn__col-btn {
  font-size: var(--t-font-size-small);
  font-weight: 600;
  color: inherit;
  text-decoration: underline;
  text-underline-offset: 3px;
}
{% endstylesheet %}

{%- liquid
  assign _heading = section.settings.heading
  assign _subheading = section.settings.subheading
  assign _cols_desk = section.settings.columns_desktop
  assign _cols_mob = section.settings.columns_mobile
  assign _align = section.settings.align
  assign _inverted = section.settings.inverted

  assign _section_class = 's-multicolumn'
  assign _section_class = _section_class | append: ' s-multicolumn--cols-' | append: _cols_desk
  assign _section_class = _section_class | append: ' s-multicolumn--mobile-' | append: _cols_mob
  assign _section_class = _section_class | append: ' s-multicolumn--align-' | append: _align
  if _inverted
    assign _section_class = _section_class | append: ' s-multicolumn--inverted'
  endif
-%}

<section
  id="section-{{ section.id }}"
  class="{{ _section_class }}"
  data-section-id="{{ section.id }}"
  data-section-type="multicolumn"
>
  <div class="c-container">
    {% if _heading != blank %}
      <div class="s-multicolumn__header">
        <h2 class="s-multicolumn__heading">{{ _heading | escape }}</h2>
        {% if _subheading != blank %}
          <p class="s-multicolumn__subheading">{{ _subheading | escape }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="s-multicolumn__grid">
      {% for block in section.blocks %}
        {% if block.type == 'column' %}
          <div class="s-multicolumn__col" data-block-id="{{ block.id }}">
            {% if block.settings.icon %}
              <div class="s-multicolumn__col-icon">
                <img src="{{ block.settings.icon | image_url: width: 96 }}" alt="" width="48" height="48" loading="lazy">
              </div>
            {% endif %}
            <h3 class="s-multicolumn__col-heading">{{ block.settings.heading | escape }}</h3>
            {% if block.settings.text != blank %}
              <div class="s-multicolumn__col-text">{{ block.settings.text }}</div>
            {% endif %}
            {% if block.settings.button_text != blank and block.settings.button_link != blank %}
              <a href="{{ block.settings.button_link }}" class="s-multicolumn__col-btn">
                {{ block.settings.button_text | escape }}
              </a>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% javascript %}
class MulticolumnSection extends HTMLElement {
  constructor() { super(); }
  connectedCallback() { this.init(); }
  init() {}
  onBlockSelect(evt) {
    const block = this.querySelector(`[data-block-id="${evt.detail.blockId}"]`);
    if (block) block.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }
  onBlockDeselect() {}
}

if (!customElements.get('multicolumn-section')) {
  customElements.define('multicolumn-section', MulticolumnSection);
}
{% endjavascript %}
