{% schema %}
{
  "name": "Collage",
  "tag": "section",
  "class": "section-collage",
  "enabled_on": {
    "groups": [
      "*"
    ]
  },
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": ""
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "default": "medium",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "mobile_stacked",
      "label": "Stack on mobile",
      "default": false
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1",
      "options": [
        {
          "value": "background-1",
          "label": "Background 1"
        },
        {
          "value": "background-2",
          "label": "Background 2"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "limit": 5,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "default": ""
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": ""
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": ""
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "default": ""
        },
        {
          "type": "checkbox",
          "id": "circle_shape",
          "label": "Circle shape",
          "default": false
        }
      ]
    },
    {
      "type": "product",
      "name": "Product",
      "limit": 5,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "default": ""
        },
        {
          "type": "checkbox",
          "id": "show_vendor",
          "label": "Show vendor",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "circle_shape",
          "label": "Circle shape",
          "default": false
        }
      ]
    },
    {
      "type": "collection",
      "name": "Collection",
      "limit": 5,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "default": ""
        },
        {
          "type": "checkbox",
          "id": "circle_shape",
          "label": "Circle shape",
          "default": false
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 5,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": ""
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": ""
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": ""
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link",
          "default": ""
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collage",
      "category": "Image"
    }
  ]
}
{% endschema %}

{% stylesheet %}
.section-collage {
  padding: var(--spacing-xl) 0;
  position: relative;
}

.section-collage .section__header {
  text-align: center;
  margin-bottom: var(--spacing-lg);
}

.section-collage .section__heading {
  font-size: calc(var(--font-size-h2) * 1px);
  font-weight: 600;
  margin: 0 0 var(--spacing-md) 0;
  color: var(--color-text);
}

.section-collage .section__subheading {
  color: var(--color-text-subdued);
  max-width: 600px;
  margin: 0 auto;
}

.section-collage .container {
  max-width: calc(var(--container-max-width) * 1px);
  margin: 0 auto;
  padding: 0 calc(var(--content-padding) * 1px);
}
{% endstylesheet %}

<section
  id="section-{{ section.id }}"
  class="section-collage"
  style="
    {% if section.settings.background_color %}
      background-color: {{ section.settings.background_color }};
    {% endif %}
    {% if section.settings.top_padding %}
      padding-top: {{ section.settings.top_padding }}px;
    {% endif %}
    {% if section.settings.bottom_padding %}
      padding-bottom: {{ section.settings.bottom_padding }}px;
    {% endif %}
  "
>
  <div class="container">
    {% if section.settings.heading %}
      <div class="section__header">
        <h2 class="section__heading">{{ section.settings.heading | escape }}</h2>
        {% if section.settings.subheading %}
          <p class="section__subheading">{{ section.settings.subheading | escape }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="blocks blocks--collage">
      {% for block in section.blocks %}
        <div
          class="block block--{{ block.type }}"
          style="
            {% if block.settings.alignment %}text-align: {{ block.settings.alignment }};{% endif %}
          "
        >
          {% case block.type %}

{%- when 'image' -%}
  {% if block.settings.image %}
    <div class="block__image">
      {{
        block.settings.image
        | image_url: width: block.settings.image_width | default: 800
        | image_tag:
          alt: block.settings.image.alt | default: block.settings.heading | default: '',
          class: 'block__image-img',
          widths: '300, 600, 900, 1200'
      }}
    </div>
  {% else %}
    <div class="block__image placeholder">
      {{ 'photo' | placeholder_svg_tag: 'placeholder-svg' }}
    </div>
  {% endif %}

{%- when 'product' -%}
  {% if block.settings.product %}
    {% assign product = block.settings.product %}
    <div class="product-card">
      <div class="product-card__media">
        {{
          product.featured_image
          | image_url: width: 500
          | image_tag:
            alt: product.title,
            class: 'product-card__image',
            widths: '200, 400, 600, 800'
        }}
      </div>
      <div class="product-card__info">
        <h3 class="product-card__title">{{ product.title }}</h3>
        <p class="product-card__price">{{ product.price | money }}</p>
      </div>
    </div>
  {% endif %}
{%- when 'collection' -%}
  <div class="block__content">
    {% if block.settings.content %}
      {{ block.settings.content }}
    {% else %}
      Collection
    {% endif %}
  </div>

{%- when 'text' -%}
  <div class="block__text rte">
    {{ block.settings.text | default: 'Add your text here.' }}
  </div>
          {% endcase %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% javascript %}
class CollageSection extends HTMLElement {
  constructor() {
    super();
  }

  connectedCallback() {
    this.init();
  }

  init() {
    // Section initialization logic
  }

  onBlockSelect(evt) {
    // Block selected in editor
  }

  onBlockDeselect(evt) {
    // Block deselected in editor
  }
}

if (!customElements.get('section-collage')) {
  customElements.define('section-collage', CollageSection);
}
{% endjavascript %}
