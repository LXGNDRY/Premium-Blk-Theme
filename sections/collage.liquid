{% schema %}
{
  "name": "Collage",
  "tag": "section",
  "class": "s-collage",
  "enabled_on": {
    "groups": ["*"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "split",
      "options": [
        { "value": "split", "label": "Split (1 large + 1 small)" },
        { "value": "triple", "label": "Triple (1 large + 2 small)" },
        { "value": "grid", "label": "Grid (equal)" }
      ]
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "default": "stack",
      "options": [
        { "value": "stack", "label": "Stacked" },
        { "value": "grid", "label": "2-up grid" }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between items",
      "min": 4,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image item",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "" },
        { "type": "text", "id": "tagline", "label": "Tagline", "default": "" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "button_text", "label": "Button text", "default": "" },
        {
          "type": "select",
          "id": "text_position",
          "label": "Text position",
          "default": "bottom-left",
          "options": [
            { "value": "center", "label": "Center" },
            { "value": "top-left", "label": "Top left" },
            { "value": "top-right", "label": "Top right" },
            { "value": "bottom-left", "label": "Bottom left" },
            { "value": "bottom-right", "label": "Bottom right" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collage",
      "category": "Image",
      "blocks": [
        { "type": "image", "settings": { "heading": "Shop new" } },
        { "type": "image", "settings": { "heading": "Best sellers" } }
      ]
    }
  ]
}
{% endschema %}

{% stylesheet %}
.s-collage {
  padding: var(--t-space-10) 0;
}

.s-collage__grid {
  display: grid;
  gap: var(--collage-gap, 12px);
}

/* Split layout: 1 large + 1 small (desktop) */
.s-collage--split .s-collage__grid {
  grid-template-columns: 2fr 1fr;
  grid-template-rows: 1fr;
}

.s-collage--split .s-collage__item:first-child {
  min-height: 500px;
}

/* Triple layout: 1 large + 2 small stacked */
.s-collage--triple .s-collage__grid {
  grid-template-columns: 2fr 1fr;
  grid-template-rows: 1fr 1fr;
}

.s-collage--triple .s-collage__item:first-child {
  grid-row: span 2;
  min-height: 500px;
}

/* Grid layout: equal items */
.s-collage--grid .s-collage__grid {
  grid-template-columns: repeat(3, 1fr);
}

.s-collage--grid-2 .s-collage__grid {
  grid-template-columns: repeat(2, 1fr);
}
.s-collage--grid-4 .s-collage__grid {
  grid-template-columns: repeat(4, 1fr);
}

/* Mobile: stacked */
@media (max-width: 767px) {
  .s-collage--mobile-stack .s-collage__grid {
    grid-template-columns: 1fr !important;
  }

  .s-collage--mobile-grid .s-collage__grid {
    grid-template-columns: repeat(2, 1fr) !important;
  }

  .s-collage--split .s-collage__item:first-child,
  .s-collage--triple .s-collage__item:first-child {
    min-height: 300px;
  }
}

/* Collage item */
.s-collage__item {
  position: relative;
  overflow: hidden;
  background: var(--t-surface);
  min-height: 250px;
}

.s-collage__item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  position: absolute;
  inset: 0;
  transition: transform var(--t-transition-base);
}

.s-collage__item:hover img {
  transform: scale(1.05);
}

.s-collage__item-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.5) 0%, transparent 60%);
  z-index: 1;
}

.s-collage__item-content {
  position: absolute;
  z-index: 2;
  padding: var(--t-space-5);
  color: #fff;
  max-width: 80%;
  display: flex;
  flex-direction: column;
  gap: var(--t-space-2);
}

.s-collage__item--center .s-collage__item-content {
  top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center; align-items: center;
}
.s-collage__item--top-left .s-collage__item-content { top: 0; left: 0; }
.s-collage__item--top-right .s-collage__item-content { top: 0; right: 0; text-align: right; align-items: flex-end; }
.s-collage__item--bottom-left .s-collage__item-content { bottom: 0; left: 0; }
.s-collage__item--bottom-right .s-collage__item-content { bottom: 0; right: 0; text-align: right; align-items: flex-end; }

.s-collage__item-heading {
  font-size: 1.5rem;
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -0.01em;
  margin: 0;
  text-transform: uppercase;
}

.s-collage__item:first-child .s-collage__item-heading {
  font-size: clamp(1.5rem, 3vw, 2.5rem);
}

.s-collage__item-tagline {
  font-size: var(--t-font-size-small);
  opacity: 0.9;
  margin: 0;
}

.s-collage__item-btn {
  display: inline-block;
  margin-top: var(--t-space-1);
  font-size: var(--t-font-size-meta);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: #fff;
  text-decoration: none;
  border-bottom: 2px solid #fff;
  padding-bottom: 2px;
}
{% endstylesheet %}

{%- liquid
  assign _layout = section.settings.layout
  assign _mobile_layout = section.settings.mobile_layout
  assign _gap = section.settings.gap

  assign _section_class = 's-collage'
  assign _section_class = _section_class | append: ' s-collage--' | append: _layout
  assign _section_class = _section_class | append: ' s-collage--mobile-' | append: _mobile_layout

  assign _inline_style = '--collage-gap: ' | append: _gap | append: 'px;'
-%}

<section
  id="section-{{ section.id }}"
  class="{{ _section_class }}"
  style="{{ _inline_style }}"
  data-section-id="{{ section.id }}"
  data-section-type="collage"
>
  <div class="c-container">
    <div class="s-collage__grid">
      {% for block in section.blocks %}
        {% if block.type == 'image' %}
          {% assign _pos = block.settings.text_position | default: 'bottom-left' %}
          <a
            href="{{ block.settings.link | default: '#' }}"
            class="s-collage__item s-collage__item--{{ _pos }}"
            data-block-id="{{ block.id }}"
            {% if block.settings.image == blank %}style="min-height: 250px;"{% endif %}
          >
            {% if block.settings.image %}
              <img
                src="{{ block.settings.image | image_url: width: 1000 }}"
                srcset="
                  {{ block.settings.image | image_url: width: 500 }} 500w,
                  {{ block.settings.image | image_url: width: 1000 }} 1000w,
                  {{ block.settings.image | image_url: width: 1500 }} 1500w
                "
                sizes="(max-width: 767px) 100vw, 50vw"
                alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
                loading="lazy"
              >
              <div class="s-collage__item-overlay"></div>
            {% endif %}

            {% if block.settings.heading != blank or block.settings.tagline != blank %}
              <div class="s-collage__item-content">
                {% if block.settings.heading != blank %}
                  <h3 class="s-collage__item-heading">{{ block.settings.heading | escape }}</h3>
                {% endif %}
                {% if block.settings.tagline != blank %}
                  <p class="s-collage__item-tagline">{{ block.settings.tagline | escape }}</p>
                {% endif %}
                {% if block.settings.button_text != blank %}
                  <span class="s-collage__item-btn">{{ block.settings.button_text | escape }} &rarr;</span>
                {% endif %}
              </div>
            {% endif %}
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% javascript %}
class CollageSection extends HTMLElement {
  constructor() { super(); }
  connectedCallback() { this.init(); }
  init() {}
  onBlockSelect(evt) {
    const block = this.querySelector(`[data-block-id="${evt.detail.blockId}"]`);
    if (block) block.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }
  onBlockDeselect() {}
}

if (!customElements.get('collage-section')) {
  customElements.define('collage-section', CollageSection);
}
{% endjavascript %}
