{% schema %}
{
  "name": "Video",
  "tag": "section",
  "class": "s-video",
  "enabled_on": {
    "groups": ["*"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Video URL (YouTube or Vimeo)",
      "default": ""
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Poster image",
      "info": "Shown before the video plays"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": ""
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": ""
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "center",
      "options": [
        { "value": "center", "label": "Centered" },
        { "value": "text-left", "label": "Text left, video right" },
        { "value": "text-right", "label": "Text right, video left" }
      ]
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Video max width",
      "min": 600,
      "max": 1200,
      "step": 40,
      "unit": "px",
      "default": 900
    }
  ],
  "presets": [
    {
      "name": "Video",
      "category": "Media"
    }
  ]
}
{% endschema %}

{% stylesheet %}
.s-video {
  padding: var(--t-space-10) 0;
}

@media (min-width: 768px) {
  .s-video {
    padding: var(--t-space-12) 0;
  }
}

.s-video__inner {
  display: flex;
  flex-direction: column;
  gap: var(--t-space-6);
  align-items: center;
  text-align: center;
}

.s-video--text-left .s-video__inner,
.s-video--text-right .s-video__inner {
  flex-direction: row;
  text-align: left;
  align-items: center;
  gap: var(--t-space-8);
}

.s-video--text-right .s-video__inner {
  flex-direction: row-reverse;
  text-align: right;
}

@media (max-width: 767px) {
  .s-video--text-left .s-video__inner,
  .s-video--text-right .s-video__inner {
    flex-direction: column;
    text-align: center;
  }
}

.s-video__text {
  flex: 0 0 auto;
  max-width: 400px;
  display: flex;
  flex-direction: column;
  gap: var(--t-space-3);
}

.s-video__heading {
  font-size: var(--t-font-size-h2);
  font-weight: 700;
  letter-spacing: -0.02em;
  margin: 0;
}

.s-video__subheading {
  color: var(--t-text-muted);
  margin: 0;
  line-height: 1.6;
}

.s-video__wrap {
  flex: 1;
  width: 100%;
  max-width: 900px;
  margin: 0 auto;
}

.s-video--text-left .s-video__wrap,
.s-video--text-right .s-video__wrap {
  margin: 0;
}

.s-video__player {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 9;
  background: #000;
  overflow: hidden;
}

.s-video__poster {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  cursor: pointer;
  z-index: 2;
  transition: opacity var(--t-transition-base);
}

.s-video__poster:hover .s-video__play {
  transform: translate(-50%, -50%) scale(1.1);
}

.s-video__poster.is-hidden {
  opacity: 0;
  pointer-events: none;
}

.s-video__play {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80px;
  height: 80px;
  background: rgba(255,255,255,0.95);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform var(--t-transition-base);
  border: none;
  cursor: pointer;
  color: #000;
}

.s-video__play svg {
  width: 28px;
  height: 28px;
  margin-left: 4px;
}

.s-video__player iframe {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border: none;
}
{% endstylesheet %}

{%- liquid
  assign _video_url = section.settings.video_url
  assign _poster = section.settings.poster
  assign _heading = section.settings.heading
  assign _subheading = section.settings.subheading
  assign _layout = section.settings.layout
  assign _max_width = section.settings.max_width

  assign _section_class = 's-video'
  assign _section_class = _section_class | append: ' s-video--' | append: _layout
-%}

<section
  id="section-{{ section.id }}"
  class="{{ _section_class }}"
  data-section-id="{{ section.id }}"
  data-section-type="video"
>
  <div class="c-container">
    <div class="s-video__inner">
      {% if _heading != blank or _subheading != blank %}
        <div class="s-video__text">
          {% if _heading != blank %}
            <h2 class="s-video__heading">{{ _heading | escape }}</h2>
          {% endif %}
          {% if _subheading != blank %}
            <p class="s-video__subheading">{{ _subheading | escape }}</p>
          {% endif %}
        </div>
      {% endif %}

      <div class="s-video__wrap" style="max-width: {{ _max_width }}px;">
        {% if _video_url %}
          <div class="s-video__player" data-video-player>
            {% if _poster %}
              <div class="s-video__poster" data-video-poster style="background-image: url('{{ _poster | image_url: width: 1200 }}');">
                <button type="button" class="s-video__play" data-play-btn aria-label="Play video">
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <polygon points="8 5 19 12 8 19 8 5"></polygon>
                  </svg>
                </button>
              </div>
            {% endif %}
            <iframe
              data-video-iframe
              src=""
              data-src="{{ _video_url }}"
              allow="autoplay; encrypted-media; picture-in-picture"
              allowfullscreen
              loading="lazy"
              title="{{ _heading | default: 'Video' | escape }}"
            ></iframe>
          </div>
        {% else %}
          <div class="s-video__player" style="display: flex; align-items: center; justify-content: center; color: #666;">
            <p style="margin: 0; font-size: var(--t-font-size-small);">Add a YouTube or Vimeo URL</p>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% javascript %}
class VideoSection extends HTMLElement {
  constructor() { super(); }

  connectedCallback() {
    const poster = this.querySelector('[data-video-poster]');
    const iframe = this.querySelector('[data-video-iframe]');
    const btn = this.querySelector('[data-play-btn]');

    if (btn && iframe) {
      btn.addEventListener('click', () => {
        const src = iframe.dataset.src;
        if (!src) return;

        // Add autoplay parameter
        let playUrl = src;
        if (src.includes('youtube.com') || src.includes('youtu.be')) {
          playUrl += (src.includes('?') ? '&' : '?') + 'autoplay=1';
        } else if (src.includes('vimeo.com')) {
          playUrl += (src.includes('?') ? '&' : '?') + 'autoplay=1';
        }

        iframe.src = playUrl;
        if (poster) poster.classList.add('is-hidden');
      });
    }
  }

  onBlockSelect() {}
  onBlockDeselect() {}
}

if (!customElements.get('video-section')) {
  customElements.define('video-section', VideoSection);
}
{% endjavascript %}
