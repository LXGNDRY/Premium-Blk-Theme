{% schema %}
{
  "name": "404 page",
  "tag": "section",
  "class": "s-main-404",
  "enabled_on": {
    "templates": ["404"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Page not found"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "The page you're looking for doesn't exist or has been moved."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Back to home"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search bar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_big_number",
      "label": "Show big 404",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "404 page",
      "category": "Page"
    }
  ]
}
{% endschema %}

{% stylesheet %}
.s-main-404 {
  padding: var(--t-space-16) 0;
  text-align: center;
  min-height: 60vh;
  display: flex;
  align-items: center;
}

.s-main-404__inner {
  max-width: 520px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--t-space-5);
}

.s-main-404__number {
  font-size: clamp(6rem, 20vw, 12rem);
  font-weight: 900;
  line-height: 0.85;
  letter-spacing: -0.05em;
  margin: 0;
  color: var(--t-text);
  font-family: var(--t-font-display);
}

.s-main-404__heading {
  font-size: var(--t-font-size-h2);
  font-weight: 700;
  letter-spacing: -0.02em;
  margin: 0;
}

.s-main-404__text {
  color: var(--t-text-muted);
  font-size: var(--t-font-size-base);
  line-height: 1.6;
  margin: 0;
}

.s-main-404__search {
  width: 100%;
  max-width: 400px;
  margin-top: var(--t-space-2);
}

.s-main-404__search input {
  width: 100%;
  height: 48px;
  padding: 0 var(--t-space-4);
  background: var(--t-surface);
  border: 1px solid var(--t-border);
  color: var(--t-text);
  font-size: var(--t-font-size-base);
  font-family: inherit;
  border-radius: 0;
  text-align: center;
}

.s-main-404__search input:focus {
  outline: none;
  border-color: var(--t-border-strong);
}

.s-main-404__actions {
  display: flex;
  gap: var(--t-space-3);
  flex-wrap: wrap;
  justify-content: center;
  margin-top: var(--t-space-2);
}
{% endstylesheet %}

<section
  id="section-{{ section.id }}"
  class="s-main-404"
  data-section-id="{{ section.id }}"
  data-section-type="main-404"
>
  <div class="c-container">
    <div class="s-main-404__inner">
      {% if section.settings.show_big_number %}
        <p class="s-main-404__number" aria-hidden="true">404</p>
      {% endif %}
      <h1 class="s-main-404__heading">{{ section.settings.heading | escape }}</h1>
      <p class="s-main-404__text">{{ section.settings.text | escape }}</p>

      {% if section.settings.show_search %}
        <form class="s-main-404__search" role="search" method="get" action="{{ routes.search_url }}">
          <input
            type="search"
            name="q"
            placeholder="{{ 'general.search.placeholder' | t | default: 'Search...' }}"
            aria-label="Search"
            autofocus
          >
        </form>
      {% endif %}

      <div class="s-main-404__actions">
        <a href="/" class="c-btn c-btn--primary">
          {{ section.settings.button_text | escape }}
        </a>
        <a href="/collections/all" class="c-btn c-btn--ghost">
          {{ 'general.shop_all' | t | default: 'Shop all' }}
        </a>
      </div>
    </div>
  </div>
</section>

{% javascript %}
class Main404Section extends HTMLElement {
  constructor() { super(); }
  connectedCallback() { this.init(); }
  init() {}
  onBlockSelect() {}
  onBlockDeselect() {}
}

if (!customElements.get('main-404-section')) {
  customElements.define('main-404-section', Main404Section);
}
{% endjavascript %}
