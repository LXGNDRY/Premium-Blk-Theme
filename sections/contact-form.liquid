{% schema %}
{
  "name": "Contact form",
  "tag": "section",
  "class": "s-contact-form",
  "enabled_on": {
    "templates": ["page.contact"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show section heading",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get in touch"
    },
    {
      "type": "checkbox",
      "id": "centered",
      "label": "Centered layout",
      "default": true
    },
    {
      "type": "range",
      "id": "form_max_width",
      "label": "Form max width",
      "min": 400,
      "max": 720,
      "step": 20,
      "unit": "px",
      "default": 560
    }
  ],
  "presets": [
    {
      "name": "Contact form",
      "category": "Page"
    }
  ]
}
{% endschema %}

{% stylesheet %}
.s-contact-form {
  padding: var(--t-space-10) 0;
}

.s-contact-form__inner {
  max-width: 560px;
  margin: 0 auto;
}

.s-contact-form--left .s-contact-form__inner {
  margin-left: 0;
}

.s-contact-form__heading {
  font-size: var(--t-font-size-h2);
  font-weight: 700;
  letter-spacing: -0.02em;
  margin: 0 0 var(--t-space-6);
  text-align: center;
}

.s-contact-form--left .s-contact-form__heading {
  text-align: left;
}

.s-contact-form__form {
  display: flex;
  flex-direction: column;
  gap: var(--t-space-4);
}

.s-contact-form__field {
  display: flex;
  flex-direction: column;
  gap: var(--t-space-2);
}

.s-contact-form__label {
  font-size: var(--t-font-size-small);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.s-contact-form__input,
.s-contact-form__textarea,
.s-contact-form__select {
  width: 100%;
  padding: var(--t-space-3) var(--t-space-4);
  background: var(--t-surface);
  border: 1px solid var(--t-border);
  color: var(--t-text);
  font-size: var(--t-font-size-base);
  font-family: inherit;
  border-radius: 0;
  transition: border-color var(--t-transition-fast);
}

.s-contact-form__input:focus,
.s-contact-form__textarea:focus,
.s-contact-form__select:focus {
  outline: none;
  border-color: var(--t-border-strong);
}

.s-contact-form__textarea {
  min-height: 140px;
  resize: vertical;
}

.s-contact-form__row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--t-space-4);
}

@media (max-width: 639px) {
  .s-contact-form__row {
    grid-template-columns: 1fr;
  }
}

.s-contact-form__success {
  padding: var(--t-space-4);
  background: var(--t-surface);
  border: 1px solid var(--t-border-strong);
  text-align: center;
  color: var(--t-text);
}
{% endstylesheet %}

{%- liquid
  assign _show_heading = section.settings.show_heading
  assign _heading = section.settings.heading
  assign _centered = section.settings.centered
  assign _max_width = section.settings.form_max_width

  assign _section_class = 's-contact-form'
  if _centered == false
    assign _section_class = _section_class | append: ' s-contact-form--left'
  endif
-%}

<section
  id="section-{{ section.id }}"
  class="{{ _section_class }}"
  data-section-id="{{ section.id }}"
  data-section-type="contact-form"
>
  <div class="c-container">
    <div class="s-contact-form__inner" style="max-width: {{ _max_width }}px;">
      {% if _show_heading and _heading != blank %}
        <h2 class="s-contact-form__heading">{{ _heading | escape }}</h2>
      {% endif %}

      {% if form.posted_successfully? %}
        <div class="s-contact-form__success">
          {{ 'contact.form.post_success' | t | default: 'Thanks for reaching out! We\'ll get back to you soon.' }}
        </div>
      {% else %}
        <form class="s-contact-form__form" method="post" action="/contact" accept-charset="UTF-8">
          <input type="hidden" name="form_type" value="contact">
          <input type="hidden" name="utf8" value="✓">

          <div class="s-contact-form__row">
            <div class="s-contact-form__field">
              <label for="contact-name-{{ section.id }}" class="s-contact-form__label">
                {{ 'contact.form.name' | t | default: 'Name' }}
              </label>
              <input
                type="text"
                id="contact-name-{{ section.id }}"
                name="contact[{{ 'contact.form.name' | t | default: 'name' }}]"
                class="s-contact-form__input"
                autocomplete="name"
                required
              >
            </div>
            <div class="s-contact-form__field">
              <label for="contact-email-{{ section.id }}" class="s-contact-form__label">
                {{ 'contact.form.email' | t | default: 'Email' }}
              </label>
              <input
                type="email"
                id="contact-email-{{ section.id }}"
                name="contact[email]"
                class="s-contact-form__input"
                autocomplete="email"
                required
              >
            </div>
          </div>

          <div class="s-contact-form__field">
            <label for="contact-phone-{{ section.id }}" class="s-contact-form__label">
              {{ 'contact.form.phone' | t | default: 'Phone' }}
            </label>
            <input
              type="tel"
              id="contact-phone-{{ section.id }}"
              name="contact[{{ 'contact.form.phone' | t | default: 'phone' }}]"
              class="s-contact-form__input"
              autocomplete="tel"
            >
          </div>

          <div class="s-contact-form__field">
            <label for="contact-message-{{ section.id }}" class="s-contact-form__label">
              {{ 'contact.form.message' | t | default: 'Message' }}
            </label>
            <textarea
              id="contact-message-{{ section.id }}"
              name="contact[body]"
              class="s-contact-form__textarea"
              required
            ></textarea>
          </div>

          <button type="submit" class="c-btn c-btn--primary" style="align-self: flex-start;">
            {{ 'contact.form.submit' | t | default: 'Send message' }}
          </button>
        </form>
      {% endif %}
    </div>
  </div>
</section>

{% javascript %}
class ContactFormSection extends HTMLElement {
  constructor() { super(); }
  connectedCallback() { this.init(); }
  init() {}
  onBlockSelect() {}
  onBlockDeselect() {}
}

if (!customElements.get('contact-form-section')) {
  customElements.define('contact-form-section', ContactFormSection);
}
{% endjavascript %}
