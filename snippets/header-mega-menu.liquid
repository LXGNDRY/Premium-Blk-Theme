{% comment %}
  Renders the desktop mega menu
  Accepts:
  - menu: {Object} Linklist object
{% endcomment %}

<header-mega-menu>
  <nav class="header__inline-menu mega-menu" aria-label="Main menu">
    <ul class="header__menu list-menu" role="list">
      {% for link in menu.links %}
        <li class="header__menu-item list-menu__item mega-menu__item">
          <a
            href="{{ link.url }}"
            class="header__menu-item link header__active-menu-item"
            {% if link.active %}aria-current="page"{% endif %}
          >
            <span>{{ link.title }}</span>
          </a>

          {% if link.links.size > 0 %}
            <div class="mega-menu__content" data-mega-menu-content>
              <ul class="mega-menu__list">
                {% for sublink in link.links %}
                  <li class="mega-menu__list-item">
                    <a
                      href="{{ sublink.url }}"
                      class="mega-menu__link link"
                    >
                      {{ sublink.title }}
                    </a>
                    {% if sublink.links.size > 0 %}
                      <ul class="mega-menu__sub-list">
                        {% for sub2link in sublink.links %}
                          <li>
                            <a href="{{ sub2link.url }}" class="mega-menu__sub-link link">
                              {{ sub2link.title }}
                            </a>
                          </li>
                        {% endfor %}
                      </ul>
                    {% endif %}
                  </li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </nav>
</header-mega-menu>
