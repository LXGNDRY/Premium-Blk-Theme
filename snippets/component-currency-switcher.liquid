{% comment %}
  component-currency-switcher.liquid
  Currency selector dropdown for Shopify Markets / multi-currency stores.
  Uses Shopify's built-in currency form pattern.
{% endcomment %}

{% stylesheet %}
.c-currency {
  position: relative;
}

.c-currency__button {
  background: none;
  border: none;
  color: var(--t-text);
  cursor: pointer;
  padding: 8px 12px;
  font-size: var(--t-font-size-small);
  font-family: inherit;
  display: flex;
  align-items: center;
  gap: 6px;
  white-space: nowrap;
}

.c-currency__button:hover {
  opacity: 0.7;
}

.c-currency__code {
  font-family: var(--t-font-mono);
  font-weight: 600;
}

.c-currency__dropdown {
  position: absolute;
  top: 100%;
  right: 0;
  min-width: 180px;
  background: var(--t-bg);
  border: 1px solid var(--t-border);
  list-style: none;
  margin: 4px 0 0;
  padding: 0;
  z-index: var(--t-z-dropdown);
  opacity: 0;
  visibility: hidden;
  transform: translateY(4px);
  transition: opacity var(--t-transition-fast),
    transform var(--t-transition-fast),
    visibility var(--t-transition-fast);
}

.c-currency.is-open .c-currency__dropdown {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.c-currency__item {
  margin: 0;
}

.c-currency__item button {
  width: 100%;
  background: none;
  border: none;
  padding: 12px 16px;
  text-align: left;
  cursor: pointer;
  color: var(--t-text);
  font-size: var(--t-font-size-small);
  font-family: inherit;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.c-currency__item button:hover {
  background: var(--t-surface);
}

.c-currency__item.is-active button {
  font-weight: 600;
}

.c-currency__item.is-active button::after {
  content: '✓';
  font-family: var(--t-font-mono);
  font-size: 12px;
}

.c-currency__label {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 2px;
}

.c-currency__name {
  font-size: var(--t-font-size-small);
  font-weight: 500;
}

.c-currency__iso {
  font-size: var(--t-font-size-meta);
  color: var(--t-text-muted);
  font-family: var(--t-font-mono);
}
{% endstylesheet %}

{%- liquid
  assign _current = currency | default: shop.currency
  assign _enabled = false
  if shop.enabled_currencies.size > 1
    assign _enabled = true
  endif
-%}

{% if _enabled %}
  <div class="c-currency" data-currency-switcher>
    <button
      type="button"
      class="c-currency__button"
      data-currency-toggle
      aria-haspopup="listbox"
      aria-expanded="false"
      aria-label="Select currency"
    >
      <span class="c-currency__code">{{ _current }}</span>
      <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true" fill="currentColor">
        <polygon points="0 2 5 7 10 2 10 3 5 8 0 3" />
      </svg>
    </button>

    <ul class="c-currency__dropdown" role="listbox" data-currency-list>
      {% for c in shop.enabled_currencies %}
        <li
          class="c-currency__item{% if c.iso_code == _current %} is-active{% endif %}"
          role="option"
          data-currency-code="{{ c.iso_code }}"
          data-currency-symbol="{{ c.symbol }}"
          aria-selected="{% if c.iso_code == _current %}true{% else %}false{% endif %}"
        >
          <button type="button" data-currency-select value="{{ c.iso_code }}">
            <span class="c-currency__label">
              <span class="c-currency__name">{{ c.name }}</span>
              <span class="c-currency__iso">{{ c.iso_code }} · {{ c.symbol }}</span>
            </span>
          </button>
        </li>
      {% endfor %}
    </ul>
  </div>
{% endif %}

{% javascript %}
class CurrencySwitcher extends HTMLElement {
  constructor() { super(); }

  connectedCallback() {
    this.toggleBtn = this.querySelector('[data-currency-toggle]');
    this.list = this.querySelector('[data-currency-list]');
    if (!this.toggleBtn || !this.list) return;

    this.toggleBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      this.toggle();
    });

    document.addEventListener('click', (e) => {
      if (!this.contains(e.target)) this.close();
    });

    this.querySelectorAll('[data-currency-select]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const code = btn.value || btn.closest('[data-currency-code]').dataset.currencyCode;
        this.setCurrency(code);
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && this.classList.contains('is-open')) {
        this.close();
      }
    });
  }

  toggle() {
    if (this.classList.contains('is-open')) {
      this.close();
    } else {
      this.open();
    }
  }

  open() {
    this.classList.add('is-open');
    this.toggleBtn.setAttribute('aria-expanded', 'true');
  }

  close() {
    this.classList.remove('is-open');
    this.toggleBtn.setAttribute('aria-expanded', 'false');
  }

  async setCurrency(code) {
    if (!code) return;

    try {
      // Standard Shopify multi-currency pattern:
      // POST to /cart/update.js with currency=CODE, then reload
      const formData = new FormData();
      formData.append('currency', code);

      const res = await fetch('/cart/update.js', {
        method: 'POST',
        headers: { 'Accept': 'application/json' },
        body: formData
      });

      if (res.ok) {
        // Reload to apply currency change to all prices
        window.location.reload();
      }
    } catch (err) {
      // Fallback: try Shopify's Markets currency selector
      const selector = document.querySelector('.shopify-currency-form select');
      if (selector) {
        selector.value = code;
        selector.dispatchEvent(new Event('change'));
      }
      console.warn('[Currency] Switch failed:', err);
    }

    this.close();
  }
}

if (!customElements.get('currency-switcher')) {
  customElements.define('currency-switcher', CurrencySwitcher);
}
{% endjavascript %}