{% comment %}
  component-image-zoom.liquid
  Image zoom + lightbox markup for product galleries.
  CSS/JS lives in the section that renders this (main-product).
  Features:
  - Hover zoom (magnifier lens)
  - Click to open fullscreen lightbox
  - Thumbnail navigation in lightbox
  - Keyboard support (arrow keys, ESC)
  - Touch swipe support for mobile

  Usage:
  {% render 'component-image-zoom', images: product.images, alt: product.title %}
{% endcomment %}

{%- liquid
  assign _images = images
  assign _alt = alt | default: 'Product image'
  assign _main_image = _images.first
  assign _image_count = _images.size
-%}

{% if _images and _image_count > 0 %}
  <div class="c-zoom" data-image-zoom data-main-image="{{ _main_image.src | img_url: 'master' }}" data-zoom="false">
    <img
      src="{{ _main_image.src | img_url: '800x800' }}"
      alt="{{ _main_image.alt | default: _alt }}"
      class="c-zoom__img"
      data-zoom-img
    >
    <div class="c-zoom__lens" data-zoom-lens aria-hidden="true"></div>
    <div class="c-zoom__result" data-zoom-result aria-hidden="true"></div>
    <div class="c-zoom__hint">{{ 'product.zoom.click_to_expand' | t | default: 'Click to expand' }}</div>
  </div>

  <div class="c-lightbox" data-lightbox role="dialog" aria-modal="true" aria-hidden="true" hidden>
    <div class="c-lightbox__container">
      <button type="button" class="c-lightbox__close" data-lightbox-close aria-label="Close">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="4" y1="4" x2="16" y2="16"/>
          <line x1="16" y1="4" x2="4" y2="16"/>
        </svg>
      </button>

      <button type="button" class="c-lightbox__nav c-lightbox__nav--prev" data-lightbox-prev aria-label="Previous image">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <button type="button" class="c-lightbox__nav c-lightbox__nav--next" data-lightbox-next aria-label="Next image">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>

      <img class="c-lightbox__image" src="" alt="" data-lightbox-img>

      <div class="c-lightbox__thumbs" data-lightbox-thumbs>
        {% for img in _images %}
          <button
            type="button"
            class="c-lightbox__thumb{% if forloop.first %} is-active{% endif %}"
            data-lightbox-thumb
            data-index="{{ forloop.index0 }}"
            aria-label="Image {{ forloop.index }}"
          >
            <img src="{{ img.src | img_url: '100x100_crop_center' }}" alt="{{ img.alt | default: 'Thumbnail' }}" loading="lazy">
          </button>
        {% endfor %}
      </div>

      <div class="c-lightbox__counter" data-lightbox-counter>1 / {{ _image_count }}</div>
    </div>
  </div>
{% endif %}
