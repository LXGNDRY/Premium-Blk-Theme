{% comment %}
  Renders a product card
  Accepts:
  - product: {Object} Product object
  - show_vendor: {Boolean} Show product vendor
  - show_secondary_image: {Boolean} Show second image on hover
  - show_badges: {Boolean} Show badges (sale, sold out, new)
  - card_style: {String} Card style (standard | card)
  - enable_quick_add: {Boolean} Show quick add button
  - show_rating: {Boolean} Show star rating
  - grid_columns: {Number} Number of grid columns
  - media_aspect_ratio: {String} Media aspect ratio
  - shape: {String} Product image shape (default | round)
{% endcomment %}

<div class="card-wrapper product-card-wrapper">
  <div class="card-wrapper">
    <div class="card card--{{ card_style | default: 'standard' }} product-card{% if show_secondary_image %} card--media-flip{% endif %}" style="--ratio-percent: {{ media_aspect_ratio | default: '100%' }}">
      <div class="card__inner">
        <div class="card__media">
          <div class="media media--transparent media--hover-effect">
            {% if product.featured_image %}
              <img
                src="{{ product.featured_image | image_url: width: 500 }}"
                alt="{{ product.featured_image.alt | escape }}"
                class="motion-reduce"
                loading="lazy"
                width="500"
                height="500"
              >
            {% else %}
              <div class="card__placeholder">
                {{ 'products.product.product_image' | t }}
              </div>
            {% endif %}

            {% if show_secondary_image and product.images.size > 1 %}
              <div class="media media--hover-effect">
                <img
                  src="{{ product.images[1] | image_url: width: 500 }}"
                  alt="{{ product.images[1].alt | escape }}"
                  class="motion-reduce"
                  loading="lazy"
                  width="500"
                  height="500"
                >
              </div>
            {% endif %}
          </div>

          {% if show_badges %}
            <div class="card__badge">
              {% if product.tags contains 'new' %}
                <span class="badge badge--bottom-left color-accent-1">
                  {{ 'products.product.new' | t }}
                </span>
              {% endif %}
              {% if product.compare_at_price > product.price and product.available %}
                <span class="badge badge--bottom-left color-inverse">
                  {{ 'products.product.on_sale' | t }}
                </span>
              {% endif %}
              {% unless product.available %}
                <span class="badge badge--bottom-left color-foreground">
                  {{ 'products.product.sold_out' | t }}
                </span>
              {% endunless %}
            </div>
          {% endif %}

          <a href="{{ product.url }}" class="full-unstyled-link">
            {{ product.title | escape }}
          </a>
        </div>

        <div class="card__content">
          <div class="card__information">
            <h3 class="card__heading h5">
              <a href="{{ product.url }}" class="full-unstyled-link">
                {{ product.title | escape }}
              </a>
            </h3>

            {% if show_vendor and product.vendor %}
              <p class="card__vendor caption-with-letter-spacing">
                {{ product.vendor | escape }}
              </p>
            {% endif %}

            {% if show_rating %}
              <div class="rating-star">
                <span class="rating-star__rating">
                  {% for i in (1..5) %}
                    {% if i <= product.metafields.reviews.rating.value %}
                      {% render 'icon-star' %}
                    {% else %}
                      {% render 'icon-star-empty' %}
                    {% endif %}
                  {% endfor %}
                </span>
              </div>
            {% endif %}
          </div>

          <div class="card__footer">
            <div class="card__price">
              {% render 'price', product: product, show_badges: false %}
            </div>

            {% if enable_quick_add and product.available %}
              <div class="card__quick-add">
                <button type="button" class="quick-add__submit button button--primary button--full-width" data-product-id="{{ product.id }}">
                  {{ 'products.product.choose_options' | t }}
                </button>
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>