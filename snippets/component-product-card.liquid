{% comment %}
  Component: Product card
  Renders a product card with image, title, price, badges, and optional quick add.

  Accepts:
  - product: {Object} Required — product object
  - media_aspect: {String} Default: 3/4 — 1/1, 3/4, 4/5, 4/3
  - show_vendor: {Boolean} Default: false
  - show_secondary_image: {Boolean} Default: true
  - show_badges: {Boolean} Default: true
  - show_quick_add: {Boolean} Default: false
  - show_swatches: {Boolean} Default: false
  - image_size: {Number} Default: 500 — width in px
  - class: {String} — additional CSS classes

  Usage:
  {% render 'component-product-card', product: product, show_vendor: true %}
{% endcomment %}

{%- liquid
  if product == blank or product == nil
    return
  endif

  assign _media_aspect = media_aspect | default: '3/4'
  assign _show_vendor = show_vendor
  if _show_vendor == nil
    assign _show_vendor = false
  endif
  assign _show_secondary = show_secondary_image
  if _show_secondary == nil
    assign _show_secondary = true
  endif
  assign _show_badges = show_badges
  if _show_badges == nil
    assign _show_badges = true
  endif
  assign _show_quick_add = show_quick_add
  if _show_quick_add == nil
    assign _show_quick_add = false
  endif

  assign _show_quick_view = show_quick_view
  if _show_quick_view == nil
    assign _show_quick_view = true
  endif
  assign _show_swatches = show_swatches
  if _show_swatches == nil
    assign _show_swatches = false
  endif
  assign _image_size = image_size | default: 500
  assign _class = class | default: ''

  assign _classes = 'c-product-card'
  if _class != ''
    assign _classes = _classes | append: ' ' | append: _class
  endif

  assign _on_sale = false
  if product.compare_at_price > product.price and product.available
    assign _on_sale = true
  endif

  assign _is_new = false
  if product.tags contains 'new'
    assign _is_new = true
  endif

  assign _aspect_style = ''
  case _media_aspect
    when '1/1'
      assign _aspect_style = 'aspect-ratio: 1 / 1;'
    when '3/4'
      assign _aspect_style = 'aspect-ratio: 3 / 4;'
    when '4/5'
      assign _aspect_style = 'aspect-ratio: 4 / 5;'
    when '4/3'
      assign _aspect_style = 'aspect-ratio: 4 / 3;'
  endcase

  assign _featured_image = product.featured_image
  if _featured_image == nil and product.images.size > 0
    assign _featured_image = product.images.first
  endif

  assign _secondary_image = nil
  if _show_secondary and product.images.size > 1
    assign _secondary_image = product.images[1]
  endif
-%}

<article class="{{ _classes }}" data-product-id="{{ product.id }}">
  <a href="{{ product.url }}" class="c-product-card__media" style="{{ _aspect_style }}" aria-label="{{ product.title | escape }}">
    {% if _featured_image %}
      <img
        src="{{ _featured_image | image_url: width: _image_size }}"
        srcset="
          {{ _featured_image | image_url: width: _image_size | times: 0.5 | round }} {{ _image_size | times: 0.5 | round }}w,
          {{ _featured_image | image_url: width: _image_size }} {{ _image_size }}w,
          {{ _featured_image | image_url: width: _image_size | times: 2 | round }} {{ _image_size | times: 2 | round }}w
        "
        sizes="(max-width: 767px) 50vw, 25vw"
        alt="{{ _featured_image.alt | escape }}"
        width="{{ _image_size }}"
        height="{{ _image_size | times: 1.33 | round }}"
        loading="lazy"
        decoding="async"
        class="c-product-card__img c-product-card__img--primary"
      >
      {% if _secondary_image %}
        <img
          src="{{ _secondary_image | image_url: width: _image_size }}"
          alt="{{ _secondary_image.alt | escape }}"
          width="{{ _image_size }}"
          height="{{ _image_size | times: 1.33 | round }}"
          loading="lazy"
          decoding="async"
          class="c-product-card__img c-product-card__img--secondary"
        >
      {% endif %}
    {% else %}
      <div class="c-product-card__placeholder">
        <span>{{ 'products.product.product_image' | t | default: 'No image' }}</span>
      </div>
    {% endif %}

    {% if _show_badges %}
      <div class="c-product-card__badges">
        {% if _on_sale %}
          {%- liquid
            assign _compare = product.compare_at_price | divided_by: 100.0
            assign _current = product.price | divided_by: 100.0
            assign _savings = _compare | minus: _current
            assign _percent = _savings | divided_by: _compare | times: 100 | round
          -%}
          <span class="c-badge c-badge--sale">-{{ _percent }}%</span>
        {% endif %}
        {% unless product.available %}
          <span class="c-badge c-badge--sold-out">{{ 'products.product.sold_out' | t | default: 'Sold out' }}</span>
        {% endunless %}
        {% if _is_new %}
          <span class="c-badge c-badge--new">{{ 'products.product.new' | t | default: 'New' }}</span>
        {% endif %}
      </div>
    {% endif %}

    {% render 'component-wishlist-button', product: product %}

    {% if _show_quick_add and product.available and product.variants.size == 1 %}
      <div class="c-product-card__quick-add">
        <button
          type="button"
          class="c-btn c-btn--primary c-btn--full"
          data-quick-add
          data-product-id="{{ product.id }}"
          data-variant-id="{{ product.variants.first.id }}"
        >
          {{ 'products.product.add_to_cart' | t | default: 'Add to cart' }}
        </button>
      </div>
    {% endif %}
  </a>

  <div class="c-product-card__info">
    {% if _show_vendor and product.vendor %}
      <p class="c-product-card__vendor">
        {{ product.vendor | escape }}
      </p>
    {% endif %}

    <h3 class="c-product-card__title">
      <a href="{{ product.url }}">{{ product.title | escape }}</a>
    </h3>

    {% render 'component-product-price', product: product, show_badge: false %}

    {% if _show_swatches and product.options.size > 0 %}
      {% assign _first_option = product.options.first %}
      {% if _first_option.name contains 'Color' or _first_option.name contains 'Colour' %}
        <div class="c-product-card__swatches">
          {% for value in _first_option.values limit: 5 %}
            <span class="c-swatch c-swatch--color" title="{{ value | escape }}"></span>
          {% endfor %}
        </div>
      {% endif %}
    {% endif %}

    {% if _show_quick_view and product.available %}
      <div class="c-product-card__quick-view">
        <button
          type="button"
          class="c-product-card__quick-view-btn"
          data-quick-view-trigger
          data-product-handle="{{ product.handle }}"
        >
          {{ 'products.product.quick_view' | t | default: 'Quick view' }}
        </button>
      </div>
    {% endif %}
  </div>
</article>
