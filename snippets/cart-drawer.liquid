{% comment %}
  Renders the cart drawer
  Accepts:
  - cart: {Object} Cart object
{% endcomment %}

<cart-drawer id="cart-drawer" data-cart-drawer>
  <div class="drawer" role="dialog" aria-modal="true" aria-label="{{ 'cart.drawer.title' | t }}" data-drawer>
    <div class="drawer__inner">
      <div class="drawer__header">
        <h2 class="drawer__title">
          {{ 'cart.drawer.title' | t }}
          <span class="visually-hidden">{{ 'cart.drawer.count' | t: count: cart.item_count }}</span>
        </h2>
        <button
          type="button"
          class="drawer__close-button button"
          aria-label="{{ 'general.close' | t }}"
          data-drawer-close
        >
          {% render 'icon-close' %}
        </button>
      </div>

      <div class="drawer__body">
        {% if cart.item_count > 0 %}
          <div class="cart-items" data-cart-items>
            {% for item in cart.items %}
              <div class="cart-item cart-item--ajax" data-cart-item data-key="{{ item.key }}">
                <div class="cart-item__details">
                  <a href="{{ item.url }}" class="cart-item__image">
                    <img
                      src="{{ item.image | image_url: width: 150 }}"
                      alt="{{ item.title | escape }}"
                      width="150"
                      height="150"
                      loading="lazy"
                    >
                  </a>
                  <div class="cart-item__info">
                    <h3 class="cart-item__title">
                      <a href="{{ item.url }}">{{ item.product.title }}</a>
                    </h3>
                    {% if item.variant.title != 'Default Title' %}
                      <p class="cart-item__variant">{{ item.variant.title }}</p>
                    {% endif %}
                    <div class="cart-item__price">{{ item.final_line_price | money }}</div>
                    {% render 'quantity-input',
                      input_id: 'updates_' | append: item.key,
                      name: 'updates[' | append: item.key | append: ']',
                      value: item.quantity,
                      min: 0
                    %}
                    <button
                      type="button"
                      class="cart-item__remove"
                      data-cart-remove
                      data-key="{{ item.key }}"
                    >
                      {{ 'cart.general.remove' | t }}
                    </button>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        {% else %}
          <div class="cart-drawer__empty">
            <h2 class="cart-drawer__empty-title">{{ 'cart.general.empty' | t }}</h2>
            <p class="cart-drawer__empty-message">{{ 'cart.general.continue_browsing' | t }}</p>
            <a href="{{ routes.all_products_collection_url }}" class="button">
              {{ 'cart.general.continue_shopping' | t }}
            </a>
          </div>
        {% endif %}
      </div>

      {% if cart.item_count > 0 %}
        <div class="drawer__footer">
          <div class="totals">
            <div class="totals__subtotal">
              <p>{{ 'cart.general.subtotal' | t }}</p>
              <p class="totals__subtotal-value">{{ cart.total_price | money }}</p>
            </div>
            <p class="tax-note">{{ 'cart.general.taxes_and_shipping_at_checkout' | t }}</p>
          </div>

          <form action="{{ routes.cart_url }}" method="post" class="cart-drawer__checkout-form">
            <button
              type="submit"
              class="cart-drawer__checkout-button button button--primary button--full-width"
              name="checkout"
            >
              {{ 'cart.general.checkout' | t }}
            </button>
          </form>

          <div class="cart-drawer__dynamic-checkout">
            {{ cart | payment_button }}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
  <div class="drawer-overlay" data-drawer-overlay></div>
</cart-drawer>
