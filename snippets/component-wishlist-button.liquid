{% comment %}
  Component: Wishlist button
  Adds a product to the localStorage wishlist.

  Accepts:
  - product: {Object} Required — product object
  - size: {String} Default: "" — "" or "lg"
  - class: {String} — additional classes

  Usage:
  {% render 'component-wishlist-button', product: product %}
{% endcomment %}

{%- liquid
  if product == nil
    return
  endif
  assign _size_class = ''
  if size == 'lg'
    assign _size_class = ' c-wishlist-btn--lg'
  endif
  if class != blank
    assign _size_class = _size_class | append: ' ' | append: class
  endif
-%}

<button
  type="button"
  class="c-wishlist-btn{{ _size_class }}"
  data-wishlist-btn
  data-product-id="{{ product.id }}"
  data-product-title="{{ product.title | escape }}"
  aria-label="Add {{ product.title | escape }} to wishlist"
  aria-pressed="false"
>
  <svg class="c-wishlist-btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
  </svg>
  <span class="c-wishlist-btn__label" aria-hidden="true">
    {{ 'general.wishlist.add' | t | default: 'Save' }}
  </span>
</button>