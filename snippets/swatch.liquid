{% comment %}
  Renders a single swatch
  Accepts:
  - value: {String} Swatch value
  - option: {String} Option name (e.g. Color, Size)
  - selected: {Boolean} Whether swatch is selected
  - disabled: {Boolean} Whether swatch is disabled
{% endcomment %}

{% if option contains 'Color' or option contains 'Colour' or option contains 'color' %}
  <div
    class="swatch swatch--color{% if selected %} swatch--selected{% endif %}{% if disabled %} swatch--disabled{% endif %}"
    style="--swatch-color: {{ value | escape }}"
    title="{{ value }}"
  >
    <span class="swatch__color" style="background-color: {{ value }};"></span>
  </div>
{% else %}
  <div
    class="swatch{% if selected %} swatch--selected{% endif %}{% if disabled %} swatch--disabled{% endif %}"
  >
    <span class="swatch__label">{{ value }}</span>
  </div>
{% endif %}
