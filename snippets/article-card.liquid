{% comment %}
  Renders an article card
  Accepts:
  - article: {Object} Article object
  - show_image: {Boolean} Show featured image
  - show_date: {Boolean} Show publication date
  - show_author: {Boolean} Show author name
{% endcomment %}

<article class="article-card">
  {% if show_image and article.image %}
    <a href="{{ article.url }}" class="article-card__image">
      <img
        src="{{ article.image | image_url: width: 600 }}"
        alt="{{ article.image.alt | escape }}"
        loading="lazy"
        width="600"
        height="400"
      >
    </a>
  {% endif %}

  <div class="article-card__info">
    {% if show_date or show_author %}
      <div class="article-card__meta caption-with-letter-spacing">
        {% if show_date %}
          <time class="article-card__date" datetime="{{ article.published_at }}">
            {{ article.published_at | date: '%b %d, %Y' }}
          </time>
        {% endif %}
        {% if show_author and article.author %}
          <span class="article-card__author">{{ article.author }}</span>
        {% endif %}
      </div>
    {% endif %}

    <h3 class="article-card__title h5">
      <a href="{{ article.url }}" class="article-card__link">
        {{ article.title | escape }}
      </a>
    </h3>

    {% if article.excerpt %}
      <div class="article-card__excerpt rte">
        {{ article.excerpt | truncate: 120 }}
      </div>
    {% endif %}
  </div>
</article>
