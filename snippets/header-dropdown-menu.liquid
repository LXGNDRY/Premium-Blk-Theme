{% comment %}
  Renders the desktop dropdown menu
  Accepts:
  - menu: {Object} Linklist object
{% endcomment %}

<nav class="header__inline-menu" aria-label="Main menu">
  <ul class="header__menu list-menu" role="list">
    {% for link in menu.links %}
      <li class="header__menu-item list-menu__item">
        <a
          href="{{ link.url }}"
          class="header__menu-item link header__active-menu-item"
          {% if link.active %}aria-current="page"{% endif %}
        >
          <span>{{ link.title }}</span>
        </a>

        {% if link.links.size > 0 %}
          <ul class="header__submenu list-menu">
            {% for sublink in link.links %}
              <li class="header__submenu-item list-menu__item">
                <a href="{{ sublink.url }}" class="header__menu-item link">
                  {{ sublink.title }}
                </a>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
</nav>
