{% comment %}
  Renders product variant picker (options, swatches)
  Accepts:
  - product: {Object} Product object
  - options_style: {String} Option style (dropdown | swatch | button)
{% endcomment %}

<div class="product-form__input product-form__input--variants" data-variant-picker>
  {% for option in product.options_with_values %}
    <div class="product-form__option product-form__option--{{ option.name | handleize }}">
      <fieldset class="js product-form__input product-form__input--pill">
        <legend class="form__label">
          {{ option.name }}
        </legend>
        <div class="product-form__options">
          {% for value in option.values %}
            <input
              type="radio"
              id="Option-{{ section.id }}-{{ forloop.parentloop.index0 }}-{{ forloop.index0 }}"
              name="options[{{ option.position }}]"
              value="{{ value | escape }}"
              form="{{ product_form_id }}"
              {% if forloop.index == 1 %}checked{% endif %}
              class="variant-picker__input"
              data-option-position="{{ option.position }}"
            >
            <label
              for="Option-{{ section.id }}-{{ forloop.parentloop.index0 }}-{{ forloop.index0 }}"
              class="variant-picker__label"
              data-value="{{ value | escape }}"
            >
              {{ value }}
            </label>
          {% endfor %}
        </div>
      </fieldset>
    </div>
  {% endfor %}
</div>
