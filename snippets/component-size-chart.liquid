{% comment %}
  component-size-chart.liquid
  Renders a size chart table — either from metafield data or a static table.
  Accepts:
    - product: product object (optional — reads size_chart metafield)
    - layout: 'inline' | 'modal' (default: inline)
{% endcomment %}

{%- liquid
  assign _layout = layout | default: 'inline'
  assign _chart_data = ''
  if product and product.metafields.product.size_chart
    assign _chart_data = product.metafields.product.size_chart
  endif
-%}

{% stylesheet %}
.c-size-chart {
  width: 100%;
  overflow-x: auto;
}

.c-size-chart table {
  width: 100%;
  border-collapse: collapse;
  font-size: var(--t-font-size-small);
}

.c-size-chart th,
.c-size-chart td {
  padding: 12px 16px;
  text-align: left;
  border: 1px solid var(--t-border);
}

.c-size-chart th {
  font-weight: 700;
  background: var(--t-surface);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  font-size: var(--t-font-size-meta);
}

.c-size-chart tr:nth-child(even) td {
  background: var(--t-surface);
}

.c-size-chart-modal {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.8);
  z-index: var(--t-z-modal);
  align-items: center;
  justify-content: center;
  padding: var(--t-space-5);
}

.c-size-chart-modal.is-open {
  display: flex;
}

.c-size-chart-modal__content {
  background: var(--t-bg);
  border: 1px solid var(--t-border);
  max-width: 900px;
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
  position: relative;
}

.c-size-chart-modal__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--t-space-5);
  border-bottom: 1px solid var(--t-border);
  position: sticky;
  top: 0;
  background: var(--t-bg);
  z-index: 1;
}

.c-size-chart-modal__title {
  font-size: var(--t-font-size-h3);
  font-weight: 700;
  margin: 0;
}

.c-size-chart-modal__close {
  background: none;
  border: none;
  color: var(--t-text);
  cursor: pointer;
  padding: 8px;
  line-height: 0;
}

.c-size-chart-modal__body {
  padding: var(--t-space-5);
}

.c-size-chart-trigger {
  background: none;
  border: none;
  color: var(--t-text);
  text-decoration: underline;
  cursor: pointer;
  font-size: var(--t-font-size-small);
  padding: 0;
}
{% endstylesheet %}

{% if _layout == 'modal' %}
  <button
    type="button"
    class="c-size-chart-trigger"
    data-size-chart-trigger
    aria-haspopup="dialog"
  >
    {{ 'product.size_chart.view' | t | default: 'View size chart' }}
  </button>

  <div
    class="c-size-chart-modal"
    data-size-chart-modal
    role="dialog"
    aria-modal="true"
    aria-labelledby="size-chart-title"
    hidden
  >
    <div class="c-size-chart-modal__content">
      <div class="c-size-chart-modal__header">
        <h3 class="c-size-chart-modal__title" id="size-chart-title">
          {{ 'product.size_chart.title' | t | default: 'Size chart' }}
        </h3>
        <button
          type="button"
          class="c-size-chart-modal__close"
          data-size-chart-close
          aria-label="Close size chart"
        >
          {% render 'icon-close' %}
        </button>
      </div>
      <div class="c-size-chart-modal__body">
        <div class="c-size-chart" data-size-chart-content>
          {% render 'size-chart-table', product: product %}
        </div>
      </div>
    </div>
  </div>
{% else %}
  <div class="c-size-chart">
    {% render 'size-chart-table', product: product %}
  </div>
{% endif %}

{% javascript %}
class SizeChart extends HTMLElement {
  constructor() { super(); }
  connectedCallback() { this.init(); }
  init() {
    this.trigger = this.querySelector('[data-size-chart-trigger]');
    this.modal = this.querySelector('[data-size-chart-modal]');
    this.closeBtn = this.querySelector('[data-size-chart-close]');

    if (!this.modal || !this.trigger) return;

    this.trigger.addEventListener('click', () => this.open());
    this.closeBtn?.addEventListener('click', () => this.close());
    this.modal.addEventListener('click', (e) => {
      if (e.target === this.modal) this.close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && this.modal.classList.contains('is-open')) {
        this.close();
      }
    });
  }

  open() {
    this.modal.classList.add('is-open');
    this.modal.hidden = false;
    document.body.style.overflow = 'hidden';
    this.closeBtn?.focus();
  }

  close() {
    this.modal.classList.remove('is-open');
    this.modal.hidden = true;
    document.body.style.overflow = '';
    this.trigger?.focus();
  }
}

if (!customElements.get('size-chart')) {
  customElements.define('size-chart', SizeChart);
}
{% endjavascript %}