{% comment %}
  Renders a collection card
  Accepts:
  - collection: {Object} Collection object
  - card_style: {String} Card style (standard | card)
  - image_ratio: {String} Image ratio (adapt | portrait | square)
{% endcomment %}

<div class="card-wrapper collection-card-wrapper">
  <div class="card card--{{ card_style | default: 'standard' }} card--collection">
    <div class="card__inner">
      <div class="card__media card__media--{{ image_ratio | default: 'square' }}">
        <div class="media media--transparent">
          {% if collection.image %}
            <img
              src="{{ collection.image | image_url: width: 600 }}"
              alt="{{ collection.image.alt | escape }}"
              loading="lazy"
              width="600"
              height="600"
              class="motion-reduce"
            >
          {% else %}
            <div class="card__placeholder">
              {{ 'collections.general.collection_image' | t }}
            </div>
          {% endif %}
        </div>
        <a href="{{ collection.url }}" class="full-unstyled-link">
          {{ collection.title | escape }}
        </a>
      </div>
      <div class="card__content">
        <div class="card__information">
          <h3 class="card__heading h5">
            <a href="{{ collection.url }}" class="full-unstyled-link">
              {{ collection.title | escape }}
            </a>
          </h3>
          {% if collection.description %}
            <p class="card__text body">
              {{ collection.description | strip_html | truncate: 60 }}
            </p>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>