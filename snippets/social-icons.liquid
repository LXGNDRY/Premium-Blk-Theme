{% comment %}
  Renders social media icons
  Accepts:
  - social_links: {Object} Social links from section settings
  - size: {String} Icon size (small | medium | large)
  - color: {String} Icon color
{% endcomment %}

<ul class="list-social list-social--{{ size | default: 'small' }}">
  {% if social_links.share_on_facebook or settings.social_facebook_link %}
    <li class="list-social__item">
      <a class="list-social__link" href="{{ settings.social_facebook_link }}" aria-label="Facebook">
        {% render 'icon-facebook' %}
      </a>
    </li>
  {% endif %}
  {% if settings.social_instagram_link %}
    <li class="list-social__item">
      <a class="list-social__link" href="{{ settings.social_instagram_link }}" aria-label="Instagram">
        {% render 'icon-instagram' %}
      </a>
    </li>
  {% endif %}
  {% if settings.social_tiktok_link %}
    <li class="list-social__item">
      <a class="list-social__link" href="{{ settings.social_tiktok_link }}" aria-label="TikTok">
        {% render 'icon-tiktok' %}
      </a>
    </li>
  {% endif %}
  {% if settings.social_twitter_link %}
    <li class="list-social__item">
      <a class="list-social__link" href="{{ settings.social_twitter_link }}" aria-label="Twitter">
        {% render 'icon-twitter' %}
      </a>
    </li>
  {% endif %}
  {% if settings.social_youtube_link %}
    <li class="list-social__item">
      <a class="list-social__link" href="{{ settings.social_youtube_link }}" aria-label="YouTube">
        {% render 'icon-youtube' %}
      </a>
    </li>
  {% endif %}
  {% if settings.social_pinterest_link %}
    <li class="list-social__item">
      <a class="list-social__link" href="{{ settings.social_pinterest_link }}" aria-label="Pinterest">
        {% render 'icon-pinterest' %}
      </a>
    </li>
  {% endif %}
</ul>
