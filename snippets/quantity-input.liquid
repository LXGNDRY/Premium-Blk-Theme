{% comment %}
  Renders a quantity input with plus/minus buttons
  Accepts:
  - input_id: {String} Input element ID
  - name: {String} Input name
  - value: {Number} Current value (default 1)
  - min: {Number} Minimum value (default 0)
  - max: {Number} Maximum value (default null)
  - size: {String} Size (small | medium | large)
{% endcomment %}

<quantity-input class="quantity" data-quantity-input>
  <button
    type="button"
    class="quantity__button quantity__button--minus"
    name="minus"
    data-action="decrease"
    aria-label="{{ 'products.product.quantity.minus' | t }}"
  >
    {% render 'icon-minus' %}
  </button>
  <input
    type="number"
    id="{{ input_id }}"
    name="{{ name }}"
    value="{{ value | default: 1 }}"
    min="{{ min | default: 1 }}"
    {% if max %}max="{{ max }}"{% endif %}
    class="quantity__input"
    data-quantity-input
  >
  <button
    type="button"
    class="quantity__button quantity__button--plus"
    name="plus"
    data-action="increase"
    aria-label="{{ 'products.product.quantity.plus' | t }}"
  >
    {% render 'icon-plus' %}
  </button>
</quantity-input>
