{% comment %}
  Component: Responsive image
  Renders a responsive image with proper srcset, sizes, lazy loading,
  aspect ratio box, and optional placeholder/blur-up.

  Accepts:
  - image: {Object} Required — Shopify image object or image_url
  - alt: {String} — alt text (uses image.alt if not provided)
  - width: {Number} Default: 800 — base width in px
  - height: {Number} — base height (calculated from aspect ratio if not provided)
  - aspect_ratio: {String} Default: 3/4 — e.g. "1/1", "3/4", "4/3"
  - loading: {String} Default: "lazy" — "lazy" or "eager"
  - fetchpriority: {String} — "high" for LCP images
  - sizes: {String} Default: "(max-width: 767px) 50vw, 25vw"
  - class: {String} — additional CSS classes
  - style: {String} — inline styles
  - object_fit: {String} Default: "cover" — "cover" / "contain"

  Usage:
  {% render 'component-image',
    image: product.featured_image,
    width: 800,
    aspect_ratio: '3/4',
    loading: 'eager',
    fetchpriority: 'high'
  %}
{% endcomment %}

{%- liquid
  if image == nil or image == blank
    assign _placeholder = true
  else
    assign _placeholder = false
  endif

  assign _alt = alt
  if _alt == blank and image.alt
    assign _alt = image.alt
  endif
  if _alt == blank
    assign _alt = ''
  endif

  assign _width = width | default: 800 | times: 1
  assign _aspect_ratio = aspect_ratio | default: '3/4'

  assign _parts = _aspect_ratio | split: '/'
  assign _ratio_w = _parts[0] | times: 1
  assign _ratio_h = _parts[1] | times: 1
  if height and height != blank
    assign _height = height | times: 1
  else
    assign _height = _width | times: _ratio_h | divided_by: _ratio_w
  endif

  assign _loading = loading | default: 'lazy'
  assign _sizes = sizes
  if _sizes == blank
    assign _sizes = '(max-width: 767px) 50vw, 25vw'
  endif
  assign _object_fit = object_fit | default: 'cover'
  assign _extra_class = class | default: ''
  assign _extra_style = style | default: ''

  assign _img_class = 'c-img'
  if _extra_class != ''
    assign _img_class = _img_class | append: ' ' | append: _extra_class
  endif

  assign _box_style = ''
  assign _box_style = _box_style | append: 'aspect-ratio: ' | append: _aspect_ratio | append: ';'
  if _extra_style != ''
    assign _box_style = _box_style | append: ' ' | append: _extra_style
  endif

  if _placeholder == false
    assign _src = image | image_url: width: _width
    assign _srcset_2x = image | image_url: width: _width | times: 2 | round
    assign _srcset_1x = image | image_url: width: _width
    assign _srcset_05x = image | image_url: width: _width | times: 0.5 | round
  endif
-%}

<div class="c-img-wrap" style="{{ _box_style }}">
  {% if _placeholder == false %}
    <img
      src="{{ _src }}"
      srcset="
        {{ _srcset_05x }} {{ _width | times: 0.5 | round }}w,
        {{ _srcset_1x }} {{ _width }}w,
        {{ _srcset_2x }} {{ _width | times: 2 | round }}w
      "
      sizes="{{ _sizes }}"
      alt="{{ _alt | escape }}"
      width="{{ _width }}"
      height="{{ _height }}"
      loading="{{ _loading }}"
      {% if fetchpriority and fetchpriority != blank %}fetchpriority="{{ fetchpriority }}"{% endif %}
      decoding="async"
      class="{{ _img_class }}"
      style="object-fit: {{ _object_fit }};"
      data-image-component
    >
  {% else %}
    <div class="c-img c-img--placeholder">
      <span>{{ 'general.no_image' | t | default: 'No image' }}</span>
    </div>
  {% endif %}
</div>
